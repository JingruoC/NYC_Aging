<span class="status-badge @CssClass">@Label</span>

@code {
    [Parameter]
    public string Status { get; set; } = "brand";

    [Parameter]
    public string Label { get; set; } = string.Empty;

    private string CssClass => Status.ToLowerInvariant() switch
    {
        "pass" => "good",
        "warning" => "warn",
        "fail" => "bad",
        "good" => "good",
        "warn" => "warn",
        "bad" => "bad",
        _ => "brand"
    };
}
