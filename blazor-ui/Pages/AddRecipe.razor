    private void Require(string? value, string message)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _errors.Add(message);
        }
    }

    private void RequireDecimal(decimal? value, string message)
    {
        if (!value.HasValue)
        {
            _errors.Add(message);
        }
    }

    private void RequireFiles(IReadOnlyCollection<string> fileNames, string message)
    {
        if (fileNames.Count == 0)
        {
            _errors.Add(message);
        }
    }

    private RecipeCreateRequest BuildRecipeRequest()
    {
        var notes = BuildSubmissionNotes();
        var calories = IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisCalories) : IsSubmissionType(ProductLabelType) ? Number(_form.ProductCalories) : 0;
        var sodium = IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisSodium) : IsSubmissionType(ProductLabelType) ? Number(_form.Sodium) : 0;
        var protein = IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisProtein) : IsSubmissionType(ProductLabelType) ? Number(_form.Protein) : 0;
        var fiber = IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisDietaryFiber) : IsSubmissionType(ProductLabelType) ? Number(_form.DietaryFiber) : 0;
        var fat = IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisTotalFat) : IsSubmissionType(ProductLabelType) ? Number(_form.TotalFat) : 0;
        var calcium = IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisCalcium) : IsSubmissionType(ProductLabelType) ? Number(_form.Calcium) : 0;
        return new RecipeCreateRequest
        {
            RecipeName = CurrentRecipeNamePreview == "Not entered" ? "Untitled recipe submission" : CurrentRecipeNamePreview,
            MealType = _form.MealType,
            Category = _form.Category,
            Calories = calories,
            SodiumMg = sodium,
            ProteinG = protein,
            FiberG = fiber,
            FatG = fat,
            Tags = BuildTags(),
            IsApproved = false,
            Ingredients = BuildIngredientLines(),
            Instructions = BuildInstructionLines(),
            ServingSize = GetServingSize(),
            YieldServings = GetYieldServings(),
            ScaleNote = string.Join(Environment.NewLine, notes),
            ContributedBy = _form.ProgramOrCatererName,
            CreatedOn = DateTime.Today,
            IsPublic = _form.IsPublic,
            IsFavorite = false,
            IsDead = false,
            NutrientClaims = BuildNutrientClaims(),
            VitaminCMg = 0,
            CalciumMg = calcium
        };
    }

    private List<string> BuildTags()
    {
        var tags = SplitTokens(_form.TagsText);
        tags.Add("pending review");
        tags.Add(CurrentSubmissionLabel);
        tags.Add(_form.Category);
        return tags.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<string> BuildNutrientClaims()
    {
        var claims = new List<string>();
        var sodium = ActiveSodium;
        var protein = ActiveProtein;
        var fiber = ActiveFiber;
        var calcium = ActiveCalcium;

        if (sodium > 0 && sodium <= 140)
        {
            claims.Add("low sodium");
        }
        if (protein >= 15)
        {
            claims.Add("high protein");
        }
        if (fiber >= 5)
        {
            claims.Add("high fiber");
        }
        if (calcium >= 200)
        {
            claims.Add("good source of calcium");
        }
        return claims;
    }

    private List<string> BuildIngredientLines()
    {
        if (IsSubmissionType(FullRecipeType))
        {
            return SplitLines(_form.IngredientList);
        }

        if (IsSubmissionType(NutritionAnalysisType))
        {
            return
            [
                $"Nutrition Facts panel files: {FileListText(_analysisFileNames)}",
                $"Vegetables per serving: {_form.VegetablesPerServing}",
                $"Plant-based protein per serving: {_form.PlantProteinPerServing}",
                $"Fruit per serving: {_form.FruitPerServing}"
            ];
        }

        return
        [
            $"Manufacturer: {_form.Manufacturer}",
            $"Servings per container: {OptionalText(_form.ServingsPerContainer)}",
            $"Serving size: {_form.ProductServingSize}",
            $"Nutrition Facts panel files: {FileListText(_productFileNames)}"
        ];
    }

    private List<string> BuildInstructionLines()
    {
        if (IsSubmissionType(FullRecipeType))
        {
            return SplitLines(_form.Directions);
        }

        if (IsSubmissionType(NutritionAnalysisType))
        {
            return ["Review the submitted recipe nutrition analysis panel."];
        }

        return ["Review the pre-prepared product label and ingredient list."];
    }

    private List<string> BuildSubmissionNotes()
    {
        var notes = new List<string>
        {
            $"Submission type: {CurrentSubmissionLabel}",
            $"Program or Caterer Name: {_form.ProgramOrCatererName}",
            $"Contact Person: {_form.ContactPerson}",
            $"Preferred E-mail Address: {_form.EmailAddress}",
            $"Can be made public: {(_form.IsPublic ? "Yes" : "No")}"
        };

        if (IsSubmissionType(FullRecipeType))
        {
            notes.Add($"Recipe source: {_form.RecipeSource}");
            if (!string.IsNullOrWhiteSpace(_form.RecipeUrl))
            {
                notes.Add($"Recipe URL: {_form.RecipeUrl}");
            }
            notes.Add($"Recipe file names: {FileListText(_recipeFileNames)}");
            AddOptionalNote(notes, "Comments", _form.Comments);
        }

        if (IsSubmissionType(NutritionAnalysisType))
        {
            notes.Add($"Recipe Yield: {_form.AnalysisRecipeYield}");
            notes.Add($"Serving Size: {_form.AnalysisServingSize}");
            AddNutritionPanelNotes(notes, "Recipe Nutrition Analysis", _form.AnalysisCalories, _form.AnalysisTotalFat, _form.AnalysisSaturatedFat, _form.AnalysisTransFat, _form.AnalysisCholesterol, _form.AnalysisSodium, _form.AnalysisTotalCarbohydrate, _form.AnalysisDietaryFiber, _form.AnalysisTotalSugars, _form.AnalysisAddedSugars, _form.AnalysisProtein, _form.AnalysisVitaminD, _form.AnalysisCalcium, _form.AnalysisIron, _form.AnalysisPotassium);
            notes.Add($"Nutrition Facts Panel file names: {FileListText(_analysisFileNames)}");
            notes.Add($"Vegetables Per Serving: {_form.VegetablesPerServing}");
            notes.Add($"Plant-Based Protein Per Serving: {_form.PlantProteinPerServing}");
            notes.Add($"Fruit Per Serving: {_form.FruitPerServing}");
            AddOptionalNote(notes, "Comments", _form.AnalysisComments);
        }

        if (IsSubmissionType(ProductLabelType))
        {
            notes.Add($"Manufacturer: {_form.Manufacturer}");
            notes.Add($"Servings per Container: {OptionalText(_form.ServingsPerContainer)}");
            notes.Add($"Serving Size: {_form.ProductServingSize}");
            AddNutritionPanelNotes(notes, "Pre-Prepared Product", _form.ProductCalories, _form.TotalFat, _form.SaturatedFat, _form.TransFat, _form.Cholesterol, _form.Sodium, _form.TotalCarbohydrate, _form.DietaryFiber, _form.TotalSugars, _form.AddedSugars, _form.Protein, _form.VitaminD, _form.Calcium, _form.Iron, _form.Potassium);
            notes.Add($"Nutrition Facts Panel and Ingredient List file names: {FileListText(_productFileNames)}");
            AddOptionalNote(notes, "Comments", _form.ProductComments);
        }

        return notes;
    }

    private string? GetServingSize() => _form.SubmissionType switch
    {
        FullRecipeType => _form.ServingSize,
        NutritionAnalysisType => _form.AnalysisServingSize,
        ProductLabelType => _form.ProductServingSize,
        _ => null
    };

    private int GetYieldServings() => _form.SubmissionType switch
    {
        FullRecipeType => ParsePositiveInt(_form.RecipeYield),
        NutritionAnalysisType => ParsePositiveInt(_form.AnalysisRecipeYield),
        ProductLabelType => 1,
        _ => 1
    };

    private static int ParsePositiveInt(string value)
    {
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var result) && result > 0 ? result : 1;
    }

    private static List<string> SplitLines(string? value) =>
        (value ?? string.Empty)
        .Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(line => !string.IsNullOrWhiteSpace(line))
        .ToList();

    private static List<string> SplitTokens(string? value) =>
        (value ?? string.Empty)
        .Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(tag => !string.IsNullOrWhiteSpace(tag))
        .ToList();

    private static void AddOptionalNote(List<string> notes, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            notes.Add($"{label}: {value.Trim()}");
        }
    }

    private static void AddNutritionPanelNotes(
        List<string> notes,
        string label,
        decimal? calories,
        decimal? totalFat,
        decimal? saturatedFat,
        decimal? transFat,
        decimal? cholesterol,
        decimal? sodium,
        decimal? totalCarbohydrate,
        decimal? dietaryFiber,
        decimal? totalSugars,
        decimal? addedSugars,
        decimal? protein,
        decimal? vitaminD,
        decimal? calcium,
        decimal? iron,
        decimal? potassium)
    {
        notes.Add($"{label} - Calories (kcal): {NumberText(calories)}");
        notes.Add($"{label} - Total Fat (g): {NumberText(totalFat)}");
        notes.Add($"{label} - Saturated Fat (g): {NumberText(saturatedFat)}");
        notes.Add($"{label} - Trans Fat (g): {NumberText(transFat)}");
        notes.Add($"{label} - Cholesterol (mg): {NumberText(cholesterol)}");
        notes.Add($"{label} - Sodium (mg): {NumberText(sodium)}");
        notes.Add($"{label} - Total Carbohydrate (g): {NumberText(totalCarbohydrate)}");
        notes.Add($"{label} - Dietary Fiber (g): {NumberText(dietaryFiber)}");
        notes.Add($"{label} - Total Sugars (g): {NumberText(totalSugars)}");
        notes.Add($"{label} - Added Sugars (g): {NumberText(addedSugars)}");
        notes.Add($"{label} - Protein (g): {NumberText(protein)}");
        notes.Add($"{label} - Vitamin D (mcg): {NumberText(vitaminD)}");
        notes.Add($"{label} - Calcium (mg): {NumberText(calcium)}");
        notes.Add($"{label} - Iron (mg): {NumberText(iron)}");
        notes.Add($"{label} - Potassium (mg): {NumberText(potassium)}");
    }

    private decimal ActiveSodium => IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisSodium) : IsSubmissionType(ProductLabelType) ? Number(_form.Sodium) : 0;

    private decimal ActiveProtein => IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisProtein) : IsSubmissionType(ProductLabelType) ? Number(_form.Protein) : 0;

    private decimal ActiveFiber => IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisDietaryFiber) : IsSubmissionType(ProductLabelType) ? Number(_form.DietaryFiber) : 0;

    private decimal ActiveCalcium => IsSubmissionType(NutritionAnalysisType) ? Number(_form.AnalysisCalcium) : IsSubmissionType(ProductLabelType) ? Number(_form.Calcium) : 0;

    private static decimal Number(decimal? value) => value ?? 0;

    private static string NumberText(decimal? value) => value.HasValue ? value.Value.ToString("0.##") : "Not entered";

    private static string OptionalText(string? value) => string.IsNullOrWhiteSpace(value) ? "Not entered" : value.Trim();

    private void ResetForm()
    {
        _form.Reset();
        _recipeFileNames.Clear();
        _analysisFileNames.Clear();
        _productFileNames.Clear();
        _errors.Clear();
        _message = null;
    }

    private void CaptureRecipeFiles(InputFileChangeEventArgs args) => CaptureFileNames(args, _recipeFileNames, 5);

    private void CaptureAnalysisFiles(InputFileChangeEventArgs args) => CaptureFileNames(args, _analysisFileNames, 1);

    private void CaptureProductFiles(InputFileChangeEventArgs args) => CaptureFileNames(args, _productFileNames, 4);

    private static void CaptureFileNames(InputFileChangeEventArgs args, List<string> target, int maxFiles)
    {
        target.Clear();
        target.AddRange(args.GetMultipleFiles(maxFiles).Select(file => file.Name));
    }

    private static string FileListText(IReadOnlyCollection<string> fileNames) =>
        fileNames.Count == 0 ? "No file selected" : string.Join(", ", fileNames);

