@page "/recipes/new"
@inject PythonApiClient Api
@inject NavigationManager Navigation

<div class="grid" style="gap: 18px">
    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Recipe</div>
                <h2 style="margin-bottom: 6px">Add Recipe</h2>
                <p class="muted" style="margin: 0">Submit a full recipe, recipe nutrition analysis, or pre-prepared product label for review.</p>
            </div>
            <div class="hero-actions">
                <span class="status-badge warn">Pending review after submit</span>
                <a class="ghost-button" href="/recipes">Recipe List</a>
            </div>
        </div>
    </section>

    <EditForm Model="_form" OnSubmit="SubmitRecipe">
        <div class="recipe-submission-layout">
            <aside class="section recipe-form-nav-panel">
                <div class="eyebrow">Recipe Entry</div>
                <h3 style="margin: 0">Form sections</h3>
                <div class="recipe-form-nav">
                    <a class="recipe-form-nav-item" href="#contact-section">
                        <strong>Contact</strong>
                        <span>Program or caterer name, contact person, and preferred email.</span>
                    </a>
                    <a class="recipe-form-nav-item" href="#recipe-type-section">
                        <strong>Recipe type</strong>
                        <span>Full recipe, nutrition analysis, or product label.</span>
                    </a>
                    @if (IsSubmissionType(FullRecipeType))
                    {
                        <a class="recipe-form-nav-item" href="#source-section">
                            <strong>Recipe source</strong>
                            <span>Source, URL, and recipe file.</span>
                        </a>
                    }
                    <a class="recipe-form-nav-item active" href="#details-section">
                        <strong>@CurrentSubmissionShortLabel</strong>
                        <span>@CurrentSubmissionNavDescription</span>
                    </a>
                    <a class="recipe-form-nav-item" href="#catalog-section">
                        <strong>Catalog classification</strong>
                        <span>Meal type and category.</span>
                    </a>
                    <a class="recipe-form-nav-item" href="#review-section">
                        <strong>Review</strong>
                        <span>Check and submit for review.</span>
                    </a>
                </div>
            </aside>

            <div class="grid" style="gap: 18px">
                @if (_errors.Any())
                {
                    <section class="section validation-panel">
                        <strong>Please review these fields</strong>
                        <ul class="plain-list">
                            @foreach (var error in _errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <section class="section validation-panel success">
                        @_message
                    </section>
                }

                <section class="section" id="contact-section">
                    <div class="section-header">
                        <div>
                            <div class="eyebrow">Contact</div>
                            <h3 style="margin-bottom: 6px">Submitter information</h3>
                        </div>
                    </div>
                    <div class="form-grid-three">
                        <label class="field">
                            <span>Program or Caterer Name <span class="required">*</span></span>
                            <InputText class="input" @bind-Value="_form.ProgramOrCatererName" />
                        </label>
                        <label class="field">
                            <span>Contact Person <span class="required">*</span></span>
                            <InputText class="input" @bind-Value="_form.ContactPerson" />
                        </label>
                        <label class="field">
                            <span>Preferred E-mail Address <span class="required">*</span></span>
                            <InputText class="input" @bind-Value="_form.EmailAddress" />
                        </label>
                    </div>
                </section>

                <section class="section" id="recipe-type-section">
                    <div class="section-header">
                        <div>
                            <div class="eyebrow">Recipe Type</div>
                            <h3 style="margin-bottom: 6px">What type of recipe are you submitting?</h3>
                        </div>
                    </div>
                    <div class="choice-card-grid">
                        @foreach (var option in SubmissionTypes)
                        {
                            <button type="button"
                                    class="choice-card @(IsSubmissionType(option.Key) ? "active" : "")"
                                    @onclick="() => SetSubmissionType(option.Key)">
                                <strong>@option.Label</strong>
                                <span>@option.Description</span>
                            </button>
                        }
                    </div>

                    <div class="form-grid-two" style="margin-top: 16px">
                        <label class="field">
                            <span>Can this recipe be made public? <span class="required">*</span></span>
                            <InputSelect class="input" @bind-Value="_form.IsPublic">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </InputSelect>
                        </label>
                    </div>
                </section>

                @if (IsSubmissionType(FullRecipeType))
                {
                    <section class="section" id="source-section">
                        <div class="section-header">
                            <div>
                                <div class="eyebrow">Recipe Source</div>
                                <h3 style="margin-bottom: 6px">Where is the recipe from?</h3>
                            </div>
                        </div>
                        <div class="form-grid-two">
                            <label class="field">
                                <span>Recipe source <span class="required">*</span></span>
                                <InputSelect class="input" @bind-Value="_form.RecipeSource">
                                    @foreach (var option in RecipeSourceOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </InputSelect>
                            </label>
                            <label class="field">
                                <span>Please provide the recipe URL</span>
                                <InputText class="input" @bind-Value="_form.RecipeUrl" />
                            </label>
                            <div class="field full-span">
                                <span>Please upload recipe file (include ingredients and directions)</span>
                                <div class="file-upload-control">
                                    <label class="file-upload-button" for="recipe-file-input">Choose files</label>
                                    <span class="file-upload-name">@FileListText(_recipeFileNames)</span>
                                    <InputFile id="recipe-file-input" class="file-upload-input" OnChange="CaptureRecipeFiles" multiple />
                                </div>
                                <span class="muted small">Up to 5 files. Accepted source examples: Word, Excel, PPT, PDF, image, video, or audio.</span>
                            </div>
                        </div>
                    </section>

                    <section class="section" id="details-section">
                        <div class="section-header">
                            <div>
                                <div class="eyebrow">Full Recipe</div>
                                <h3 style="margin-bottom: 6px">Ingredients and directions</h3>
                            </div>
                        </div>
                        <div class="form-grid-two">
                            <label class="field">
                                <span>Recipe Name <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.RecipeName" />
                            </label>
                            <label class="field">
                                <span>Recipe Yield <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.RecipeYield" />
                            </label>
                            <label class="field">
                                <span>Serving Size <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.ServingSize" placeholder="Example: 1 cup, 6 oz, 1 sandwich" />
                            </label>
                            <label class="field full-span">
                                <span>Ingredient List <span class="required">*</span></span>
                                <InputTextArea class="input recipe-textarea" @bind-Value="_form.IngredientList" placeholder="Include ingredient type or form, quantity, and unit. Example: Canned Tomato Sauce - 1 #10 can" />
                            </label>
                            <label class="field full-span">
                                <span>Directions <span class="required">*</span></span>
                                <InputTextArea class="input recipe-textarea" @bind-Value="_form.Directions" />
                            </label>
                            <label class="field full-span">
                                <span>Comments (optional)</span>
                                <InputTextArea class="input recipe-textarea compact" @bind-Value="_form.Comments" />
                            </label>
                        </div>
                    </section>
                }

                @if (IsSubmissionType(NutritionAnalysisType))
                {
                    <section class="section" id="details-section">
                        <div class="section-header">
                            <div>
                                <div class="eyebrow">Recipe Nutrition Analysis</div>
                                <h3 style="margin-bottom: 6px">Nutrition analysis details</h3>
                            </div>
                        </div>
                        <div class="form-grid-two">
                            <label class="field">
                                <span>Recipe Name <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.AnalysisRecipeName" />
                            </label>
                            <label class="field">
                                <span>Recipe Yield <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.AnalysisRecipeYield" />
                            </label>
                            <label class="field">
                                <span>Serving Size <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.AnalysisServingSize" placeholder="Example: 1 cup, 6 oz, 1 sandwich" />
                            </label>
                        </div>
                        <div class="field-group-title">Nutrition Facts panel values</div>
                        <div class="nutrition-input-grid">
                            <label class="field">
                                <span>Calories (kcal) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisCalories" />
                            </label>
                            <label class="field">
                                <span>Total Fat (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisTotalFat" />
                            </label>
                            <label class="field">
                                <span>Saturated Fat (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisSaturatedFat" />
                            </label>
                            <label class="field">
                                <span>Trans Fat (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisTransFat" />
                            </label>
                            <label class="field">
                                <span>Cholesterol (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisCholesterol" />
                            </label>
                            <label class="field">
                                <span>Sodium (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisSodium" />
                            </label>
                            <label class="field">
                                <span>Total Carbohydrate (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisTotalCarbohydrate" />
                            </label>
                            <label class="field">
                                <span>Dietary Fiber (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisDietaryFiber" />
                            </label>
                            <label class="field">
                                <span>Total Sugars (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisTotalSugars" />
                            </label>
                            <label class="field">
                                <span>Added Sugars (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisAddedSugars" />
                            </label>
                            <label class="field">
                                <span>Protein (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisProtein" />
                            </label>
                            <label class="field">
                                <span>Vitamin D (mcg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisVitaminD" />
                            </label>
                            <label class="field">
                                <span>Calcium (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisCalcium" />
                            </label>
                            <label class="field">
                                <span>Iron (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisIron" />
                            </label>
                            <label class="field">
                                <span>Potassium (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AnalysisPotassium" />
                            </label>
                        </div>
                        <div class="form-grid-two" style="margin-top: 12px">
                            <div class="field">
                                <span>Upload Recipe Nutrition Facts Panel <span class="required">*</span></span>
                                <div class="file-upload-control">
                                    <label class="file-upload-button" for="analysis-file-input">Choose file</label>
                                    <span class="file-upload-name">@FileListText(_analysisFileNames)</span>
                                    <InputFile id="analysis-file-input" class="file-upload-input" OnChange="CaptureAnalysisFiles" />
                                </div>
                            </div>
                            <label class="field full-span">
                                <span>Vegetables Per Serving <span class="required">*</span></span>
                                <InputTextArea class="input recipe-textarea compact" @bind-Value="_form.VegetablesPerServing" placeholder="List each vegetable and amount per serving in cups or ounces. If none, enter 0." />
                            </label>
                            <label class="field full-span">
                                <span>Plant-Based Protein Per Serving <span class="required">*</span></span>
                                <InputTextArea class="input recipe-textarea compact" @bind-Value="_form.PlantProteinPerServing" placeholder="List each plant-based protein and amount per serving in cups or ounces. If none, enter 0." />
                            </label>
                            <label class="field full-span">
                                <span>Fruit Per Serving <span class="required">*</span></span>
                                <InputTextArea class="input recipe-textarea compact" @bind-Value="_form.FruitPerServing" placeholder="List each fruit and amount per serving in cups or ounces. If none, enter 0." />
                            </label>
                            <label class="field full-span">
                                <span>Comments (optional)</span>
                                <InputTextArea class="input recipe-textarea compact" @bind-Value="_form.AnalysisComments" />
                            </label>
                        </div>
                    </section>
                }

                @if (IsSubmissionType(ProductLabelType))
                {
                    <section class="section" id="details-section">
                        <div class="section-header">
                            <div>
                                <div class="eyebrow">Pre-Prepared Product</div>
                                <h3 style="margin-bottom: 6px">Product label details</h3>
                            </div>
                        </div>
                        <div class="form-grid-three">
                            <label class="field">
                                <span>Product Name <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.ProductName" />
                            </label>
                            <label class="field">
                                <span>Manufacturer <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.Manufacturer" />
                            </label>
                            <label class="field">
                                <span>Servings per Container</span>
                                <InputText class="input" @bind-Value="_form.ServingsPerContainer" placeholder="If available" />
                            </label>
                            <label class="field">
                                <span>Serving Size <span class="required">*</span></span>
                                <InputText class="input" @bind-Value="_form.ProductServingSize" placeholder="Include units" />
                            </label>
                        </div>
                        <div class="field-group-title">Nutrition Facts panel values</div>
                        <div class="nutrition-input-grid">
                            <label class="field">
                                <span>Calories (kcal) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.ProductCalories" />
                            </label>
                            <label class="field">
                                <span>Total Fat (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.TotalFat" />
                            </label>
                            <label class="field">
                                <span>Saturated Fat (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.SaturatedFat" />
                            </label>
                            <label class="field">
                                <span>Trans Fat (g)</span>
                                <InputNumber class="input" @bind-Value="_form.TransFat" />
                            </label>
                            <label class="field">
                                <span>Cholesterol (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.Cholesterol" />
                            </label>
                            <label class="field">
                                <span>Sodium (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.Sodium" />
                            </label>
                            <label class="field">
                                <span>Total Carbohydrate (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.TotalCarbohydrate" />
                            </label>
                            <label class="field">
                                <span>Dietary Fiber (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.DietaryFiber" />
                            </label>
                            <label class="field">
                                <span>Total Sugars (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.TotalSugars" />
                            </label>
                            <label class="field">
                                <span>Added Sugars (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.AddedSugars" />
                            </label>
                            <label class="field">
                                <span>Protein (g) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.Protein" />
                            </label>
                            <label class="field">
                                <span>Vitamin D (mcg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.VitaminD" />
                            </label>
                            <label class="field">
                                <span>Calcium (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.Calcium" />
                            </label>
                            <label class="field">
                                <span>Iron (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.Iron" />
                            </label>
                            <label class="field">
                                <span>Potassium (mg) <span class="required">*</span></span>
                                <InputNumber class="input" @bind-Value="_form.Potassium" />
                            </label>
                        </div>
                        <div class="form-grid-two" style="margin-top: 12px">
                            <div class="field full-span">
                                <span>Upload Nutrition Facts Panel and Ingredient List <span class="required">*</span></span>
                                <div class="file-upload-control">
                                    <label class="file-upload-button" for="product-file-input">Choose files</label>
                                    <span class="file-upload-name">@FileListText(_productFileNames)</span>
                                    <InputFile id="product-file-input" class="file-upload-input" OnChange="CaptureProductFiles" multiple />
                                </div>
                                <span class="muted small">Up to 4 files. Accepted source examples: Word, Excel, PPT, PDF, image, video, or audio.</span>
                            </div>
                            <label class="field full-span">
                                <span>Comments (optional)</span>
                                <InputTextArea class="input recipe-textarea compact" @bind-Value="_form.ProductComments" placeholder="If available, include the product URL here." />
                            </label>
                        </div>
                    </section>
                }

                <section class="section" id="catalog-section">
                    <div class="section-header">
                        <div>
                            <div class="eyebrow">Catalog Classification</div>
                            <h3 style="margin-bottom: 6px">Simple Servings fields</h3>
                            <p class="muted" style="margin: 0">These fields place the submission in the recipe catalog while it waits for review.</p>
                        </div>
                    </div>
                    <div class="form-grid-two">
                        <label class="field">
                            <span>Meal type</span>
                            <InputSelect class="input" @bind-Value="_form.MealType">
                                @foreach (var option in MealTypeOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </InputSelect>
                        </label>
                        <label class="field">
                            <span>Category</span>
                            <InputSelect class="input" @bind-Value="_form.Category">
                                @foreach (var option in CategoryOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </InputSelect>
                        </label>
                    </div>
                </section>

                <section class="section" id="review-section">
                    <div class="section-header">
                        <div>
                            <div class="eyebrow">Review</div>
                            <h3 style="margin-bottom: 6px">Submission summary</h3>
                        </div>
                    </div>
                    <div class="summary-grid recipe-submit-summary">
                        <div class="summary-card">
                            <div class="summary-value">@CurrentRecipeNamePreview</div>
                            <div class="muted small">Recipe or product name</div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-value">@CurrentSubmissionLabel</div>
                            <div class="muted small">Submission type</div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-value">@(_form.IsPublic ? "Yes" : "No")</div>
                            <div class="muted small">Can be made public</div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-value">Pending</div>
                            <div class="muted small">Approval status</div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="button" disabled="@_isSubmitting">@(_isSubmitting ? "Submitting..." : "Submit recipe for review")</button>
                        <button type="button" class="ghost-button" @onclick="ResetForm" disabled="@_isSubmitting">Clear form</button>
                    </div>
                </section>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private const string FullRecipeType = "full-recipe";
    private const string NutritionAnalysisType = "nutrition-analysis";
    private const string ProductLabelType = "product-label";

    private readonly RecipeSubmissionForm _form = new();
    private readonly List<string> _errors = [];
    private readonly List<string> _recipeFileNames = [];
    private readonly List<string> _analysisFileNames = [];
    private readonly List<string> _productFileNames = [];
    private bool _isSubmitting;
    private string? _message;

    private static readonly SubmissionOption[] SubmissionTypes =
    [
        new(FullRecipeType, "Full recipe with ingredients and directions", "Use for recipes entered from written instructions."),
        new(NutritionAnalysisType, "Recipe nutrition analysis", "Use when submitting nutrition analysis for an existing recipe."),
        new(ProductLabelType, "Pre-prepared product label", "Use for packaged or prepared products with a Nutrition Facts panel.")
    ];

    private static readonly string[] RecipeSourceOptions =
    [
        "A recipe created by our organization",
        "A recipe from the internet",
        "A printed recipe (book, magazine, handout, etc.)",
        "Other"
    ];

    private static readonly SelectOption[] MealTypeOptions =
    [
        new("breakfast", "Breakfast"),
        new("lunch", "Lunch"),
        new("dinner", "Dinner"),
        new("snack", "Snack")
    ];

    private static readonly SelectOption[] CategoryOptions =
    [
        new("entree", "Entree"),
        new("side", "Side"),
        new("grain", "Grain"),
        new("fruit", "Fruit"),
        new("vegetable", "Vegetable"),
        new("milk", "Milk/Yogurt"),
        new("appetizer", "Appetizer"),
        new("condiments", "Condiments"),
        new("juice", "Juice or Dessert")
    ];

    private string CurrentSubmissionLabel => SubmissionTypes.First(option => option.Key == _form.SubmissionType).Label;

    private string CurrentSubmissionShortLabel => _form.SubmissionType switch
    {
        FullRecipeType => "Recipe details",
        NutritionAnalysisType => "Nutrition analysis",
        ProductLabelType => "Product label",
        _ => "Details"
    };

    private string CurrentSubmissionNavDescription => _form.SubmissionType switch
    {
        FullRecipeType => "Recipe name, yield, serving size, ingredients, and directions.",
        NutritionAnalysisType => "Nutrition panel and meal component amounts per serving.",
        ProductLabelType => "Product name, manufacturer, nutrients, and label files.",
        _ => "Submission details."
    };

    private string CurrentRecipeNamePreview => _form.SubmissionType switch
    {
        FullRecipeType => string.IsNullOrWhiteSpace(_form.RecipeName) ? "Not entered" : _form.RecipeName,
        NutritionAnalysisType => string.IsNullOrWhiteSpace(_form.AnalysisRecipeName) ? "Not entered" : _form.AnalysisRecipeName,
        ProductLabelType => string.IsNullOrWhiteSpace(_form.ProductName) ? "Not entered" : _form.ProductName,
        _ => "Not entered"
    };

    private bool IsSubmissionType(string type) => _form.SubmissionType.Equals(type, StringComparison.OrdinalIgnoreCase);

    private void SetSubmissionType(string type)
    {
        _form.SubmissionType = type;
        _message = null;
        _errors.Clear();
    }

    private async Task SubmitRecipe()
    {
        _errors.Clear();
        _message = null;

        ValidateForm();
        if (_errors.Any())
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var created = await Api.CreateRecipeAsync(BuildRecipeRequest());
            _message = $"Recipe #{created.RecipeId} was submitted for review.";
            Navigation.NavigateTo($"/recipes/{created.RecipeId}");
        }
        catch (Exception ex)
        {
            _errors.Add($"The recipe could not be submitted: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ValidateForm()
    {
        Require(_form.ProgramOrCatererName, "Program or Caterer Name is required.");
        Require(_form.ContactPerson, "Contact Person is required.");
        Require(_form.EmailAddress, "Preferred E-mail Address is required.");

        if (IsSubmissionType(FullRecipeType))
        {
            Require(_form.RecipeName, "Recipe Name is required.");
