@page "/recipes"
@inject PythonApiClient Api
@inject AppModeService AppMode

<div class="grid" style="gap: 18px">
    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Recipe catalog</div>
                <h2 style="margin-bottom: 6px">Approved recipe registry</h2>
                <p class="muted" style="margin: 0">Search recipes by name, ingredient list, tag, meal type, and category.</p>
            </div>
        </div>

        <div class="recipes-layout">
            <aside class="recipes-filters">
                <div class="section-header">
                    <div>
                        <div class="eyebrow">Search</div>
                        <h3>Filters</h3>
                    </div>
                </div>
                <input class="input" value="@SearchText" @oninput="OnSearchChanged" placeholder="Search by recipe name, ingredient, tag, or meal type" />
                <div class="filter-group">
                    <label for="recipe-meal-view" class="small muted">Meal view</label>
                    <select id="recipe-meal-view" class="input compact-filter-select" value="@RecipeViewMode" @onchange="OnRecipeViewChanged">
                        <option value="@RecommendedMode">Recommended</option>
                        <option value="@BreakfastMode">Breakfast</option>
                        <option value="@LunchMode">Lunch</option>
                        <option value="@DinnerMode">Dinner</option>
                        <option value="@AllMode">All meal types</option>
                    </select>
                </div>
                @if (IsAdmin)
                {
                    <div class="filter-group">
                        <label for="recipe-status" class="small muted">Workflow status</label>
                        <select id="recipe-status" class="input compact-filter-select" value="@StatusMode" @onchange="OnStatusChanged">
                            <option value="@AllStatusMode">All statuses</option>
                            <option value="@ApprovedStatusMode">Approved</option>
                            <option value="@DraftStatusMode">Pending review</option>
                        </select>
                    </div>
                }
                <div class="filter-group">
                    <label for="recipe-tag-group" class="small muted">Tag group</label>
                    <InputSelect id="recipe-tag-group" class="input compact-filter-select" @bind-Value="LegacyFilterGroupKey">
                        <option value="">Choose a tag group</option>
                        @foreach (var group in LegacyReferenceData.RecipeFilterGroups)
                        {
                            <option value="@group.Key">@group.Label</option>
                        }
                    </InputSelect>
                    <label for="recipe-tag-value" class="small muted">Tag</label>
                    <InputSelect id="recipe-tag-value" class="input compact-filter-select" @bind-Value="LegacyFilterValue">
                        <option value="">Choose a tag</option>
                        @foreach (var option in LegacyFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                    <button type="button" class="secondary-button" @onclick="AddTagFilter" disabled="@string.IsNullOrWhiteSpace(LegacyFilterValue)">Add filter</button>
                    @if (SelectedTagFilters.Any())
                    {
                        <div class="selected-filter-list">
                            @foreach (var filter in SelectedTagFilters.OrderBy(value => value))
                            {
                                <button type="button" class="selected-filter-chip" @onclick="() => RemoveTagFilter(filter)">
                                    <span>@filter</span><span aria-hidden="true">×</span>
                                </button>
                            }
                        </div>
                        <button type="button" class="text-action" @onclick="ClearTagFilters">Clear tag filters</button>
                    }
                </div>
                <div class="filter-group">
                    <label for="recipe-category" class="small muted">Recipe category</label>
                    <select id="recipe-category" class="input compact-filter-select" value="@CategoryMode" @onchange="OnCategoryChanged">
                        <option value="@AllCategoriesMode">All categories</option>
                        <option value="@EntreeCategory">Entree</option>
                        <option value="@SideCategory">Side</option>
                        <option value="@GrainCategory">Grain</option>
                        <option value="@FruitCategory">Fruit</option>
                        <option value="@VegetableCategory">Vegetable</option>
                        <option value="@MilkCategory">Milk</option>
                    </select>
                </div>
                <div class="filter-group">
                    <div class="small muted">Saved filters</div>
                    <div class="toggle-row">
                        <button type="button" class="@FilterToggleClass(FavoritesOnly)" @onclick="ToggleFavoritesOnly">My Favorites</button>
                        @if (IsAdmin)
                        {
                            <button type="button" class="@FilterToggleClass(IncludeArchived)" @onclick="ToggleIncludeArchived">Include archived</button>
                        }
                    </div>
                </div>
            </aside>

            <section class="recipes-main">
                <div class="section">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">@RecipeViewTitle</h3>
                            <p class="muted small" style="margin: 0">@FilteredRecipesList.Count() recipe@(FilteredRecipesList.Count() == 1 ? "" : "s") match the current filters.</p>
                        </div>
                        <div class="results-toolbar recipe-results-toolbar">
                            <label for="recipe-page-size" class="muted small">Rows</label>
                            <select id="recipe-page-size" class="compact-page-size" value="@VisibleRecipeCount" @onchange="OnVisibleRecipeCountChanged">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="@int.MaxValue">All</option>
                            </select>
                        </div>
                    </div>

                    <div class="recipes-results-scroll">
                        <div class="admin-table-wrap recipe-registry-wrap">
                            <table class="admin-table recipe-registry-table">
                                <thead>
                                    <tr>
                                        <th>Recipe</th>
                                        <th>Description</th>
                                        <th><button type="button" class="sortable-column" @onclick="ToggleUploadDateSort">Uploaded @UploadSortIndicator</button></th>
                                        <th>Visibility / Status</th>
                                        @if (IsAdmin)
                                        {
                                            <th>Action</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var recipe in VisibleRecipes)
                                    {
                                        <tr>
                                            <td>
                                                <div class="recipe-registry-name">
                                                    <div class="table-title-row">
                                                        <span class="status-badge">#@recipe.RecipeId</span>
                                                        <a class="recipe-registry-link" href="@($"/recipes/{recipe.RecipeId}")">@recipe.RecipeName</a>
                                                        <span class="status-badge @(recipe.IsApproved ? "good" : "warn")">@ApprovalLabel(recipe)</span>
                                                    </div>
                                                    <div class="muted small">@DisplayMealType(recipe.MealType) · @DisplayCategory(recipe.Category)</div>
                                                    <div class="muted small">Contributed by @(recipe.ContributedBy ?? "Not listed")</div>
                                                </div>
                                            </td>
                                            <td><span class="recipe-one-line-description">@RecipeDescription(recipe)</span></td>
                                            <td>@(recipe.CreatedOn?.ToString("MMM d, yyyy") ?? "Not recorded")</td>
                                            <td>
                                                <div class="resource-meta-stack">
                                                    <span>@(recipe.IsPublic ? "Public" : "Private")</span>
                                                    <span class="status-badge @(recipe.IsDead ? "" : recipe.IsApproved ? "good" : "warn")">@(recipe.IsDead ? "Archived" : ApprovalLabel(recipe))</span>
                                                </div>
                                            </td>
                                            @if (IsAdmin)
                                            {
                                                <td>
                                                    <div class="table-actions">
                                                    @if (!recipe.IsApproved)
                                                    {
                                                        <a class="table-action-link primary" href="@($"/recipes/{recipe.RecipeId}/review")">Review</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="table-action-link primary" href="@($"/recipes/{recipe.RecipeId}/edit")">Edit</a>
                                                    }
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private AppRole CurrentRole { get; set; } = AppRole.Admin;

    private bool IsAdmin => CurrentRole == AppRole.Admin;

    [SupplyParameterFromQuery(Name = "legacy")]
    public string? LegacyFilter { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusFilter { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryFilter { get; set; }

    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealFilter { get; set; }

    private const string RecommendedMode = "recommended";
    private const string AllMode = "all";
    private const string BreakfastMode = "breakfast";
    private const string LunchMode = "lunch";
    private const string DinnerMode = "dinner";
    private const string AllStatusMode = "all";
    private const string ApprovedStatusMode = "approved";
    private const string DraftStatusMode = "draft";
    private const string AllCategoriesMode = "all";
    private const string EntreeCategory = "entree";
    private const string SideCategory = "side";
    private const string GrainCategory = "grain";
    private const string FruitCategory = "fruit";
    private const string VegetableCategory = "vegetable";
    private const string MilkCategory = "milk";

    private string SearchText { get; set; } = string.Empty;
    private string RecipeViewMode { get; set; } = RecommendedMode;
    private string StatusMode { get; set; } = AllStatusMode;
    private string CategoryMode { get; set; } = AllCategoriesMode;
    private string LegacyFilterGroupKey { get; set; } = string.Empty;
    private string LegacyFilterValue { get; set; } = string.Empty;
    private bool FavoritesOnly { get; set; }
    private bool IncludeArchived { get; set; }
    private bool SortByUploadDate { get; set; } = true;
    private bool UploadDateDescending { get; set; } = true;
    private HashSet<string> SelectedTagFilters { get; } = new(StringComparer.OrdinalIgnoreCase);
    private int VisibleRecipeCount { get; set; } = 25;
    private List<RecipeDto> RecipeItems { get; set; } = new();
    private List<int> PopularRecipeIds { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        RecipeItems = await Api.GetRecipesAsync();
        var analytics = await Api.GetAnalyticsAsync();
        PopularRecipeIds = analytics.TopRecipes.Select(item => item.RecipeId).ToList();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(LegacyFilter))
        {
            LegacyFilterValue = LegacyFilter;
            SelectedTagFilters.Add(LegacyFilter);
            LegacyFilterGroupKey = LegacyReferenceData.RecipeFilterGroups
                .FirstOrDefault(group => group.Options.Any(option => option.Equals(LegacyFilter, StringComparison.OrdinalIgnoreCase)))?.Key
                ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            StatusMode = StatusFilter.Trim().ToLowerInvariant() switch
            {
                "pending" or "pending-review" or "draft" => DraftStatusMode,
                "approved" => ApprovedStatusMode,
                _ => AllStatusMode
            };
        }

        if (!string.IsNullOrWhiteSpace(CategoryFilter))
        {
            CategoryMode = CategoryFilter.Trim().ToLowerInvariant();
        }

        if (!string.IsNullOrWhiteSpace(MealFilter))
        {
            RecipeViewMode = MealFilter.Trim().ToLowerInvariant() switch
            {
                BreakfastMode => BreakfastMode,
                LunchMode => LunchMode,
                DinnerMode => DinnerMode,
                _ => RecommendedMode
            };
        }
    }

    private int ApprovedCount => RecipeItems.Count(recipe => recipe.IsApproved);

    private IEnumerable<RecipeDto> FilteredRecipesList => SortRecipes(
        RecipeItems
            .Where(recipe => IsAdmin || (recipe.IsPublic && recipe.IsApproved && !recipe.IsDead))
            .Where(recipe => recipe.Matches(SearchText))
            .Where(recipe => IncludeArchived || !recipe.IsDead)
            .Where(recipe => StatusMode == AllStatusMode
                || (StatusMode == ApprovedStatusMode && recipe.IsApproved)
                || (StatusMode == DraftStatusMode && !recipe.IsApproved))
            .Where(recipe => RecipeViewMode == AllMode
                || RecipeViewMode == RecommendedMode
                || recipe.MealType.Equals(RecipeViewMode, StringComparison.OrdinalIgnoreCase))
            .Where(recipe => !FavoritesOnly || recipe.IsFavorite)
            .Where(recipe => CategoryMode == AllCategoriesMode
                || recipe.Category.Equals(CategoryMode, StringComparison.OrdinalIgnoreCase))
            .Where(MatchesSelectedFilters));

    private IEnumerable<RecipeDto> RecommendedRecipes =>
        PopularRecipeIds.Count == 0
            ? RecipeItems
                .Where(recipe => IsAdmin || (recipe.IsPublic && recipe.IsApproved && !recipe.IsDead))
                .Where(recipe => recipe.IsFavorite)
                .Take(6)
            : RecipeItems
                .Where(recipe => IsAdmin || (recipe.IsPublic && recipe.IsApproved && !recipe.IsDead))
                .Where(recipe => recipe.Matches(SearchText))
                .Where(recipe => IncludeArchived || !recipe.IsDead)
                .Where(recipe => StatusMode == AllStatusMode
                    || (StatusMode == ApprovedStatusMode && recipe.IsApproved)
                    || (StatusMode == DraftStatusMode && !recipe.IsApproved))
                .Where(recipe => CategoryMode == AllCategoriesMode
                    || recipe.Category.Equals(CategoryMode, StringComparison.OrdinalIgnoreCase))
                .Where(MatchesSelectedFilters)
                .Where(recipe => recipe.IsFavorite || PopularRecipeIds.Contains(recipe.RecipeId))
                .OrderByDescending(recipe => recipe.IsFavorite)
                .ThenBy(recipe => PopularRecipeIds.IndexOf(recipe.RecipeId) < 0 ? 999 : PopularRecipeIds.IndexOf(recipe.RecipeId))
                .Take(6);

    private IEnumerable<RecipeDto> VisibleRecipes => FilteredRecipesList.Take(VisibleRecipeCount);

    private string RecipeViewTitle => RecipeViewMode switch
    {
        BreakfastMode => CategoryMode == AllCategoriesMode ? "Breakfast recipes" : $"Breakfast recipes · {CategoryTitle}",
        LunchMode => CategoryMode == AllCategoriesMode ? "Lunch recipes" : $"Lunch recipes · {CategoryTitle}",
        DinnerMode => CategoryMode == AllCategoriesMode ? "Dinner recipes" : $"Dinner recipes · {CategoryTitle}",
        AllMode => CategoryMode == AllCategoriesMode ? "All recipes" : $"{CategoryTitle} recipes",
        _ => CategoryMode == AllCategoriesMode ? "Recommended recipes" : $"Recommended recipes · {CategoryTitle}"
    };

    private void SetRecipeViewMode(string mode)
    {
        RecipeViewMode = mode;
        ResetVisibleRecipeCount();
    }

    private void OnRecipeViewChanged(ChangeEventArgs args) =>
        SetRecipeViewMode(args.Value?.ToString() ?? RecommendedMode);

    private void OnStatusChanged(ChangeEventArgs args) =>
        SetStatusMode(args.Value?.ToString() ?? AllStatusMode);

    private void OnCategoryChanged(ChangeEventArgs args) =>
        SetCategoryMode(args.Value?.ToString() ?? AllCategoriesMode);

    private void OnSearchChanged(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString() ?? string.Empty;
        ResetVisibleRecipeCount();
    }

    private void SetCategoryMode(string category)
    {
        CategoryMode = category;
        ResetVisibleRecipeCount();
    }

    private void ToggleFavoritesOnly()
    {
        FavoritesOnly = !FavoritesOnly;
        ResetVisibleRecipeCount();
    }

    private void ToggleIncludeArchived()
    {
        IncludeArchived = !IncludeArchived;
        ResetVisibleRecipeCount();
    }

    private void AddTagFilter()
    {
        if (!string.IsNullOrWhiteSpace(LegacyFilterValue))
        {
            SelectedTagFilters.Add(LegacyFilterValue);
            LegacyFilterValue = string.Empty;
            ResetVisibleRecipeCount();
        }
    }

    private void RemoveTagFilter(string filter)
    {
        SelectedTagFilters.Remove(filter);
        ResetVisibleRecipeCount();
    }

    private void ClearTagFilters()
    {
        SelectedTagFilters.Clear();
        LegacyFilterGroupKey = string.Empty;
        LegacyFilterValue = string.Empty;
        ResetVisibleRecipeCount();
    }

    private void ToggleUploadDateSort()
    {
        if (SortByUploadDate)
        {
            UploadDateDescending = !UploadDateDescending;
        }
        else
        {
            SortByUploadDate = true;
            UploadDateDescending = true;
        }
    }

    private string UploadSortIndicator => !SortByUploadDate ? string.Empty : UploadDateDescending ? "↓" : "↑";

    private void SetVisibleRecipeCount(int count)
    {
        VisibleRecipeCount = count;
    }

    private void OnVisibleRecipeCountChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var count))
        {
            SetVisibleRecipeCount(count);
        }
    }

    private void ResetVisibleRecipeCount() => VisibleRecipeCount = 25;

    private static string FilterToggleClass(bool isActive) => isActive ? "filter-toggle active" : "filter-toggle";

    private int Rank(RecipeDto recipe)
    {
        var recommendedRank = PopularRecipeIds.IndexOf(recipe.RecipeId);
        if (recommendedRank >= 0)
        {
            return recommendedRank;
        }

        return 1000 + recipe.MealType switch
        {
            "breakfast" => 0,
            "lunch" => 1,
            "dinner" => 2,
            _ => 3
        };
    }

    private string CategoryTitle => CategoryMode switch
    {
        EntreeCategory => "Entree",
        SideCategory => "Side",
        GrainCategory => "Grain",
        FruitCategory => "Fruit",
        VegetableCategory => "Vegetable",
        MilkCategory => "Milk",
        _ => "All categories"
    };

    private string StatusLabel => StatusMode switch
    {
        ApprovedStatusMode => "Approved only",
        DraftStatusMode => "Pending review only",
        _ => "All statuses"
    };

    private static string ApprovalLabel(RecipeDto recipe) => recipe.IsApproved ? "Approved" : "Pending review";

    private IReadOnlyList<string> LegacyFilterOptions =>
        LegacyReferenceData.RecipeFilterGroups
            .FirstOrDefault(group => group.Key == LegacyFilterGroupKey)?.Options
        ?? LegacyReferenceData.RecipeFilterGroups.SelectMany(group => group.Options).ToArray();

    private bool MatchesSelectedFilters(RecipeDto recipe) =>
        SelectedTagFilters.All(filter => MatchesTagFilter(recipe, filter));

    private static bool MatchesTagFilter(RecipeDto recipe, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        var normalizedFilter = LegacyReferenceData.NormalizeFilterValue(filter);
        var aliases = LegacyFilterAliases(normalizedFilter);
        var haystack = LegacyReferenceData.NormalizeFilterValue(string.Join(' ', new[]
        {
            recipe.RecipeName,
            recipe.MealType,
            recipe.Category,
            string.Join(' ', recipe.Tags),
            string.Join(' ', recipe.NutrientClaims),
            string.Join(' ', recipe.Ingredients)
        }));

        return aliases.Any(alias => haystack.Contains(alias, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<RecipeDto> SortRecipes(IEnumerable<RecipeDto> recipes)
    {
        if (SortByUploadDate)
        {
            return UploadDateDescending
                ? recipes.OrderByDescending(recipe => recipe.CreatedOn ?? DateTime.MinValue).ThenBy(recipe => recipe.RecipeName)
                : recipes.OrderBy(recipe => recipe.CreatedOn ?? DateTime.MinValue).ThenBy(recipe => recipe.RecipeName);
        }

        return recipes.OrderBy(Rank).ThenBy(recipe => recipe.RecipeName);
    }

    private static string RecipeDescription(RecipeDto recipe)
    {
        var parts = new List<string>();
        var ingredients = recipe.Ingredients
            .Where(value => !value.Contains("file", StringComparison.OrdinalIgnoreCase))
            .Where(value => !value.StartsWith("Vegetables per serving", StringComparison.OrdinalIgnoreCase))
            .Where(value => !value.StartsWith("Plant-based protein", StringComparison.OrdinalIgnoreCase))
            .Where(value => !value.StartsWith("Fruit per serving", StringComparison.OrdinalIgnoreCase))
            .Take(3)
            .ToList();
        if (ingredients.Count > 0)
        {
            parts.Add($"Main ingredients: {string.Join(", ", ingredients)}");
        }

        var cuisine = recipe.Tags.FirstOrDefault(tag => tag.Contains("cuisine", StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(cuisine))
        {
            parts.Add(cuisine);
        }

        var vegetableServing = recipe.Ingredients.FirstOrDefault(value => value.StartsWith("Vegetables per serving", StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(vegetableServing) && !vegetableServing.EndsWith(": 0", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add(vegetableServing);
        }

        return parts.Count == 0
            ? $"{DisplayCategory(recipe.Category)} recipe for {DisplayMealType(recipe.MealType).ToLowerInvariant()} service."
            : string.Join(" · ", parts);
    }

    private static string DisplayCategory(string value) => value.ToLowerInvariant() switch
    {
        "entree" => "Entrée",
        "milk" => "Milk/Yogurt",
        "dairy-free" => "Dairy or non-dairy equivalent",
        _ => string.IsNullOrWhiteSpace(value) ? "Recipe" : char.ToUpperInvariant(value[0]) + value[1..]
    };

    private static string DisplayMealType(string value) => string.IsNullOrWhiteSpace(value)
        ? "Meal"
        : char.ToUpperInvariant(value[0]) + value[1..];

    private static string[] LegacyFilterAliases(string normalizedFilter) => normalizedFilter switch
    {
        "entree" => ["entree", "main", "protein"],
        "entrée" => ["entree", "main", "protein"],
        "grains" => ["grain", "whole grain", "rice", "pasta", "bread"],
        "whole grains" => ["whole grain", "grain"],
        "milk yogurt" => ["milk", "yogurt", "dairy", "calcium"],
        "juice or dessert" => ["juice", "dessert", "fruit"],
        "non starchy vegetable" => ["non starchy", "vegetable"],
        "starchy vegetable" => ["starchy", "vegetable", "potato", "corn"],
        "plant based entree" => ["plant based", "vegetarian", "tofu", "lentil", "bean"],
        "plant based entree (1 2)" => ["plant based", "vegetarian", "tofu", "lentil", "bean"],
        "plant based feature" => ["plant based", "vegetarian", "tofu", "lentil", "bean"],
        "very low sodium" => ["very low sodium", "low sodium"],
        "good source of calcium" => ["calcium", "milk", "dairy"],
        "good source of vitamin c" => ["vitamin c", "fruit", "vegetable"],
        "good source of fiber" => ["fiber", "high fiber", "whole grain"],
        "good for hot meal" => ["hot", "warm meal"],
        "good for cold meal" => ["cold", "chilled"],
        "good for frozen meal" => ["frozen"],
        "dairy free" => ["dairy free", "non dairy"],
        _ => [normalizedFilter]
    };

    private void SetStatusMode(string mode)
    {
        StatusMode = mode;
        ResetVisibleRecipeCount();
    }

    private static string MealBadgeClass(string mealType) => mealType.ToLowerInvariant() switch
    {
        "breakfast" => "meal-breakfast",
        "lunch" => "meal-lunch",
        "dinner" => "meal-dinner",
        "snack" => "meal-lunch",
        _ => string.Empty
    };

    private static string MealShortName(string mealType) => mealType.ToLowerInvariant() switch
    {
        "breakfast" => "B",
        "lunch" => "L",
        "dinner" => "D",
        "snack" => "S",
        _ => "?"
    };
}
