@page "/recipes/home"
@inject PythonApiClient Api
@inject AppModeService AppMode

<div class="grid" style="gap: 18px">
    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Recipe</div>
                <h2 style="margin-bottom: 6px">Recipe home</h2>
                <p class="muted" style="margin: 0">Browse approved recipes by category, favorites, and the same advanced search groups staff know from Simple Servings.</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Our Recipes</div>
                <h3 style="margin-bottom: 6px">Recipe categories</h3>
            </div>
            @if (IsAdmin)
            {
                <details class="inline-settings-details">
                    <summary>Choose displayed categories</summary>
                    <div class="category-visibility-panel">
                        @foreach (var category in AllCategories)
                        {
                            <label class="checkbox-pill">
                                <input type="checkbox" checked="@SelectedCategoryKeys.Contains(category.Key)" @onchange="args => SetCategoryVisible(category.Key, args)" />
                                <span>@category.Label</span>
                            </label>
                        }
                    </div>
                    <div class="category-add-panel">
                        <strong>Add a category</strong>
                        <InputText class="input compact-input" @bind-Value="NewCategoryLabel" placeholder="Category name" />
                        <InputText class="input compact-input" @bind-Value="NewCategoryDescription" placeholder="One-line description" />
                        <button type="button" class="secondary-button" @onclick="AddCategory" disabled="@string.IsNullOrWhiteSpace(NewCategoryLabel)">Add category</button>
                        @if (!string.IsNullOrWhiteSpace(CategoryMessage))
                        {
                            <span class="small muted">@CategoryMessage</span>
                        }
                    </div>
                </details>
            }
        </div>
        <div class="legacy-tile-grid">
            @foreach (var tile in DisplayedCategories)
            {
                <a class="legacy-tile link-card" href="@CategoryHref(tile)">
                    <span class="legacy-tile-head">
                        <span class="legacy-tile-mark">@tile.Label.Substring(0, 1)</span>
                        <strong>@tile.Label</strong>
                    </span>
                    <span>@tile.Description</span>
                </a>
            }
        </div>
    </section>

    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Advanced Search By Category</div>
                <h3 style="margin-bottom: 6px">Filter groups</h3>
            </div>
            <a class="ghost-button" href="/recipes">Search / See All Recipes</a>
        </div>
        <div class="legacy-accordion-grid">
            @foreach (var group in LegacyReferenceData.RecipeFilterGroups)
            {
                <article class="legacy-search-group">
                    <div class="legacy-search-title">@group.Label</div>
                    <div class="filter-chip-grid">
                        @foreach (var option in group.Options)
                        {
                            <a class="secondary-button tiny-button" href="@($"/recipes?legacy={Uri.EscapeDataString(option)}")">@option</a>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Featured Recipes</div>
                <h3 style="margin-bottom: 6px">Frequently used approved recipes</h3>
            </div>
            <div class="hero-actions">
                @if (IsAdmin)
                {
                    <span class="status-badge warn">@PendingReviewCount pending review</span>
                }
                <span class="status-badge brand">@FeaturedRecipes.Count() recipes</span>
            </div>
        </div>
        <div class="recipe-strip">
            @foreach (var recipe in FeaturedRecipes)
            {
                <a class="recipe-strip-card link-card" href="@($"/recipes/{recipe.RecipeId}")">
                    <div class="recipe-card-head">
                        <div>
                            <strong>@recipe.RecipeName</strong>
                            <div class="muted small">@recipe.MealType · @recipe.Category · @recipe.Calories kcal</div>
                        </div>
                        <span class="status-badge brand">@DisplayCategory(recipe.Category)</span>
                    </div>
                    <div class="recipe-card-meta-line">
                        <span>@DisplayMealType(recipe.MealType)</span>
                        <span>@(recipe.IsPublic ? "Public" : "Private")</span>
                        <span>Approved</span>
                    </div>
                </a>
            }
        </div>
    </section>

</div>

@code {
    [CascadingParameter]
    private AppRole CurrentRole { get; set; } = AppRole.Admin;

    private bool IsAdmin => CurrentRole == AppRole.Admin;

    private List<RecipeDto> Recipes { get; set; } = [];

    private static readonly IReadOnlyList<RecipeHomeCategory> AvailableCategories =
    [
        new("breakfast", "Breakfast", "Morning recipes and breakfast meal components."),
        new("appetizer", "Appetizers", "Optional starters and small menu items."),
        new("entree", "Entrees", "Main dishes, proteins, and plant-based entrees."),
        new("side", "Sides", "Prepared side dishes and supporting meal items."),
        new("grain", "Grains", "Whole grains, rolls, rice, pasta, and cereal items."),
        new("vegetable", "Vegetables", "Starchy and non-starchy vegetable recipes."),
        new("fruit", "Fruit", "Fresh, frozen, canned, and prepared fruit items."),
        new("milk", "Milk / Yogurt", "Dairy milk, yogurt, and approved equivalents."),
        new("dairy-free", "Dairy-Free", "Non-dairy equivalents and dairy-free recipes."),
        new("condiments", "Condiments", "Optional sauces, dressings, and condiments."),
        new("juice", "Juice / Dessert", "Optional juice and dessert items."),
        new("plant-based", "Plant-Based", "Plant-based entrees, features, and proteins.")
    ];

    private HashSet<string> SelectedCategoryKeys { get; } = new(StringComparer.OrdinalIgnoreCase)
    {
        "breakfast", "entree", "side", "grain", "vegetable", "fruit", "milk", "plant-based"
    };

    private List<RecipeHomeCategory> CustomCategories { get; } = [];
    private string NewCategoryLabel { get; set; } = string.Empty;
    private string NewCategoryDescription { get; set; } = string.Empty;
    private string? CategoryMessage { get; set; }

    private IEnumerable<RecipeHomeCategory> AllCategories => AvailableCategories
        .Concat(CustomCategories)
        .GroupBy(category => category.Key, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First());

    private IEnumerable<RecipeHomeCategory> DisplayedCategories =>
        AllCategories.Where(category => SelectedCategoryKeys.Contains(category.Key));

    private static string CategoryHref(RecipeHomeCategory category) => category.Key switch
    {
        "breakfast" => "/recipes?meal=breakfast",
        "appetizer" => $"/recipes?legacy={Uri.EscapeDataString("Appetizer")}",
        "dairy-free" => $"/recipes?legacy={Uri.EscapeDataString("Dairy-Free")}",
        "condiments" => $"/recipes?legacy={Uri.EscapeDataString("Condiments")}",
        "juice" => $"/recipes?legacy={Uri.EscapeDataString("Juice or Dessert")}",
        "plant-based" => $"/recipes?legacy={Uri.EscapeDataString("Plant-Based Entree")}",
        _ => $"/recipes?category={Uri.EscapeDataString(category.Key)}"
    };

    private async Task SetCategoryVisible(string key, ChangeEventArgs args)
    {
        var selected = args.Value is true || args.Value?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true;
        if (selected)
        {
            SelectedCategoryKeys.Add(key);
        }
        else
        {
            SelectedCategoryKeys.Remove(key);
        }

        var category = AllCategories.FirstOrDefault(category => category.Key.Equals(key, StringComparison.OrdinalIgnoreCase));
        await Api.UpdateRecipeHomeCategorySettingAsync(key, selected, category?.Label, category?.Description);
    }

    private async Task AddCategory()
    {
        var label = NewCategoryLabel.Trim();
        if (string.IsNullOrWhiteSpace(label))
        {
            return;
        }

        var key = Slugify(label);
        if (AllCategories.Any(category => category.Key.Equals(key, StringComparison.OrdinalIgnoreCase)))
        {
            CategoryMessage = $"{label} is already available.";
            return;
        }

        var description = string.IsNullOrWhiteSpace(NewCategoryDescription)
            ? $"Approved {label.ToLowerInvariant()} recipes."
            : NewCategoryDescription.Trim();
        CustomCategories.Add(new RecipeHomeCategory(key, label, description));
        SelectedCategoryKeys.Add(key);
        await Api.UpdateRecipeHomeCategorySettingAsync(key, true, label, description);
        NewCategoryLabel = string.Empty;
        NewCategoryDescription = string.Empty;
        CategoryMessage = $"Added {label}.";
    }

    private IEnumerable<RecipeDto> FeaturedRecipes => Recipes
        .Where(recipe => recipe.IsApproved && !recipe.IsDead && (IsAdmin || recipe.IsPublic))
        .OrderByDescending(recipe => recipe.IsFavorite)
        .ThenBy(recipe => recipe.RecipeName)
        .Take(8);

    private int PendingReviewCount => Recipes.Count(recipe => !recipe.IsApproved && !recipe.IsDead);

    protected override async Task OnInitializedAsync()
    {
        Recipes = await Api.GetRecipesAsync();
        var settings = await Api.GetRecipeHomeCategorySettingsAsync();
        if (settings.Any())
        {
            SelectedCategoryKeys.Clear();
            foreach (var setting in settings.Where(setting => setting.IsVisible))
            {
                SelectedCategoryKeys.Add(setting.CategoryKey);
            }
            foreach (var setting in settings.Where(setting => !string.IsNullOrWhiteSpace(setting.DisplayLabel)))
            {
                if (AvailableCategories.Any(category => category.Key.Equals(setting.CategoryKey, StringComparison.OrdinalIgnoreCase)))
                {
                    continue;
                }

                CustomCategories.Add(new RecipeHomeCategory(
                    setting.CategoryKey,
                    setting.DisplayLabel!,
                    setting.Description ?? $"Approved {setting.DisplayLabel!.ToLowerInvariant()} recipes."));
            }
        }
    }

    private static string Slugify(string value)
    {
        var characters = value.ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray();
        return string.Join('-', new string(characters).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    private static string DisplayCategory(string value) => value switch
    {
        "entree" => "Entrée",
        "grain" => "Grains",
        "milk" => "Milk/Yogurt",
        "vegetable" => "Vegetable",
        "fruit" => "Fruit",
        "appetizer" => "Appetizer",
        "condiment" => "Condiments",
        _ => string.IsNullOrWhiteSpace(value) ? "Recipe" : char.ToUpperInvariant(value[0]) + value[1..]
    };

    private static string DisplayMealType(string value) => value switch
    {
        "breakfast" => "Breakfast",
        "lunch" => "Lunch",
        "dinner" => "Dinner",
        "snack" => "Snack",
        _ => string.IsNullOrWhiteSpace(value) ? "Meal" : char.ToUpperInvariant(value[0]) + value[1..]
    };

    private sealed record RecipeHomeCategory(string Key, string Label, string Description);
}
