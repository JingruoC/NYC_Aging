@page "/reports/print-queue"
@inject PrintQueueService Queue
@inject IJSRuntime Js
@implements IDisposable

<div class="grid print-queue-page" style="gap: 18px">
    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Reports</div>
                <h2 style="margin-bottom: 6px">Print queue</h2>
                <p class="muted" style="margin: 0">Collect recipes, menus, reports, and uploaded resource files, then print the queued documents.</p>
            </div>
            <div class="hero-actions no-print">
                <span class="status-badge">@Queue.Items.Count item@(Queue.Items.Count == 1 ? "" : "s")</span>
                <button type="button" class="button" @onclick="PrintQueuedItems" disabled="@(!Queue.Items.Any())">Print all items</button>
                <button type="button" class="secondary-button" @onclick="ClearQueue" disabled="@(!Queue.Items.Any())">Clear queue</button>
            </div>
        </div>
    </section>

    <section class="section">
        @if (!Queue.Items.Any())
        {
            <div class="empty-state">The print queue is empty. Add an item from a recipe, saved menu, sample menu, or resource list.</div>
        }
        else
        {
            <div class="print-queue-list">
                @foreach (var item in Queue.Items.OrderBy(item => item.AddedAt))
                {
                    <article class="print-queue-item">
                        <div>
                            <span class="status-badge brand">@item.ContentType</span>
                            <h3>@item.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(item.Detail))
                            {
                                <p class="muted">@item.Detail</p>
                            }
                            <span class="muted small">Added @item.AddedAt.ToString("MMM d, yyyy h:mm tt")</span>
                        </div>
                        <div class="hero-actions no-print">
                            <button type="button" class="button" @onclick="() => PrintItem(item)">Print</button>
                            <a class="secondary-button" href="@item.Url">Open</a>
                            <button type="button" class="ghost-button" @onclick="() => Queue.Remove(item.Id)">Remove</button>
                        </div>
                    </article>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="empty-state no-print" style="margin-top: 14px; text-align: left">@Message</div>
        }
    </section>
</div>

@code {
    protected override void OnInitialized() => Queue.Changed += HandleQueueChanged;

    private void HandleQueueChanged() => InvokeAsync(StateHasChanged);

    private string? Message { get; set; }

    private async Task PrintQueuedItems()
    {
        var urls = Queue.Items.OrderBy(item => item.AddedAt).Select(item => item.Url).ToArray();
        try
        {
            var opened = await Js.InvokeAsync<int>("simpleServings.printUrls", (object)urls);
            Message = opened == urls.Length
                ? $"Opened {opened} queued document{(opened == 1 ? "" : "s")} for printing."
                : $"Opened {opened} of {urls.Length} documents. Allow pop-ups for this site, then try the remaining items individually.";
        }
        catch (JSException)
        {
            Message = "Printing could not start. Refresh this page and allow pop-ups for this site, then try again.";
        }
    }

    private async Task PrintItem(PrintQueueItem item)
    {
        try
        {
            var opened = await Js.InvokeAsync<bool>("simpleServings.printUrl", item.Url);
            Message = opened
                ? $"Opened {item.Title} for printing."
                : $"The browser blocked {item.Title}. Allow pop-ups for this site and try again.";
        }
        catch (JSException)
        {
            Message = $"{item.Title} could not be opened for printing. Refresh this page and try again.";
        }
    }

    private void ClearQueue()
    {
        Queue.Clear();
        Message = null;
    }

    public void Dispose() => Queue.Changed -= HandleQueueChanged;
}
