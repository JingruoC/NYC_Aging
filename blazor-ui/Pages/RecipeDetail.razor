@page "/recipes/{RecipeId:int}"
@page "/recipes/{RecipeId:int}/edit"
@inject PythonApiClient Api
@inject NavigationManager Navigation
@inject AppModeService AppMode
@inject IJSRuntime Js
@inject PrintQueueService PrintQueue

<div class="grid" style="gap: 18px">
    <section class="section">
        <div class="section-header">
            <div>
                <div class="eyebrow">Recipe detail</div>
                <h2 style="margin-bottom: 6px">@((IsEditing ? "Edit recipe" : "View recipe"))</h2>
                <p class="muted" style="margin: 0">Recipe record, ingredients, scaling, tags, and nutrition values.</p>
            </div>
            <div class="hero-actions">
                <a class="ghost-button" href="/recipes">Back to recipes</a>
                @if (!IsEditing)
                {
                    <button type="button" class="ghost-button" @onclick="PrintRecipe">Print Recipe</button>
                    <button type="button" class="ghost-button" @onclick="AddRecipeToPrintQueue">Add to print queue</button>
                    <button type="button" class="ghost-button" @onclick="ToggleFavorite">@(_editRecipe.IsFavorite ? "Remove from my favorite" : "Add to my favorite")</button>
                    @if (IsAdmin)
                    {
                        <button type="button" class="secondary-button" @onclick="ArchiveRecipe">Archive</button>
                        <a class="button" href="@($"/recipes/{RecipeId}/edit")">Edit recipe</a>
                    }
                }
                else
                {
                    <button type="button" class="button" @onclick="SaveRecipe">Save changes</button>
                }
            </div>
        </div>

        @if (_loading)
        {
            <div class="empty-state">Loading recipe...</div>
        }
        else if (_recipe is null)
        {
            <div class="empty-state">Recipe not found.</div>
        }
        else if (!IsAdmin && (!_recipe.IsPublic || !_recipe.IsApproved || _recipe.IsDead))
        {
            <div class="empty-state">This recipe is not available in the provider catalog.</div>
        }
        else
        {
            <div class="workspace-summary" style="margin-top: 16px">
                <div class="workspace-summary-item">
                    <div class="small muted">Recipe ID</div>
                    <div class="summary-value">#@_recipe.RecipeId</div>
                </div>
                <div class="workspace-summary-item">
                    <div class="small muted">Meal type</div>
                    <div class="summary-value">@_recipe.MealType</div>
                </div>
                <div class="workspace-summary-item">
                    <div class="small muted">Category</div>
                    <div class="summary-value">@_recipe.Category</div>
                </div>
                <div class="workspace-summary-item">
                    <div class="small muted">Approval</div>
                    <div class="summary-value">@ApprovalLabel(_recipe)</div>
                </div>
            </div>

            <div class="columns cols-2" style="margin-top: 16px">
                <section class="section">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">@(_recipe.RecipeName)</h3>
                        </div>
                    </div>

                    <div class="status-stack">
                        <div class="status-row">
                            <span>Yield</span>
                            <span>@_recipe.YieldServings</span>
                        </div>
                        <div class="status-row">
                            <span>Serving size</span>
                            <span>@(_recipe.ServingSize ?? "1 serving")</span>
                        </div>
                        <div class="status-row">
                            <span>Portion size</span>
                            <span>@(_recipe.ServingSize ?? "1 serving")</span>
                        </div>
                        <div class="status-row">
                            <span>Recipe view</span>
                            <span>@(_recipe.IsPublic ? "Public" : "Sponsor Private")</span>
                        </div>
                        <div class="status-row">
                            <span>Approval</span>
                            <span class="status-badge @(_recipe.IsApproved ? "good" : "warn")">@ApprovalLabel(_recipe)</span>
                        </div>
                        <div class="status-row">
                            <span>Approval status</span>
                            <span>@ApprovalLabel(_recipe)</span>
                        </div>
                        <div class="status-row">
                            <span>Meal type</span>
                            <span class="status-badge brand">@_recipe.MealType</span>
                        </div>
                        <div class="status-row">
                            <span>Category</span>
                            <span class="status-badge brand">@_recipe.Category</span>
                        </div>
                        <div class="status-row">
                            <span>Last updated by</span>
                            <span>@(_recipe.ContributedBy ?? "NYC Aging Nutrition Unit")</span>
                        </div>
                        <div class="status-row">
                            <span>Last updated on</span>
                            <span>@_recipe.CreatedOn?.ToString("MM/dd/yyyy")</span>
                        </div>
                        <div class="status-row">
                            <span>Contributed by</span>
                            <span>@(_recipe.ContributedBy ?? "N/A")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_actionMessage))
                    {
                        <div class="empty-state" style="padding: 10px 12px; margin-top: 12px">@_actionMessage</div>
                    }

                    @if (IsAdmin)
                    {
                    <div class="section" style="margin-top: 16px">
                        <div class="section-header">
                            <div>
                                <h3 style="margin-bottom: 6px">Recipe fields</h3>
                                <p class="muted" style="margin: 0">These are editable so staff can correct the recipe record without leaving the catalog.</p>
                            </div>
                        </div>

                        <div class="planner-form-grid">
                            <div>
                                <div class="small muted">Recipe name</div>
                                <InputText class="input" @bind-Value="_editRecipe.RecipeName" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Meal type</div>
                                <InputText class="input" @bind-Value="_editRecipe.MealType" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Category</div>
                                <InputText class="input" @bind-Value="_editRecipe.Category" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Recipe contributor</div>
                                <InputText class="input" @bind-Value="_editRecipe.ContributedBy" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Approved</div>
                                <InputCheckbox class="input" @bind-Value="_editRecipe.IsApproved" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Calories</div>
                                <InputNumber class="input" @bind-Value="_editRecipe.Calories" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Sodium mg</div>
                                <InputNumber class="input" @bind-Value="_editRecipe.SodiumMg" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Protein g</div>
                                <InputNumber class="input" @bind-Value="_editRecipe.ProteinG" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Fiber g</div>
                                <InputNumber class="input" @bind-Value="_editRecipe.FiberG" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Fat g</div>
                                <InputNumber class="input" @bind-Value="_editRecipe.FatG" disabled="@(!IsEditing)" />
                            </div>
                            <div style="grid-column: 1 / -1">
                                <div class="small muted">Tags, comma separated</div>
                                <InputText class="input" @bind-Value="_tagsText" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Serving size</div>
                                <InputText class="input" @bind-Value="_editRecipe.ServingSize" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Yield servings</div>
                                <InputNumber class="input" @bind-Value="_editRecipe.YieldServings" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Favorite</div>
                                <InputCheckbox class="input" @bind-Value="_editRecipe.IsFavorite" disabled="@(!IsEditing)" />
                            </div>
                            <div>
                                <div class="small muted">Public</div>
                                <InputCheckbox class="input" @bind-Value="_editRecipe.IsPublic" disabled="@(!IsEditing)" />
                            </div>
                            <div style="grid-column: 1 / -1">
                                <div class="small muted">Ingredients, comma separated</div>
                                <InputText class="input" @bind-Value="_ingredientsText" disabled="@(!IsEditing)" />
                            </div>
                            <div style="grid-column: 1 / -1">
                                <div class="small muted">Nutrient claims, comma separated</div>
                                <InputText class="input" @bind-Value="_claimsText" disabled="@(!IsEditing)" />
                            </div>
                        </div>
                    </div>
                    }
                </section>

                <section class="section">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">Nutrition snapshot</h3>
                        </div>
                    </div>

                    <div class="workspace-summary">
                        <div class="workspace-summary-item">
                            <div class="small muted">Calories</div>
                            <div class="summary-value">@_editRecipe.Calories</div>
                        </div>
                        <div class="workspace-summary-item">
                            <div class="small muted">Sodium</div>
                            <div class="summary-value">@_editRecipe.SodiumMg mg</div>
                        </div>
                        <div class="workspace-summary-item">
                            <div class="small muted">Protein</div>
                            <div class="summary-value">@_editRecipe.ProteinG g</div>
                        </div>
                        <div class="workspace-summary-item">
                            <div class="small muted">Fiber</div>
                            <div class="summary-value">@_editRecipe.FiberG g</div>
                        </div>
                        <div class="workspace-summary-item">
                            <div class="small muted">Fat</div>
                            <div class="summary-value">@_editRecipe.FatG g</div>
                        </div>
                    </div>

                    <div class="section" style="margin-top: 16px">
                        <div class="section-header">
                            <div>
                                <h3 style="margin-bottom: 6px">Scale to serving(s)</h3>
                                <p class="muted" style="margin: 0">@(_recipe.ScaleNote ?? "Enter the serving count used by production.")</p>
                            </div>
                        </div>
                        <div class="report-form compact-form">
                            <label>
                                <div class="small muted">Serving count</div>
                                <input type="number" class="input" min="1" @bind="_scaleServings" @bind:event="oninput" />
                            </label>
                            <button type="button" class="button" @onclick="ScaleRecipe">Go</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_scaleMessage))
                        {
                            <div class="empty-state" style="padding: 10px 12px; margin-top: 10px">@_scaleMessage</div>
                        }
                        @if (_scaledIngredients.Any())
                        {
                            <div class="table-list" style="margin-top: 12px">
                                @foreach (var ingredient in _scaledIngredients)
                                {
                                    <div class="table-row compact-row">
                                        <div class="table-main">@ingredient</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="section" style="margin-top: 16px">
                        <div class="section-header">
                            <div>
                                <h3 style="margin-bottom: 6px">Ingredients</h3>
                            </div>
                        </div>
                        <ul class="plain-list">
                            @foreach (var ingredient in _recipe.Ingredients)
                            {
                                <li>@ingredient</li>
                            }
                        </ul>
                    </div>

                    <div class="section" style="margin-top: 16px">
                        <div class="section-header">
                            <div>
                                <h3 style="margin-bottom: 6px">Preparation</h3>
                            </div>
                        </div>
                        <ol class="plain-list">
                            @foreach (var step in _recipe.Instructions)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </div>

                    <div class="section" style="margin-top: 16px">
                        <div class="section-header">
                            <div>
                                <h3 style="margin-bottom: 6px">Tags and nutrient claims</h3>
                            </div>
                        </div>
                        <div class="tag-list">
                            @foreach (var tag in _recipe.Tags.Concat(_recipe.NutrientClaims).Distinct())
                            {
                                <span class="tag-chip">@tag</span>
                            }
                        </div>
                    </div>

                    <div class="section nutrition-analysis-section" style="margin-top: 16px">
                        <div class="section-header">
                            <div>
                                <h3 style="margin-bottom: 6px">Full nutrient analysis</h3>
                                <p class="muted" style="margin: 0">FDA-style label for @(_recipe.ServingSize ?? "1 serving"). Values reflect the stored Nutritionist Pro analysis.</p>
                            </div>
                            @if (IsAdmin)
                            {
                                <a class="quiet-action" href="@($"/downloads/recipes/{RecipeId}/exports/nutrition")">Export to Excel</a>
                            }
                        </div>
                        <div class="nutrition-facts-label fda-label">
                            <div class="facts-title">Nutrition Facts</div>
                            <div class="facts-serving">@_recipe.YieldServings servings per recipe</div>
                            <div class="facts-serving"><strong>Serving size</strong><strong>@(_recipe.ServingSize ?? "1 serving")</strong></div>
                            <div class="facts-calories-label">Amount per serving</div>
                            <div class="facts-calories"><span>Calories</span><strong>@_editRecipe.Calories</strong></div>
                            <div class="facts-daily-value">% Daily Value*</div>
                            @foreach (var row in NutritionFactRows)
                            {
                                <div class="facts-row @(row.Indent ? "facts-indent" : "")">
                                    <span>@row.Label</span>
                                    <span>@row.Value @if (!string.IsNullOrWhiteSpace(row.DailyValue)) { <strong>@row.DailyValue</strong> }</span>
                                </div>
                            }
                            <div class="facts-footnote">* The % Daily Value tells you how much a nutrient in a serving contributes to a daily diet.</div>
                        </div>
                    </div>
                </section>
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private AppRole CurrentRole { get; set; } = AppRole.Admin;

    private bool IsAdmin => CurrentRole == AppRole.Admin;

    [Parameter] public int RecipeId { get; set; }

    private bool IsEditRoute => Navigation.Uri.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);
    private bool IsEditing => IsAdmin && IsEditRoute;
    private bool _loading = true;
    private RecipeDto? _recipe;
    private RecipeDto _editRecipe = new();
    private string _tagsText = string.Empty;
    private string _ingredientsText = string.Empty;
    private string _claimsText = string.Empty;
    private int _scaleServings = 50;
    private string? _scaleMessage;
    private string? _actionMessage;
    private List<string> _scaledIngredients = [];

    private static string ApprovalLabel(RecipeDto recipe) => recipe.IsApproved ? "Approved" : "Pending review";

    private IReadOnlyList<(string Label, string Value, bool Indent, string DailyValue)> NutritionFactRows =>
    [
        ("Total Fat", $"{_editRecipe.FatG:0.##} g", false, DailyValue(_editRecipe.FatG, 78)),
        ("Saturated Fat", $"{_editRecipe.SaturatedFatG:0.##} g", true, DailyValue(_editRecipe.SaturatedFatG, 20)),
        ("Trans Fat", $"{_editRecipe.TransFatG:0.##} g", true, string.Empty),
        ("Cholesterol", $"{_editRecipe.CholesterolMg:0.##} mg", false, DailyValue(_editRecipe.CholesterolMg, 300)),
        ("Sodium", $"{_editRecipe.SodiumMg:0.##} mg", false, DailyValue(_editRecipe.SodiumMg, 2300)),
        ("Total Carbohydrate", $"{_editRecipe.CarbohydratesG:0.##} g", false, DailyValue(_editRecipe.CarbohydratesG, 275)),
        ("Dietary Fiber", $"{_editRecipe.FiberG:0.##} g", true, DailyValue(_editRecipe.FiberG, 28)),
        ("Total Sugars", $"{_editRecipe.TotalSugarsG:0.##} g", true, string.Empty),
        ("Includes Added Sugars", $"{_editRecipe.AddedSugarsG:0.##} g", true, DailyValue(_editRecipe.AddedSugarsG, 50)),
        ("Protein", $"{_editRecipe.ProteinG:0.##} g", false, string.Empty),
        ("Vitamin D", $"{_editRecipe.VitaminDMcg:0.##} mcg", false, DailyValue(_editRecipe.VitaminDMcg, 20)),
        ("Calcium", $"{_editRecipe.CalciumMg:0.##} mg", false, DailyValue(_editRecipe.CalciumMg, 1300)),
        ("Iron", $"{_editRecipe.IronMg:0.##} mg", false, DailyValue(_editRecipe.IronMg, 18)),
        ("Potassium", $"{_editRecipe.PotassiumMg:0.##} mg", false, DailyValue(_editRecipe.PotassiumMg, 4700)),
        ("Vitamin C", $"{_editRecipe.VitaminCMg:0.##} mg", false, DailyValue(_editRecipe.VitaminCMg, 90))
    ];

    private static string DailyValue(decimal amount, decimal dailyValue) =>
        $"{Math.Round(amount / dailyValue * 100, MidpointRounding.AwayFromZero):0}%";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _recipe = await Api.GetRecipeAsync(RecipeId);
        if (_recipe is not null)
        {
            _editRecipe = CloneRecipe(_recipe);
            _tagsText = string.Join(", ", _editRecipe.Tags);
            _ingredientsText = string.Join(", ", _editRecipe.Ingredients);
            _claimsText = string.Join(", ", _editRecipe.NutrientClaims);
            _scaleServings = _editRecipe.YieldServings;
        }
        _loading = false;
    }

    private async Task SaveRecipe()
    {
        if (!IsAdmin || _recipe is null)
        {
            return;
        }

        _editRecipe.Tags = _tagsText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        _editRecipe.Ingredients = _ingredientsText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        _editRecipe.NutrientClaims = _claimsText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        _recipe = await Api.UpdateRecipeAsync(RecipeId, _editRecipe);
        _editRecipe = CloneRecipe(_recipe);
        _tagsText = string.Join(", ", _editRecipe.Tags);
        _ingredientsText = string.Join(", ", _editRecipe.Ingredients);
        _claimsText = string.Join(", ", _editRecipe.NutrientClaims);
        Navigation.NavigateTo($"/recipes/{RecipeId}");
    }

    private void ScaleRecipe()
    {
        if (_recipe is null)
        {
            return;
        }

        var factor = _recipe.YieldServings == 0 ? 1 : (decimal)_scaleServings / _recipe.YieldServings;
        var scaledCount = 0;
        _scaledIngredients = _recipe.Ingredients.Select(ingredient =>
        {
            var scaled = ScaleIngredient(ingredient, factor, out var quantityScaled);
            if (quantityScaled) scaledCount++;
            return scaled;
        }).ToList();
        _scaleMessage = scaledCount == 0
            ? $"Batch set to {_scaleServings} servings. The stored ingredient lines do not include numeric quantities, so no amounts were changed."
            : $"Scaled {scaledCount} ingredient amount{(scaledCount == 1 ? "" : "s")} from {_recipe.YieldServings} to {_scaleServings} servings.";
    }

    private async Task ToggleFavorite()
    {
        if (_recipe is null)
        {
            return;
        }

        _editRecipe.IsFavorite = !_editRecipe.IsFavorite;
        _recipe = await Api.UpdateRecipeAsync(RecipeId, _editRecipe);
        _editRecipe = CloneRecipe(_recipe);
        _actionMessage = _editRecipe.IsFavorite ? "Recipe added to my favorite." : "Recipe removed from my favorite.";
    }

    private async Task PrintRecipe()
    {
        await Js.InvokeVoidAsync("window.print");
    }

    private void AddRecipeToPrintQueue()
    {
        if (_recipe is null)
        {
            return;
        }

        var added = PrintQueue.Add("Recipe", _recipe.RecipeName, $"/recipes/{_recipe.RecipeId}", $"{_recipe.MealType} · {_recipe.Category}");
        _actionMessage = added ? "Recipe added to the print queue." : "Recipe is already in the print queue.";
    }

    private async Task ArchiveRecipe()
    {
        if (!IsAdmin)
        {
            return;
        }

        _editRecipe.IsDead = true;
        _recipe = await Api.UpdateRecipeAsync(RecipeId, _editRecipe);
        _actionMessage = "Recipe archived. It is hidden from the active catalog but remains in the record history.";
    }

    private static string ScaleIngredient(string ingredient, decimal factor, out bool quantityScaled)
    {
        quantityScaled = false;
        var match = System.Text.RegularExpressions.Regex.Match(ingredient, @"^\s*(\d+\s+\d+\/\d+|\d+(?:\.\d+)?|\d+\/\d+)\s+(.*)$");
        if (!match.Success)
        {
            return ingredient;
        }

        var quantityText = match.Groups[1].Value;
        decimal quantity = 0;
        if (quantityText.Contains(' ') && quantityText.Contains('/'))
        {
            var mixed = quantityText.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var parts = mixed[1].Split('/');
            quantity = decimal.Parse(mixed[0]) + decimal.Parse(parts[0]) / decimal.Parse(parts[1]);
        }
        else if (quantityText.Contains('/'))
        {
            var parts = quantityText.Split('/');
            quantity = decimal.Parse(parts[0]) / decimal.Parse(parts[1]);
        }
        else if (!decimal.TryParse(quantityText, out quantity))
        {
            return ingredient;
        }

        quantityScaled = true;
        return $"{quantity * factor:0.##} {match.Groups[2].Value}";
    }

    private static RecipeDto CloneRecipe(RecipeDto recipe) =>
        new()
        {
            RecipeId = recipe.RecipeId,
            RecipeName = recipe.RecipeName,
            MealType = recipe.MealType,
            Category = recipe.Category,
            Calories = recipe.Calories,
            SodiumMg = recipe.SodiumMg,
            ProteinG = recipe.ProteinG,
            FiberG = recipe.FiberG,
            FatG = recipe.FatG,
            Tags = [.. recipe.Tags],
            IsApproved = recipe.IsApproved,
            Ingredients = [.. recipe.Ingredients],
            Instructions = [.. recipe.Instructions],
            ServingSize = recipe.ServingSize,
            YieldServings = recipe.YieldServings,
            ScaleNote = recipe.ScaleNote,
            ContributedBy = recipe.ContributedBy,
            CreatedOn = recipe.CreatedOn,
            IsPublic = recipe.IsPublic,
            IsFavorite = recipe.IsFavorite,
            IsDead = recipe.IsDead,
            NutrientClaims = [.. recipe.NutrientClaims],
            VitaminCMg = recipe.VitaminCMg,
            CalciumMg = recipe.CalciumMg,
            SaturatedFatG = recipe.SaturatedFatG,
            TransFatG = recipe.TransFatG,
            CholesterolMg = recipe.CholesterolMg,
            CarbohydratesG = recipe.CarbohydratesG,
            TotalSugarsG = recipe.TotalSugarsG,
            AddedSugarsG = recipe.AddedSugarsG,
            VitaminDMcg = recipe.VitaminDMcg,
            IronMg = recipe.IronMg,
            PotassiumMg = recipe.PotassiumMg
        };
}
