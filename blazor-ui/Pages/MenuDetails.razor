    private int OpenCommentCount => VisibleReviewComments.Count(comment => !comment.ReviewStatus.Equals("resolved", StringComparison.OrdinalIgnoreCase));
    private int GeneralCommentCount => VisibleReviewComments.Count(comment => TargetKey(comment) == TargetKey(GeneralMenuTarget));
    private int CorrectionCommentCount => VisibleReviewComments.Count(comment => comment.Action.Contains("Correction", StringComparison.OrdinalIgnoreCase));
    private int AnchoredCommentCount => VisibleReviewComments.Count(comment => TargetKey(comment) != TargetKey(GeneralMenuTarget));
    private int SentReviewCount => RoleVisibleReviewComments.Count(comment => comment.Action.Equals(ReviewSentAction, StringComparison.OrdinalIgnoreCase));
    private string ReviewBoardTitle => ReviewMealScope == AllMealsScope ? "All meals review board" : $"{ReviewScopeLabel(ReviewMealScope)} review board";
    private IEnumerable<ReviewScopeOption> ReviewMealScopes
    {
        get
        {
            var scopes = new List<ReviewScopeOption> { new(AllMealsScope, "All meals") };
            var mealKeys = Menu?.Menu.Items
                .Select(item => MealKeyFromSlot(item.MealSlot, Menu.Menu.MealType))
                .Where(key => !string.IsNullOrWhiteSpace(key))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(MealSortOrder)
                .ToList() ?? [];

            foreach (var key in mealKeys)
            {
                scopes.Add(new ReviewScopeOption(key, ReviewScopeLabel(key)));
            }

            return scopes;
        }
    }
    private IEnumerable<MenuItemDetailDto> ScopedReviewItems => Menu?.Menu.Items
        .Where(item => ReviewMealScope == AllMealsScope || MealKeyFromSlot(item.MealSlot, Menu.Menu.MealType).Equals(ReviewMealScope, StringComparison.OrdinalIgnoreCase))
        ?? [];
    private IEnumerable<MealComparisonRow> MealComparisonRows => (Menu?.Menu.Items ?? [])
        .GroupBy(item => MealKeyFromSlot(item.MealSlot, Menu?.Menu.MealType))
        .Where(group => !string.IsNullOrWhiteSpace(group.Key))
        .OrderBy(group => MealSortOrder(group.Key))
        .Select(group => new MealComparisonRow(
            ReviewScopeLabel(group.Key),
            group.Count(),
            group.Sum(item => item.Recipe.Calories),
            group.Sum(item => item.Recipe.SodiumMg),
            group.Select(item => NormalizeCommentComponentKey(item.ComponentKey ?? ExtractComponentFromMealSlot(item.MealSlot) ?? item.Recipe.Category)).Distinct(StringComparer.OrdinalIgnoreCase).Count()));
    private IEnumerable<ReviewAttentionItem> ReviewAttentionItems => BuildReviewAttentionItems();
    private IEnumerable<ReviewPerspectiveOption> ReviewPerspectiveOptions =>
    [
        new(ThisMenuPerspective, "This menu only"),
        new(SameProviderPerspective, "Same provider"),
        new(SameProviderCyclePerspective, "Same provider + cycle week"),
        new(SameProviderMealPerspective, "Same provider + meal type"),
        new(SameProviderNeedsReviewPerspective, "Same provider + needs review")
    ];
    private string ReviewPerspectiveLabel => ReviewPerspectiveOptions.FirstOrDefault(option => option.Key == ReviewPerspective)?.Label ?? "Same provider";
    private string ReviewProviderName => Menu?.Menu.ContractName
        ?? Menu?.Menu.Contracts.FirstOrDefault()
        ?? "Current provider";
    private IEnumerable<MenuSummaryDto> ReviewQueueMenus => AllMenus
        .Where(menu => IsAdmin && MatchesReviewProvider(menu))
        .Where(menu => ReviewPerspective switch
        {
            ThisMenuPerspective => menu.Id == MenuId,
            SameProviderCyclePerspective => menu.CycleWeek == Menu?.Menu.CycleWeek,
            SameProviderMealPerspective => (menu.MealType ?? string.Empty).Equals(Menu?.Menu.MealType ?? string.Empty, StringComparison.OrdinalIgnoreCase),
            SameProviderNeedsReviewPerspective => HasReviewWork(menu),
            _ => true
        })
        .OrderBy(menu => menu.Id == MenuId ? 0 : 1)
        .ThenBy(menu => menu.CycleWeek)
        .ThenBy(menu => menu.StartDate ?? menu.ServiceDate)
        .ThenBy(menu => menu.MealType);
    private IEnumerable<LegacyMealComponent> ReviewBoardComponents
    {
        get
        {
            if (Menu is null)
            {
                return [];
            }

            var componentKeys = ScopedReviewItems
                .Select(item => NormalizeCommentComponentKey(item.ComponentKey ?? ExtractComponentFromMealSlot(item.MealSlot) ?? item.Recipe.Category))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return LegacyReferenceData.MealComponents
                .Where(component => componentKeys.Contains(component.Key))
                .DefaultIfEmpty(LegacyReferenceData.MealComponents.First(component => component.Key == "entree"));
        }
    }

    private IEnumerable<string> CurrentProviderNames =>
        (Menu?.Menu.Contracts ?? [])
            .Concat(string.IsNullOrWhiteSpace(Menu?.Menu.ContractName) ? Array.Empty<string>() : new[] { Menu!.Menu.ContractName! })
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private bool MatchesReviewProvider(MenuSummaryDto menu)
    {
        var providerNames = CurrentProviderNames.ToList();
        if (providerNames.Count == 0)
        {
            return menu.Id == MenuId;
        }

        return providerNames.Any(provider =>
            (menu.ContractName ?? string.Empty).Equals(provider, StringComparison.OrdinalIgnoreCase)
            || menu.Contracts.Any(contract => contract.Equals(provider, StringComparison.OrdinalIgnoreCase)));
    }

    private static bool HasReviewWork(MenuSummaryDto menu) =>
        menu.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase)
        || menu.Status.Contains("Reviewed", StringComparison.OrdinalIgnoreCase)
        || menu.Status.Contains("Returned", StringComparison.OrdinalIgnoreCase)
        || menu.Status.Contains("Resubmitted", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(menu.ReturnedComments)
        || !string.IsNullOrWhiteSpace(menu.ApprovalNotes);

    private static bool HasReviewComments(MenuSummaryDto menu) =>
        !string.IsNullOrWhiteSpace(menu.ReturnedComments)
        || !string.IsNullOrWhiteSpace(menu.ApprovalNotes);

    private static string ReviewQueueIssueLabel(MenuSummaryDto menu)
    {
        var flags = new List<string>();
        if (HasReviewWork(menu))
        {
            flags.Add("Review work");
        }

        if (HasReviewComments(menu))
        {
            flags.Add("Comments");
        }

        if (menu.Status.Contains("Returned", StringComparison.OrdinalIgnoreCase))
        {
            flags.Add("Returned");
        }

        return flags.Count == 0 ? "No active review flags" : string.Join(" · ", flags.Distinct());
    }

    private static DateTime StartOfServiceWeek(DateTime date)
    {
        var daysSinceMonday = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return date.Date.AddDays(-daysSinceMonday);
    }

    private void GoToMenuBuilder() => Navigation.NavigateTo("/menus/new");

