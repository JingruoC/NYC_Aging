    private void ResetDraftFields()
    {
        if (Menu is null)
        {
            return;
        }

        DraftName = Menu.Menu.Name;
        DraftStartDate = Menu.Menu.StartDate ?? Menu.Menu.ServiceDate;
        DraftDaysPerWeek = Menu.Menu.DaysPerWeek;
        DraftCycleWeek = Menu.Menu.CycleWeek;
    }

    private void ResetDraftItems()
    {
        if (Menu is null)
        {
            return;
        }

        DraftItems = Menu.Menu.Items
            .OrderBy(item => item.DayIndex)
            .ThenBy(item => item.Position)
            .Select(item => new MenuItemDetailDto
            {
                RecipeId = item.RecipeId,
                Position = item.Position,
                DayIndex = item.DayIndex,
                MealSlot = item.MealSlot,
                ComponentKey = item.ComponentKey,
                IsAlternate = item.IsAlternate,
                SourceType = item.SourceType,
                Recipe = item.Recipe
            })
            .ToList();

        NormalizeDraftItemPositions();
    }

    private void RemoveDraftItem(MenuItemDetailDto item)
    {
        DraftItems.Remove(item);
        NormalizeDraftItemPositions();
    }

    private void BeginDragDraftItem(int index)
    {
        DragDraftIndex = index;
    }

    private void EndDragDraftItem()
    {
        DragDraftIndex = null;
        HoverDraftIndex = null;
    }

    private void DropDraftItemAt(int targetIndex)
    {
        if (DragDraftIndex is null)
        {
            return;
        }

        var sourceIndex = DragDraftIndex.Value;
        if (sourceIndex == targetIndex || sourceIndex < 0 || sourceIndex >= DraftItems.Count || targetIndex < 0 || targetIndex >= DraftItems.Count)
        {
            DragDraftIndex = null;
            return;
        }

        var item = DraftItems[sourceIndex];
        DraftItems.RemoveAt(sourceIndex);
        if (sourceIndex < targetIndex)
        {
            targetIndex--;
        }

        DraftItems.Insert(targetIndex, item);
        DragDraftIndex = null;
        HoverDraftIndex = null;
        NormalizeDraftItemPositions();
        _ = PulseDroppedItemAsync(targetIndex);
    }

    private async Task PulseDroppedItemAsync(int index)
    {
        DropDraftPulseIndex = index;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(250);
        if (DropDraftPulseIndex == index)
        {
            DropDraftPulseIndex = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NormalizeDraftItemPositions()
    {
        for (var i = 0; i < DraftItems.Count; i++)
        {
            DraftItems[i].Position = i + 1;
        }
    }

    private string GetMealMixSummary()
    {
        if (Menu is null || Menu.Menu.Items.Count == 0)
        {
            return "No items placed";
        }

        var counts = Menu.Menu.Items
            .GroupBy(item => MealKeyFromSlot(item.MealSlot, Menu.Menu.MealType))
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        var mealParts = new[] { "breakfast", "lunch", "dinner" }
            .Where(meal => counts.GetValueOrDefault(meal) > 0)
            .Select(meal => $"{counts.GetValueOrDefault(meal)} {meal} item{(counts.GetValueOrDefault(meal) == 1 ? "" : "s")}")
            .ToList();

        return mealParts.Count == 0 ? "No meal items placed" : string.Join(", ", mealParts);
    }

    private int GetRepeatedRecipeCount() => Menu?.Menu.Items
        .GroupBy(item => item.RecipeId)
        .Count(group => group.Count() > 1) ?? 0;

    private int GetUniqueRecipeCount() => Menu?.Menu.Items
        .Select(item => item.RecipeId)
        .Distinct()
        .Count() ?? 0;

    private string GetRecipeRepetitionSummary()
    {
        var repeatedRecipes = Menu?.Menu.Items
            .GroupBy(item => item.Recipe.RecipeName)
            .Where(group => group.Count() > 1)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key)
            .ToList() ?? [];

        if (repeatedRecipes.Count == 0)
        {
            return "No recipe used more than once";
        }

        var topRepeat = repeatedRecipes[0];
        var moreCount = repeatedRecipes.Count - 1;
        return moreCount == 0
            ? $"{topRepeat.Key} appears {topRepeat.Count()} times"
            : $"{topRepeat.Key} appears {topRepeat.Count()} times; {moreCount} more repeated";
    }

    private string GetNutritionSummary()
    {
        var warnings = Menu?.Analysis.Statuses.Where(status => status.Status != "pass").Select(status => status.NutrientKey).ToList() ?? [];
        if (warnings.Count == 0)
        {
            return "Passing all nutrition checks";
        }

        return $"Watch: {string.Join(", ", warnings)}";
    }

    private string GetMenuDescriptor()
    {
        if (Menu is null)
        {
            return "—";
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Menu.Menu.ProgramType))
        {
            parts.Add(Menu.Menu.ProgramType!);
        }
        if (!string.IsNullOrWhiteSpace(Menu.Menu.MenuFormat))
        {
            parts.Add(Menu.Menu.MenuFormat!);
        }

        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

