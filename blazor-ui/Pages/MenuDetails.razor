        .ThenBy(comment => comment.CreatedAt);
    private string MenuCommentSummaryText => BuildMenuCommentSummaryText();
    private IEnumerable<MenuReviewCommentDto> AnchoredCommentShortcuts => VisibleReviewComments
        .OrderBy(comment => comment.ReviewStatus.Equals("resolved", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
        .ThenByDescending(comment => comment.CreatedAt);
    private IEnumerable<MenuReviewCommentDto> WorkflowEvents => RoleVisibleReviewComments
        .Where(IsWorkflowEvent)
        .GroupBy(WorkflowStageKey)
