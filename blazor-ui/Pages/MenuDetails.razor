        {
            var copied = await Js.InvokeAsync<bool>("simpleServings.copyText", MenuCommentSummaryText);
            MenuCommentSummaryMessage = copied
                ? "Summary copied."
                : "Copy failed. Select the summary text and copy it manually.";
        }
        catch (JSException)
        {
