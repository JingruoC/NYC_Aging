@page "/menus/{MenuId:int}"
@inject PythonApiClient Api
@inject NavigationManager Navigation
@inject MenuDraftService Drafts
@inject IJSRuntime Js
@inject AppModeService AppMode
@inject PrintQueueService PrintQueue
@implements IAsyncDisposable

<div class="grid" style="gap: 18px" @ref="_pageRoot">
    @if (_accessDenied)
    {
        <section class="section">
            <div class="empty-state">
                <strong>This menu is not available for the selected provider.</strong>
                <div class="muted small" style="margin-top: 6px">Providers can open only their own submitted, returned, approved, or completed menus.</div>
                <a class="secondary-button" style="margin-top: 14px" href="/menus/list">Return to My Menus</a>
            </div>
        </section>
    }
    else if (Menu is null)
    {
        <section class="section">
            <div class="empty-state">Loading menu…</div>
        </section>
    }
    else
    {
        <section class="section">
            <div class="section-header">
                <div>
                    <div class="eyebrow">Saved menu</div>
                    <h3 style="margin-bottom: 6px">@Menu.Menu.Name</h3>
                    <p class="muted" style="margin: 0">
                        @Menu.Menu.StartDate?.ToString("MMM d, yyyy") to @Menu.Menu.EndDate?.ToString("MMM d, yyyy")
                        · Week @Menu.Menu.CycleWeek
                    </p>
                </div>
                <div class="hero-actions menu-detail-actions">
                    <StatusPill Status="@Menu.Analysis.OverallStatus" Label="@Menu.Analysis.OverallStatus" />
                    <button type="button" class="ghost-button compact-action" @onclick="AddMenuToPrintQueue">Add to print queue</button>
                    @if (IsAdmin)
                    {
                        <button type="button" class="@($"{(MenuDetailsTab == CommentsTab ? "button" : "ghost-button")} compact-action")" @onclick="() => SetMenuDetailsTab(CommentsTab)">Review</button>
                        <button type="button" class="@($"{(MenuDetailsTab == ReviewTab ? "button" : "ghost-button")} compact-action")" @onclick="() => SetMenuDetailsTab(ReviewTab)">Summary</button>
                    }
                    else
                    {
                        <button type="button" class="secondary-button compact-action" @onclick="OpenAsDraft">Use as starting point</button>
                        <button type="button" class="@($"{(MenuDetailsTab == CommentsTab ? "button" : "ghost-button")} compact-action")" @onclick="() => SetMenuDetailsTab(CommentsTab)">Comments</button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(MenuActionMessage))
            {
                <div class="empty-state compact-empty" style="margin-top: 12px; text-align: left">@MenuActionMessage</div>
            }
        </section>

        @if (MenuDetailsTab == ReviewTab && IsAdmin)
        {
            <section class="section">
                <h3>Menu information</h3>
                <div class="summary-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 16px">
                    <div class="summary-card">
                        <div class="summary-value">@Menu.Menu.Name</div>
                        <div class="muted small">Menu name</div>
                        <div class="muted small">@Menu.Menu.Status · @Menu.Menu.MenuFormat</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@(Menu.Menu.ContractName ?? "—")</div>
                        <div class="muted small">Contract</div>
                        <div class="muted small">Program @GetMenuDescriptor()</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@Menu.Menu.MealType</div>
                        <div class="muted small">Meal type</div>
                        <div class="muted small">Coverage @(Menu.Menu.MenuCoverage ?? "—") · @Menu.Menu.DaysPerWeek-day cycle</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@Menu.Menu.Status</div>
                        <div class="muted small">Current status</div>
                        <div class="muted small">Status date @Menu.Menu.StatusDate?.ToString("MMM d, yyyy")</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@(Menu.Menu.SubmittedTo ?? "—")</div>
                        <div class="muted small">Submitted to</div>
                        <div class="muted small">Created by @(Menu.Menu.CreatedBy ?? "—")</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@Menu.Menu.ServiceDate.ToString("MMM d")</div>
                        <div class="muted small">Service date</div>
                        <div class="muted small">@Menu.Menu.StartDate?.ToString("MMM d, yyyy") to @Menu.Menu.EndDate?.ToString("MMM d, yyyy")</div>
                    </div>
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <div>
                        <h3 style="margin-bottom: 6px">Review comments</h3>
                        <p class="muted" style="margin: 0">Latest submission comments and status notes for this menu.</p>
                    </div>
                    <button type="button" class="secondary-button" @onclick="() => SetMenuDetailsTab(CommentsTab)">View history</button>
                </div>
                @if (!VisibleReviewComments.Any())
                {
                    <div class="empty-state" style="margin-top: 14px">No review comments have been added to this menu yet.</div>
                }
                else
                {
                    <div class="comment-preview-list">
                        @foreach (var comment in VisibleReviewComments.Take(2))
                        {
                            <div class="status-row">
                                <div>
                                    <strong>@comment.Author</strong>
                                    <div class="muted small">@comment.Body</div>
                                </div>
                                <span class="status-badge @comment.BadgeClass">@comment.Action</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="section">
                <h3>Menu snapshot</h3>
                <div class="summary-grid" style="grid-template-columns: repeat(4, minmax(0, 1fr))">
                    <div class="summary-card">
                        <div class="summary-value">@Menu.Menu.Items.Count</div>
                        <div class="muted small">Items placed</div>
                        <div class="muted small">@GetMealMixSummary()</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@GetRepeatedRecipeCount()</div>
                        <div class="muted small">Repeated recipes</div>
                        <div class="muted small">@GetRecipeRepetitionSummary()</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@GetUniqueRecipeCount()</div>
                        <div class="muted small">Unique recipes</div>
                        <div class="muted small">@Menu.Menu.DaysPerWeek-day cycle · Week @Menu.Menu.CycleWeek</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-value">@Menu.Analysis.OverallStatus</div>
                        <div class="muted small">Nutrition status</div>
                        <div class="muted small">@GetNutritionSummary()</div>
                    </div>
                </div>
            </section>
        }
        else if (MenuDetailsTab == CommentsTab)
        {
            var reviewComponents = ReviewBoardComponents.ToList();
            var boardDays = ReviewBoardDays;

            <section class="section review-comment-summary">
                <div class="section-header">
                    <div>
                        <h3 style="margin-bottom: 6px">Review workspace</h3>
                        <p class="muted" style="margin: 0">@ReviewWorkspaceLead</p>
                    </div>
                    <div class="hero-actions review-toolbar-actions">
                        <button type="button" class="ghost-button compact-action" @onclick="SelectGeneralMenuTarget">Overall menu comment</button>
                        @if (IsAdmin)
                        {
                            <button type="button" class="button compact-action" @onclick="FinishReviewAndSend">Send review</button>
                        }
                        <span class="muted small review-open-count">@OpenCommentCount open comment@(OpenCommentCount == 1 ? "" : "s")</span>
                    </div>
                </div>

                @if (IsAdmin)
                {
                    <details class="setup-details review-perspective-details">
                        <summary>Review perspective: @ReviewPerspectiveLabel</summary>
                        <div class="review-perspective-shell">
                            <div class="review-perspective-controls">
                                <label>
                                    <div class="small muted">Review perspective</div>
                                    <InputSelect class="input compact-input" @bind-Value="ReviewPerspective">
                                        @foreach (var option in ReviewPerspectiveOptions)
                                        {
                                            <option value="@option.Key">@option.Label</option>
                                        }
                                    </InputSelect>
                                </label>
                                <div>
                                    <div class="small muted">Provider / contract</div>
                                    <strong>@ReviewProviderName</strong>
                                    <div class="muted small">@ReviewQueueMenus.Count() menu@(ReviewQueueMenus.Count() == 1 ? "" : "s") in this perspective</div>
                                </div>
                            </div>

                            <div class="review-queue-strip">
                                @foreach (var queueMenu in ReviewQueueMenus)
                                {
                                    <a class="review-queue-card @(queueMenu.Id == Menu.Menu.Id ? "active" : "")"
                                       href="@($"/menus/{queueMenu.Id}?tab=comments&perspective={ReviewPerspective}")">
                                        <span class="status-badge @(BadgeClassForStatus(queueMenu.Status))">@queueMenu.Status</span>
                                        <strong>@queueMenu.Name</strong>
                                        <span class="muted small">@queueMenu.MealType · Week @queueMenu.CycleWeek · @queueMenu.StartDate?.ToString("MMM d")</span>
                                        <span class="muted small">@ReviewQueueIssueLabel(queueMenu)</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </details>
                }

            </section>

            <div class="columns review-comment-layout">
                <section class="section review-board-section">
                    <div class="section-header">
                        <div>
                        <h3 style="margin-bottom: 6px">@ReviewBoardTitle</h3>
                        <p class="muted" style="margin: 0">Choose a review scope, then click a component cell or recipe before adding a comment.</p>
                    </div>
                        <span class="status-badge brand">@boardDays day cycle</span>
                    </div>

                    <div class="toggle-row review-scope-row">
                        @foreach (var scope in ReviewMealScopes)
                        {
                            <button type="button" class="@(ReviewMealScope == scope.Key ? "button" : "ghost-button")" @onclick="() => SetReviewMealScope(scope.Key)">@scope.Label</button>
                        }
                    </div>

                    <div class="review-board-scroll">
                        <div class="review-board-grid" style="grid-template-columns: 150px repeat(@boardDays, minmax(170px, 1fr))">
                            <div class="calendar-corner"></div>
                            @for (var dayIndex = 0; dayIndex < boardDays; dayIndex++)
                            {
                                var day = ReviewBoardStart.AddDays(dayIndex);
                                <div class="calendar-day-header">
                                    <div class="day-header-top">
                                        <div>
                                            <div class="day-name">@day.ToString("ddd").ToUpperInvariant()</div>
                                            <strong>@day.ToString("MMM d")</strong>
                                        </div>
                                    </div>
                                </div>
                            }

                            @foreach (var component in reviewComponents)
                            {
                                <div class="meal-label review-component-label">
                                    <div>
                                        <div class="meal-label-title">@component.Label</div>
                                        <div class="meal-label-subtitle">@component.Requirement</div>
                                    </div>
                                </div>
                                @for (var dayIndex = 0; dayIndex < boardDays; dayIndex++)
                                {
                                    var cellDayIndex = dayIndex;
                                    var currentComponent = component;
                                    var target = ComponentTarget(cellDayIndex, currentComponent);
                                    var commentsForTarget = CommentCountForTarget(target);
                                    var cellItems = ItemsForReviewCell(cellDayIndex, currentComponent.Key).ToList();

                                    <div class="calendar-cell review-comment-cell @(IsSelectedTarget(target) ? "active" : "") @(commentsForTarget > 0 ? "has-comments" : "")"
                                         role="button"
                                         tabindex="0"
                                         @onclick="() => SelectCommentTarget(cellDayIndex, currentComponent)">
                                        @if (commentsForTarget > 0)
                                        {
                                            <span class="comment-marker">@commentsForTarget</span>
                                        }
                                        @if (cellItems.Any())
                                        {
                                            @foreach (var item in cellItems)
                                            {
                                                <button type="button"
                                                        class="scheduled-card review-scheduled-card @(IsSelectedTarget(RecipeTarget(item)) ? "active" : "")"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => SelectRecipeCommentTarget(item)">
                                                    <span class="meal-badge">@currentComponent.Label.Substring(0, 1)</span>
                                                    <strong>@item.Recipe.RecipeName</strong>
                                                    <span>@item.Recipe.Category · @item.Recipe.Calories kcal</span>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="muted small">No item listed</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </section>

                <section class="section review-comment-side-panel">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">Write comment</h3>
                            <p class="muted" style="margin: 0">@CommentPanelDescription</p>
                        </div>
                    </div>

                    <div class="comment-target-banner">
                        <div>
                            <div class="small muted">@(IsGeneralTargetSelected ? "Overall menu comment" : "Selected item comment")</div>
                            <strong>@SelectedCommentTarget.Label</strong>
                            <div class="muted small">@SelectedCommentHelpText</div>
                        </div>
                        @if (!IsGeneralTargetSelected)
                        {
                            <button type="button" class="ghost-button tiny-button" @onclick="SelectGeneralMenuTarget">Switch to overall menu</button>
                        }
                    </div>

                    @if (!CommentsForSelectedTarget.Any())
                    {
                        <div class="empty-state" style="margin-top: 14px">No comments are linked to this target yet.</div>
                    }
                    else
                    {
                        <div class="comment-thread">
                            @foreach (var comment in CommentsForSelectedTarget)
                            {
                                <div class="comment-card">
                                    <div class="comment-card-head">
                                        <div>
                                            <strong>@comment.Author</strong>
                                            <div class="muted small">@comment.Role · @comment.CreatedAt.ToString("MMM d, yyyy h:mm tt")</div>
                                        </div>
                                        <span class="status-badge @comment.BadgeClass">@comment.Action</span>
                                    </div>
                                    <p>@comment.Body</p>
                                    <div class="comment-card-meta">
                                        <span>@comment.Visibility</span>
                                        <span>@CommentTargetLabel(comment)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="comment-entry">
                        <label>
                            <div class="small muted">@CommentInputLabel</div>
                            <textarea class="input comment-textarea" value="@NewCommentBody" @oninput="HandleCommentBodyInput"></textarea>
                        </label>
                        <div class="hero-actions">
                            <button type="button" class="button" @onclick="AddReviewComment">Add comment</button>
                            <button type="button" class="ghost-button" @onclick="ClearCommentDraft">Clear</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(CommentMessage))
                        {
                            <span class="status-badge good">@CommentMessage</span>
                        }
                    </div>
                </section>
            </div>

            @if (IsAdmin)
            {
                <section class="section review-admin-tools">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">Review support</h3>
                            <p class="muted" style="margin: 0">Use these after scanning the board: summarize provider-facing comments and convert flagged issues into comments.</p>
                        </div>
                    </div>

                    <div class="comment-summary-metrics">
                        <button type="button" class="comment-metric-card @(IsGeneralTargetSelected ? "active" : "")" @onclick="SelectGeneralMenuTarget">
                            <strong>@GeneralCommentCount</strong>
                            <span>Overall menu comments</span>
                        </button>
                        <div class="comment-metric-card">
                            <strong>@CorrectionCommentCount</strong>
                            <span>Corrections</span>
                        </div>
                        <div class="comment-metric-card">
                            <strong>@AnchoredCommentCount</strong>
                            <span>Linked to cells or recipes</span>
                        </div>
                        <div class="comment-metric-card">
                            <strong>@SentReviewCount</strong>
                            <span>Review sent events</span>
                        </div>
                    </div>

                    <div class="review-admin-tool-grid">
                        <div class="comment-summary-tool">
                            <div class="section-header compact-header">
                                <div>
                                    <h4>Comment summary for email</h4>
                                    <p class="muted small">Generate a provider-facing summary grouped by menu item, component, or overall menu target.</p>
                                </div>
                                <div class="comment-summary-actions">
                                    <button type="button" class="ghost-button" @onclick="ToggleMenuCommentSummary">
                                        @(ShowMenuCommentSummary ? "Hide summary" : "Generate summary")
                                    </button>
                                    @if (ShowMenuCommentSummary)
                                    {
                                        <button type="button" class="secondary-button" @onclick="CopyMenuCommentSummary">Copy summary</button>
                                    }
                                </div>
                            </div>

                            @if (ShowMenuCommentSummary)
                            {
                                <div class="comment-summary-generated">
                                    <div class="comment-summary-stats">
                                        <span>@ProviderFacingMenuSummaryComments.Count() provider-facing comment@(ProviderFacingMenuSummaryComments.Count() == 1 ? "" : "s")</span>
                                        <span>@ProviderFacingMenuSummaryComments.Count(comment => TargetKey(comment) != TargetKey(GeneralMenuTarget)) linked item@(ProviderFacingMenuSummaryComments.Count(comment => TargetKey(comment) != TargetKey(GeneralMenuTarget)) == 1 ? "" : "s")</span>
                                        <span>@ProviderFacingMenuSummaryComments.Select(CommentTargetLabel).Distinct(StringComparer.OrdinalIgnoreCase).Count() target@(ProviderFacingMenuSummaryComments.Select(CommentTargetLabel).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? "" : "s")</span>
                                    </div>
                                    <textarea class="input comment-summary-textarea" readonly>@MenuCommentSummaryText</textarea>
                                    @if (!string.IsNullOrWhiteSpace(MenuCommentSummaryMessage))
                                    {
                                        <span class="status-badge good">@MenuCommentSummaryMessage</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="review-attention-panel">
                            <div class="section-header compact-header">
                                <div>
                                    <h4>Menu checks needing attention</h4>
                                    <p class="muted small">Flags from nutrition results, missing meal components, and repeated recipes.</p>
                                </div>
                                <span class="status-badge brand">@ReviewAttentionItems.Count() item@(ReviewAttentionItems.Count() == 1 ? "" : "s")</span>
                            </div>
                            @if (!ReviewAttentionItems.Any())
                            {
                                <div class="empty-state compact-empty">No rule-based attention items were found for this menu.</div>
                            }
                            else
                            {
                                <div class="review-attention-list">
                                    @foreach (var item in ReviewAttentionItems.Take(6))
                                    {
                                        <div class="review-attention-row">
                                            <span class="status-badge @item.BadgeClass">@item.Severity</span>
                                            <div>
                                                <strong>@item.Title</strong>
                                                <div class="muted small">@item.Detail</div>
                                            </div>
                                            @if (item.Target is not null)
                                            {
                                                <button type="button" class="ghost-button tiny-button" @onclick="() => UseAttentionItemAsComment(item)">Add as comment</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (MealComparisonRows.Count() > 1)
                        {
                            <div class="meal-comparison-panel">
                                <div class="section-header compact-header">
                                    <div>
                                        <h4>Meal scope summary</h4>
                                        <p class="muted small">Shows item count, calories, sodium, and component coverage by breakfast, lunch, and dinner when a menu includes multiple meal views.</p>
                                    </div>
                                </div>
                                <div class="meal-comparison-grid">
                                    @foreach (var row in MealComparisonRows)
                                    {
                                        <div class="meal-comparison-card">
                                            <strong>@row.MealName</strong>
                                            <span>@row.ItemCount item@(row.ItemCount == 1 ? "" : "s")</span>
                                            <span>@row.Calories kcal · @row.SodiumMg mg sodium</span>
                                            <span>@row.ComponentCount component@(row.ComponentCount == 1 ? "" : "s")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (VisibleReviewComments.Any())
                        {
                            <div class="comment-shortcut-list">
                                @foreach (var comment in AnchoredCommentShortcuts.Take(8))
                                {
                                    <button type="button" class="comment-shortcut-row @(IsCommentTargetSelected(comment) ? "active" : "")" @onclick="() => FocusComment(comment)">
                                        <span class="status-badge @comment.BadgeClass">@comment.Action</span>
                                        <span class="comment-shortcut-main">
                                            <strong>@CommentTargetLabel(comment)</strong>
                                            <span>@CommentSnippet(comment.Body)</span>
                                        </span>
                                        <span class="muted small">@comment.CreatedAt.ToString("MMM d")</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="section">
                <div class="section-header">
                    <div>
                        <h3 style="margin-bottom: 6px">Submission and revision history</h3>
                        <p class="muted" style="margin: 0">High-level workflow only: submitted, review sent, provider response or resubmission, and approval.</p>
                    </div>
                    <span class="status-badge brand">@WorkflowEvents.Count() step@(WorkflowEvents.Count() == 1 ? "" : "s")</span>
                </div>
                <div class="admin-table-wrap" style="margin-top: 14px">
                    <table class="admin-table review-history-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Step</th>
                                <th>By</th>
                                <th>Notes</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comment in WorkflowEvents)
                            {
                                <tr>
                                    <td>@comment.CreatedAt.ToString("MMM d, yyyy")</td>
                                    <td><span class="status-badge @comment.BadgeClass">@WorkflowActionLabel(comment)</span></td>
                                    <td>
                                        <strong>@comment.Author</strong>
                                        <div class="muted small">@comment.Role</div>
                                    </td>
                                    <td>@comment.Body</td>
                                    <td>@comment.Visibility</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter]
    public int MenuId { get; set; }

    [CascadingParameter] public AppRole CurrentRole { get; set; }

    private MenuDetailDto? Menu { get; set; }
    private bool _accessDenied;
    private ElementReference _pageRoot;
    private IJSObjectReference? _dragDropModule;
    private DotNetObjectReference<MenuDetails>? _dotNetRef;
    private const string ReviewTab = "review";
    private const string CommentsTab = "comments";
    private const string ThisMenuPerspective = "this-menu";
    private const string SameProviderPerspective = "same-provider";
    private const string SameProviderCyclePerspective = "same-provider-cycle";
    private const string SameProviderMealPerspective = "same-provider-meal";
    private const string SameProviderNeedsReviewPerspective = "same-provider-needs-review";
    private const string ReviewCommentAction = "Review comment";
    private const string ProviderResponseAction = "Provider response";
    private const string ReviewSentAction = "Comments sent to provider";
    private static readonly CommentTarget GeneralMenuTarget = new("menu", "General menu summary");
    private string MenuDetailsTab { get; set; } = CommentsTab;
    private string ReviewPerspective { get; set; } = SameProviderPerspective;
    private string DraftName { get; set; } = string.Empty;
    private DateTime DraftStartDate { get; set; } = StartOfServiceWeek(DateTime.Today);
    private int DraftDaysPerWeek { get; set; } = 5;
    private int DraftCycleWeek { get; set; } = 1;
    private List<MenuItemDetailDto> DraftItems { get; set; } = new();
    private List<MenuSummaryDto> AllMenus { get; set; } = [];
    private List<MenuReviewCommentDto> ReviewComments { get; set; } = [];
    private CommentTarget SelectedCommentTarget { get; set; } = GeneralMenuTarget;
    private string ReviewMealScope { get; set; } = AllMealsScope;
    private string NewCommentBody { get; set; } = string.Empty;
    private string? CommentMessage { get; set; }
    private string? MenuActionMessage { get; set; }
    private bool ShowMenuCommentSummary { get; set; }
    private string? MenuCommentSummaryMessage { get; set; }
    private int? DragDraftIndex { get; set; }
    private int? HoverDraftIndex { get; set; }
    private int? DropDraftPulseIndex { get; set; }
    private bool IsProvider => CurrentRole == AppRole.Provider;
    private bool IsAdmin => CurrentRole == AppRole.Admin;
    private IEnumerable<MenuReviewCommentDto> RoleVisibleReviewComments => ReviewComments
        .Where(comment => IsAdmin || !comment.Visibility.Equals("Internal", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<MenuReviewCommentDto> VisibleReviewComments => RoleVisibleReviewComments
        .Where(IsCommentVisibleInReviewThread);
    private string CommentPanelDescription => IsProvider
        ? "Review NYC Aging comments and add a response for the reviewer."
        : "Add comments that providers can use to revise the menu.";
    private string CommentInputLabel => IsProvider
        ? "Response to NYC Aging"
        : "Comment to provider";
    private string MenuWorkspaceDescription => IsAdmin
        ? "Review same-provider submissions, add provider-facing comments, and check rule-based items that may need attention."
        : "View NYC Aging comments, respond to requested changes, and check menu status history.";
    private string ReviewWorkspaceLead => IsAdmin
        ? "Use the perspective selector to move through related provider menus, then select a cell or recipe to write a linked comment."
        : "Review NYC Aging comments, select a linked item if needed, and respond for the reviewer.";
    private DateTime ReviewBoardStart => Menu?.Menu.StartDate ?? Menu?.Menu.ServiceDate ?? StartOfServiceWeek(DateTime.Today);
    private int ReviewBoardDays => Math.Clamp(Menu?.Menu.DaysPerWeek ?? 5, 1, 7);
    private const string AllMealsScope = "all";
    private string SelectedTargetKey => TargetKey(SelectedCommentTarget);
    private bool IsGeneralTargetSelected => SelectedTargetKey == TargetKey(GeneralMenuTarget);
    private string SelectedCommentHelpText => IsGeneralTargetSelected
        ? "Use this for summary comments about the whole submitted menu."
        : "This comment will stay linked to the selected day, component, or recipe.";
    private IEnumerable<MenuReviewCommentDto> CommentsForSelectedTarget => VisibleReviewComments
        .Where(comment => TargetKey(comment) == SelectedTargetKey);
