    private List<MenuReviewCommentDto> BuildReviewComments(IEnumerable<MenuReviewCommentDto> savedComments)
    {
        if (Menu is null)
        {
            return [];
        }

        var menu = Menu.Menu;
        var savedCommentList = savedComments.ToList();
        var hasSavedReturnedComment = !string.IsNullOrWhiteSpace(menu.ReturnedComments)
            && savedCommentList.Any(comment => comment.Action.Contains("Correction", StringComparison.OrdinalIgnoreCase)
                && comment.Body.Equals(menu.ReturnedComments, StringComparison.OrdinalIgnoreCase));
        var hasSavedApprovalComment = !string.IsNullOrWhiteSpace(menu.ApprovalNotes)
            && savedCommentList.Any(comment => comment.Action.Contains("Approval", StringComparison.OrdinalIgnoreCase)
                && comment.Body.Equals(menu.ApprovalNotes, StringComparison.OrdinalIgnoreCase));
        var comments = new List<MenuReviewCommentDto>
        {
            SyntheticReviewComment(
                menu.Id,
                menu.CreatedAt,
                "Created",
                menu.CreatedBy ?? "Menu staff",
                "Provider / Caterer",
                $"Created {menu.Name} for {menu.ContractName ?? string.Join(", ", menu.Contracts)}.",
                "Internal",
                "brand",
                false)
        };

        if (menu.SubmittedToNycAgingOn is not null)
        {
            comments.Add(SyntheticReviewComment(
                menu.Id,
                menu.SubmittedToNycAgingOn.Value,
                "Submitted",
                menu.CreatedBy ?? "Menu staff",
                "Provider / Caterer",
                $"Submitted to NYC Aging for {menu.MealType} review.",
                "Admin and provider",
                "brand",
                false));
        }

        if (!string.IsNullOrWhiteSpace(menu.ReturnedComments) && !hasSavedReturnedComment)
        {
            comments.Add(SyntheticReviewComment(
                menu.Id,
                menu.StatusDate ?? DateTime.Today,
                "Returned correction",
                menu.NutritionAdvisor ?? "NYC Aging Nutrition Unit",
                "Admin / Department staff",
                menu.ReturnedComments!,
                "Admin and provider",
                "warn",
                false));
        }

        if (!string.IsNullOrWhiteSpace(menu.ApprovalNotes) && !hasSavedApprovalComment)
        {
            comments.Add(SyntheticReviewComment(
                menu.Id,
                menu.StatusDate ?? DateTime.Today,
                "Approval note",
                menu.NutritionAdvisor ?? "NYC Aging Nutrition Unit",
                "Admin / Department staff",
                menu.ApprovalNotes!,
                "Admin and provider",
                "good",
                false));
        }

        comments.Add(SyntheticReviewComment(
            menu.Id,
            menu.StatusDate ?? menu.CreatedAt,
            menu.Status,
            menu.SubmittedTo ?? "Simple Servings",
            "System status",
            $"Current menu status is {menu.Status}.",
            "Admin and provider",
            BadgeClassForStatus(menu.Status),
            false));

        comments.AddRange(savedCommentList);

        return comments
            .OrderByDescending(comment => comment.CreatedAt)
            .ThenByDescending(comment => comment.Action)
            .ToList();
    }

    private static MenuReviewCommentDto SyntheticReviewComment(
        int menuId,
        DateTime createdAt,
        string action,
        string author,
        string role,
        string body,
        string visibility,
        string badgeClass,
        bool isUserComment,
        string targetType = "menu",
        string? targetLabel = "General menu summary",
        int? dayIndex = null,
        string? mealSlot = null,
