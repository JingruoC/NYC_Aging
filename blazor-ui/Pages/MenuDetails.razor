    private CommentTarget ComponentTarget(int dayIndex, LegacyMealComponent component)
    {
        var day = ReviewBoardStart.AddDays(dayIndex);
        var mealName = ReviewMealScope == AllMealsScope ? "All meals" : ReviewScopeLabel(ReviewMealScope);
        return new CommentTarget("component", $"{day:ddd MMM d} {mealName} - {component.Label}", dayIndex, mealName, component.Key);
    }

    private CommentTarget RecipeTarget(MenuItemDetailDto item)
    {
        var day = ReviewBoardStart.AddDays(Math.Clamp(item.DayIndex, 0, ReviewBoardDays - 1));
        var mealName = MealNameFromSlot(item.MealSlot, Menu?.Menu.MealType);
        var componentKey = NormalizeCommentComponentKey(item.ComponentKey ?? ExtractComponentFromMealSlot(item.MealSlot) ?? item.Recipe.Category);
        return new CommentTarget("recipe", $"{day:ddd MMM d} {mealName} - {item.Recipe.RecipeName}", item.DayIndex, mealName, componentKey, item.RecipeId);
    }

