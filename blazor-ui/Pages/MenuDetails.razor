        };

    private static string BadgeClassForStatus(string status)
    {
        if (status.Contains("Approved", StringComparison.OrdinalIgnoreCase)
            || status.Contains("Completed", StringComparison.OrdinalIgnoreCase))
        {
            return "good";
        }

        if (status.Contains("Returned", StringComparison.OrdinalIgnoreCase)
            || status.Contains("Correction", StringComparison.OrdinalIgnoreCase))
        {
            return "warn";
        }

        return "brand";
    }

    private static string BadgeClassForAction(string action)
    {
        if (action.Contains("Approval", StringComparison.OrdinalIgnoreCase))
        {
            return "good";
        }

        if (action.Contains("Correction", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Returned", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Question", StringComparison.OrdinalIgnoreCase))
        {
            return "warn";
        }

        return "brand";
    }

    private static string? GetQueryValue(string uri, string key)
    {
        var query = new Uri(uri).Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var segment in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = segment.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals(key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(parts[1]);
            }
        }

        return null;
    }

    private static bool IsValidReviewPerspective(string? perspective) =>
        perspective is not null
        && new[]
        {
            ThisMenuPerspective,
            SameProviderPerspective,
            SameProviderCyclePerspective,
            SameProviderMealPerspective,
            SameProviderNeedsReviewPerspective
        }.Contains(perspective, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        _accessDenied = false;
        Menu = await Api.GetMenuAsync(MenuId);
        if (Menu is not null && IsProvider && !AppMode.CanProviderSeeMenu(Menu.Menu))
        {
            Menu = null;
            _accessDenied = true;
            AllMenus = [];
            ReviewComments = [];
            return;
        }

        AllMenus = await Api.GetMenusAsync();
        if (Menu is not null)
        {
            ResetDraftFields();
            ResetDraftItems();
            var savedComments = await Api.GetMenuCommentsAsync(MenuId);
            ReviewComments = BuildReviewComments(savedComments);
        }

        var requestedTab = GetQueryValue(Navigation.Uri, "tab");
        var requestedPerspective = GetQueryValue(Navigation.Uri, "perspective");
        if (IsValidReviewPerspective(requestedPerspective))
        {
            ReviewPerspective = requestedPerspective!;
        }

        if (requestedTab?.Equals(CommentsTab, StringComparison.OrdinalIgnoreCase) == true)
        {
            SetMenuDetailsTab(CommentsTab);
        }
        else if (requestedTab?.Equals("insights", StringComparison.OrdinalIgnoreCase) == true)
        {
            SetMenuDetailsTab(IsAdmin ? ReviewTab : CommentsTab);
        }
        else if (requestedTab?.Equals(ReviewTab, StringComparison.OrdinalIgnoreCase) == true)
        {
            SetMenuDetailsTab(ReviewTab);
        }
        else if (!CanUseMenuDetailsTab(MenuDetailsTab))
        {
            SetMenuDetailsTab(CommentsTab);
        }

        CommentMessage = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _dragDropModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/dragDropBridge.js");
            await _dragDropModule.InvokeVoidAsync("attachDragPayloads", _pageRoot, _dotNetRef);
        }
        catch
        {
            _dragDropModule = null;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_dragDropModule is not null)
            {
                await _dragDropModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The user may navigate away or stop the dev server while the circuit is disposing.
        }

        _dotNetRef?.Dispose();
    }

