    private string BuildMenuCommentSummaryText()
    {
        if (Menu is null)
        {
            return string.Empty;
        }

        var comments = ProviderFacingMenuSummaryComments.ToList();
        var lines = new List<string>
        {
            $"Menu review comments: {Menu.Menu.Name}",
            $"Provider/contract: {ReviewProviderName}",
            $"Service dates: {FormatDateRange(Menu.Menu.StartDate, Menu.Menu.EndDate)}",
            $"Cycle week: Week {Menu.Menu.CycleWeek}",
            $"Status: {Menu.Menu.Status}",
            string.Empty
        };

        if (comments.Count == 0)
        {
            lines.Add("No provider-facing review comments have been added yet.");
            return string.Join(Environment.NewLine, lines);
        }

        var linkedCount = comments.Count(comment => TargetKey(comment) != TargetKey(GeneralMenuTarget));
        lines.Add($"Summary: {comments.Count} provider-facing comment{Plural(comments.Count)}, {linkedCount} linked to specific menu item{Plural(linkedCount)} or component{Plural(linkedCount)}.");
        lines.Add(string.Empty);
        lines.Add("Comments by item:");

        foreach (var group in comments.GroupBy(CommentTargetLabel).OrderBy(group => group.Key))
        {
            lines.Add($"- {group.Key}");
            foreach (var comment in group.OrderBy(comment => comment.CreatedAt))
            {
                lines.Add($"  - {CleanSummaryLine(comment.Body)}");
            }
        }

        lines.Add(string.Empty);
        lines.Add("Requested next step: Please review the comments above, update the menu as needed, and resubmit through Simple Servings.");
        return string.Join(Environment.NewLine, lines);
    }

