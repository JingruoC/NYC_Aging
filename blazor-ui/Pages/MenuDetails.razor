    private bool CanUseMenuDetailsTab(string tab) =>
        tab.Equals(CommentsTab, StringComparison.OrdinalIgnoreCase)
        || (IsAdmin && tab.Equals(ReviewTab, StringComparison.OrdinalIgnoreCase));

    private void SetMenuDetailsTab(string tab)
    {
        MenuDetailsTab = CanUseMenuDetailsTab(tab) ? tab : CommentsTab;
    }

    private async Task AddReviewComment()
    {
        if (Menu is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(NewCommentBody))
        {
            CommentMessage = "Enter a comment before adding it.";
            return;
        }

        var action = IsProvider ? ProviderResponseAction : ReviewCommentAction;
        var created = await Api.CreateMenuCommentAsync(Menu.Menu.Id, new MenuReviewCommentCreateRequest
        {
            Action = action,
            Author = IsProvider ? AppMode.ProviderContract : "NYC Aging Nutrition Unit",
            Role = IsProvider ? "Provider / Caterer" : "Admin / Department staff",
            Body = NewCommentBody.Trim(),
            Visibility = "Admin and provider",
            BadgeClass = BadgeClassForAction(action),
            IsUserComment = true,
            TargetType = SelectedCommentTarget.TargetType,
            TargetLabel = SelectedCommentTarget.Label,
            DayIndex = SelectedCommentTarget.DayIndex,
            MealSlot = SelectedCommentTarget.MealSlot,
            ComponentKey = SelectedCommentTarget.ComponentKey,
            RecipeId = SelectedCommentTarget.RecipeId,
            NutrientKey = SelectedCommentTarget.NutrientKey,
            ReviewStatus = "open"
        });

        ReviewComments.Insert(0, created);

        NewCommentBody = string.Empty;
        CommentMessage = $"Comment added to {SelectedCommentTarget.Label}.";
    }

    private async Task FinishReviewAndSend()
    {
        if (Menu is null || !IsAdmin)
        {
            return;
        }

        var providerCommentCount = VisibleReviewComments.Count(comment => comment.Action.Equals(ReviewCommentAction, StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Correction", StringComparison.OrdinalIgnoreCase));
        var body = providerCommentCount == 0
            ? "NYC Aging finished reviewing this menu and sent the review status to the provider."
            : $"NYC Aging finished reviewing this menu and sent {providerCommentCount} comment{(providerCommentCount == 1 ? "" : "s")} to the provider for revision.";

        var created = await Api.CreateMenuCommentAsync(Menu.Menu.Id, new MenuReviewCommentCreateRequest
        {
            Action = ReviewSentAction,
            Author = "NYC Aging Nutrition Unit",
            Role = "Admin / Department staff",
            Body = body,
            Visibility = "Admin and provider",
            BadgeClass = "warn",
            IsUserComment = true,
            TargetType = GeneralMenuTarget.TargetType,
            TargetLabel = GeneralMenuTarget.Label,
            ReviewStatus = "open"
        });

        ReviewComments.Insert(0, created);
        SelectGeneralMenuTarget();
        CommentMessage = "Review sent to provider. It will appear as a provider follow-up item.";
    }

