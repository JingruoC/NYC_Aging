        return ScopedReviewItems
            .Where(item => item.DayIndex == dayIndex)
            .Where(item => NormalizeCommentComponentKey(item.ComponentKey ?? ExtractComponentFromMealSlot(item.MealSlot) ?? item.Recipe.Category) == componentKey)
            .OrderBy(item => item.Position);
    }

    private int CommentCountForTarget(CommentTarget target) => RoleVisibleReviewComments.Count(comment => TargetKey(comment) == TargetKey(target));

    private bool IsSelectedTarget(CommentTarget target) => TargetKey(target) == SelectedTargetKey;

    private bool IsCommentTargetSelected(MenuReviewCommentDto comment) => TargetKey(comment) == SelectedTargetKey;

    private string CommentTargetLabel(MenuReviewCommentDto comment)
    {
        if (!string.IsNullOrWhiteSpace(comment.TargetLabel))
        {
            return comment.TargetLabel!;
        }

        if (comment.TargetType.Equals("nutrition", StringComparison.OrdinalIgnoreCase))
        {
            return string.IsNullOrWhiteSpace(comment.NutrientKey) ? "Nutrition checks" : $"Nutrition - {comment.NutrientKey}";
        }

        if (comment.TargetType.Equals("recipe", StringComparison.OrdinalIgnoreCase))
        {
            var recipe = Menu?.Menu.Items.FirstOrDefault(item => item.RecipeId == comment.RecipeId)?.Recipe.RecipeName;
            return string.IsNullOrWhiteSpace(recipe) ? "Recipe item" : $"Recipe - {recipe}";
        }

        if (comment.TargetType.Equals("component", StringComparison.OrdinalIgnoreCase))
        {
            var dayLabel = comment.DayIndex is null ? "Day" : ReviewBoardStart.AddDays(comment.DayIndex.Value).ToString("ddd MMM d");
            var component = LegacyReferenceData.MealComponents.FirstOrDefault(item => item.Key == NormalizeCommentComponentKey(comment.ComponentKey ?? string.Empty));
            return $"{dayLabel} {comment.MealSlot ?? Menu?.Menu.MealType ?? "Meal"} - {component?.Label ?? "Component"}";
        }

        return "General menu summary";
    }

    private static string CommentSnippet(string body)
    {
        const int maxLength = 82;
        var cleanBody = body.Trim();
        return cleanBody.Length <= maxLength ? cleanBody : $"{cleanBody[..maxLength]}...";
    }

    private static string CleanSummaryLine(string body) =>
        string.Join(' ', body.Split(['\r', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)).Trim();

    private static string Plural(int count) => count == 1 ? string.Empty : "s";

    private static string FormatDateRange(DateTime? startDate, DateTime? endDate)
    {
        if (startDate is null && endDate is null)
        {
            return "Not listed";
        }

        if (startDate is null)
        {
            return endDate!.Value.ToString("MMM d, yyyy");
        }

        if (endDate is null || startDate.Value.Date == endDate.Value.Date)
        {
            return startDate.Value.ToString("MMM d, yyyy");
        }

        return $"{startDate.Value:MMM d, yyyy} to {endDate.Value:MMM d, yyyy}";
    }

    private static bool IsCommentVisibleInReviewThread(MenuReviewCommentDto comment)
    {
        if (comment.Visibility.Equals("Internal", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!comment.IsUserComment)
        {
            return false;
        }

        if (comment.Action.Equals(ReviewSentAction, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return comment.Action.Contains("Comment", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Correction", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Approval", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Response", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsWorkflowEvent(MenuReviewCommentDto comment)
    {
        if (comment.Action.Equals(ReviewCommentAction, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return comment.Action.Equals("Created", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Equals("Submitted", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Equals(ReviewSentAction, StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Returned", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Provider response", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Resubmitted", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Approval", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Approved", StringComparison.OrdinalIgnoreCase);
    }

    private static string WorkflowStageKey(MenuReviewCommentDto comment)
    {
        if (comment.Action.Contains("Created", StringComparison.OrdinalIgnoreCase))
        {
            return "created";
        }

        if (comment.Action.Contains("Submitted", StringComparison.OrdinalIgnoreCase))
        {
            return "submitted";
        }

        if (comment.Action.Equals(ReviewSentAction, StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Returned", StringComparison.OrdinalIgnoreCase))
        {
            return "comments-sent";
        }

        if (comment.Action.Contains("Provider response", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Resubmitted", StringComparison.OrdinalIgnoreCase))
        {
            return "provider-response";
        }

        if (comment.Action.Contains("Approval", StringComparison.OrdinalIgnoreCase)
            || comment.Action.Contains("Approved", StringComparison.OrdinalIgnoreCase))
        {
            return "approval";
        }

        return comment.Action.ToLowerInvariant();
    }

    private static string WorkflowActionLabel(MenuReviewCommentDto comment)
    {
        var stage = WorkflowStageKey(comment);
        return stage switch
        {
            "created" => "Created",
            "submitted" => "Submitted",
            "comments-sent" => "Comments sent",
            "provider-response" => "Provider response",
            "approval" => "Approval",
            _ => comment.Action
        };
    }

    private IEnumerable<ReviewAttentionItem> BuildReviewAttentionItems()
    {
        if (Menu is null)
        {
            return [];
        }

        var items = new List<ReviewAttentionItem>();
        foreach (var status in Menu.Analysis.Statuses.Where(status => !status.Status.Equals("pass", StringComparison.OrdinalIgnoreCase)))
        {
            var nutrientLabel = status.NutrientKey.Replace("_", " ");
            items.Add(new ReviewAttentionItem(
                status.Status.Equals("fail", StringComparison.OrdinalIgnoreCase) ? "Fail" : "Warning",
                nutrientLabel,
                status.Message,
                status.Status.Equals("fail", StringComparison.OrdinalIgnoreCase) ? "bad" : "warn",
                new CommentTarget("nutrition", $"Nutrition - {nutrientLabel}", NutrientKey: status.NutrientKey)));
        }

        foreach (var requirement in Menu.Analysis.MealRequirements.Where(requirement => !requirement.Status.Equals("pass", StringComparison.OrdinalIgnoreCase)))
        {
            items.Add(new ReviewAttentionItem(
                requirement.Status.Equals("fail", StringComparison.OrdinalIgnoreCase) ? "Fail" : "Check",
                requirement.Title,
                requirement.Message,
                requirement.Status.Equals("fail", StringComparison.OrdinalIgnoreCase) ? "bad" : "warn",
                GeneralMenuTarget));
        }

        foreach (var group in Menu.Menu.Items.GroupBy(item => item.Recipe.RecipeName).Where(group => group.Count() > 1).OrderByDescending(group => group.Count()).Take(3))
        {
            var firstItem = group.OrderBy(item => item.DayIndex).ThenBy(item => item.Position).First();
            items.Add(new ReviewAttentionItem(
                "Check",
                "Repeated recipe",
                $"{group.Key} appears {group.Count()} times in this menu.",
                "warn",
                RecipeTarget(firstItem)));
        }

        var repeatedEntree = Menu.Menu.Items
            .Where(item => NormalizeCommentComponentKey(item.ComponentKey ?? ExtractComponentFromMealSlot(item.MealSlot) ?? item.Recipe.Category) == "entree")
            .GroupBy(item => item.Recipe.RecipeName)
            .Where(group => group.Count() > 1)
            .OrderByDescending(group => group.Count())
            .FirstOrDefault();

        if (repeatedEntree is not null)
        {
            var firstEntree = repeatedEntree.OrderBy(item => item.DayIndex).ThenBy(item => item.Position).First();
            items.Add(new ReviewAttentionItem(
                "Check",
                "Entrée repetition",
                $"{repeatedEntree.Key} is used as an entrée {repeatedEntree.Count()} times.",
                "warn",
                RecipeTarget(firstEntree)));
        }

        if (!items.Any())
        {
            items.Add(new ReviewAttentionItem(
                "OK",
                "No attention items found",
                "Nutrition, component, and repetition checks did not flag this menu.",
                "good"));
        }

        return items;
    }

    private static string TargetKey(MenuReviewCommentDto comment) =>
        TargetKey(comment.TargetType, comment.DayIndex, comment.MealSlot, comment.ComponentKey, comment.RecipeId, comment.NutrientKey);

    private static string TargetKey(CommentTarget target) =>
        TargetKey(target.TargetType, target.DayIndex, target.MealSlot, target.ComponentKey, target.RecipeId, target.NutrientKey);

    private static string TargetKey(string? targetType, int? dayIndex, string? mealSlot, string? componentKey, int? recipeId, string? nutrientKey)
    {
        var normalizedType = string.IsNullOrWhiteSpace(targetType) ? "menu" : targetType.Trim().ToLowerInvariant();
        if (normalizedType == "recipe" && recipeId is not null)
        {
            return $"recipe:{recipeId}";
        }

        if (normalizedType == "nutrition")
        {
            return $"nutrition:{NormalizeToken(nutrientKey)}";
        }

        if (normalizedType == "component")
        {
            return $"component:{dayIndex?.ToString() ?? "any"}:{NormalizeToken(mealSlot)}:{NormalizeCommentComponentKey(componentKey ?? string.Empty)}";
        }

        return "menu";
    }

    private static string MealNameFromSlot(string? mealSlot, string? fallback)
    {
        if (string.IsNullOrWhiteSpace(mealSlot))
        {
            return string.IsNullOrWhiteSpace(fallback) ? "Meal" : fallback!;
        }

        var mealName = mealSlot.Split('_', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? mealSlot;
        return mealName.Length <= 1 ? mealName.ToUpperInvariant() : $"{char.ToUpperInvariant(mealName[0])}{mealName[1..].ToLowerInvariant()}";
    }

    private static string MealKeyFromSlot(string? mealSlot, string? fallback)
    {
        var mealName = MealNameFromSlot(mealSlot, fallback);
        return mealName.ToLowerInvariant() switch
        {
            "breakfast" => "breakfast",
            "lunch" => "lunch",
            "dinner" => "dinner",
            _ => mealName.ToLowerInvariant()
        };
    }

    private static string ReviewScopeLabel(string scope) => scope.ToLowerInvariant() switch
    {
        AllMealsScope => "All meals",
