    private async Task RefreshInsightsAsync()
    {
        var selectedIds = CurrentWeekItems.Select(item => item.Recipe.RecipeId).ToList();

        if (!selectedIds.Any())
        {
            LastPlacedRecipe = null;
            RecommendedItems = PopularRecipeIds.Count > 0
                ? AllRecipes.Where(recipe => PopularRecipeIds.Contains(recipe.RecipeId))
                    .OrderBy(recipe => PopularRecipeIds.IndexOf(recipe.RecipeId))
                    .Take(6)
                    .Select(recipe => new RecommendationItemDto
                    {
                        Recipe = recipe,
                        Score = Math.Max(1, 6 - PopularRecipeIds.IndexOf(recipe.RecipeId)),
                        Reasons = ["Frequently used in historical menus"]
                    })
                    .ToList()
                : AllRecipes.Take(6)
                    .Select(recipe => new RecommendationItemDto
                    {
                        Recipe = recipe,
                        Score = 1,
                        Reasons = ["Approved recipe"]
                    })
                    .ToList();
            Analysis = null;
            SimilarMenus.Clear();
            RevisionSuggestions.Clear();
            return;
        }

        var analysisTask = Api.AnalyzeMenuAsync(new MenuAnalysisRequest
        {
            RecipeIds = selectedIds,
            Items = BuildMenuItems(CurrentSchedule)
        });
        var autocompleteTask = Api.GetAutocompleteAsync(selectedIds);
        var revisionsTask = Api.GetRevisionsAsync(selectedIds);
        var similarTask = Api.GetSimilarMenusAsync(selectedIds);

        await Task.WhenAll(analysisTask, autocompleteTask, revisionsTask, similarTask);

        Analysis = analysisTask.Result;
        RecommendedItems = autocompleteTask.Result;
        RevisionSuggestions = revisionsTask.Result.Suggestions;
        SimilarMenus = similarTask.Result;
    }

