    private void SwapActiveWeekWithTarget()
    {
        if (ActiveWeek == CycleActionTargetWeek)
        {
            PlannerMessage = "Choose a different target week.";
            return;
        }

        var targetWeek = CycleActionTargetWeek;
        var activeWasComplete = CompletedWeeks.Contains(ActiveWeek);
        var targetWasComplete = CompletedWeeks.Contains(targetWeek);

        (SchedulesByWeek[ActiveWeek], SchedulesByWeek[targetWeek]) =
            (SchedulesByWeek[targetWeek], SchedulesByWeek[ActiveWeek]);

        CompletedWeeks.Remove(ActiveWeek);
        CompletedWeeks.Remove(targetWeek);
        if (activeWasComplete)
        {
            CompletedWeeks.Add(targetWeek);
        }
        if (targetWasComplete)
        {
            CompletedWeeks.Add(ActiveWeek);
        }
        CompletedWeeks.Sort();
        UpdateMenuStatusFromCompletedWeeks();
        PlannerMessage = $"Swapped Week {ActiveWeek} and Week {CycleActionTargetWeek}.";
        _ = RefreshInsightsAsync();
    }

