    private async Task MarkActiveWeekComplete()
    {
        var missing = FindFirstMissingRequiredSlot();
        if (missing is not null)
        {
            SelectedMealView = MealSlotToGalleryMode(missing.Value.MealSlot);
            SelectedCell = new CellSelection(missing.Value.DayIndex, missing.Value.MealSlot, missing.Value.ComponentKey);
            PlannerMessage = $"Week {ActiveWeek} is not complete. Add {ComponentLabel(missing.Value.ComponentKey).ToLowerInvariant()} for {DateForDayIndex(missing.Value.DayIndex):ddd, MMM d} {MealLabel(missing.Value.MealSlot).ToLowerInvariant()}.";
            return;
        }

        await RefreshInsightsAsync();
        if (Analysis is null || !Analysis.OverallStatus.Equals("pass", StringComparison.OrdinalIgnoreCase))
        {
            PlannerSidebarTab = PlannerInsightsTab;
            ShowNutritionReview = true;
            PlannerMessage = $"Week {ActiveWeek} cannot be completed until the nutrition and meal checks pass.";
            return;
        }

        if (!CompletedWeeks.Contains(ActiveWeek))
        {
            CompletedWeeks.Add(ActiveWeek);
            CompletedWeeks.Sort();
        }

        MenuStatus = CompletedWeeks.Count >= 6 ? "Completed" : "Draft";
        PlannerMessage = $"Week {ActiveWeek} marked complete.";
    }

    private CellSelection? FindFirstMissingRequiredSlot()
    {
        foreach (var dayIndex in VisibleDayIndices)
        {
            foreach (var mealSlot in VisibleMealViews.Select(MealViewToSlot))
            {
                foreach (var component in MealComponentsFor(MealSlotToGalleryMode(mealSlot)).Where(component => !component.Optional))
                {
                    if (GetCellRecipe(dayIndex, mealSlot, component.Key) is null)
                    {
                        return new CellSelection(dayIndex, mealSlot, component.Key);
                    }
                }
            }
        }

        return null;
    }

    private void MakeActiveWeekIncomplete()
    {
        CompletedWeeks.Remove(ActiveWeek);
        MenuStatus = "Incomplete";
        PlannerMessage = $"Week {ActiveWeek} marked incomplete.";
    }

    private string GetCalendarPlaceholder(MealSlot mealSlot, string componentKey)
    {
        var component = BaseMealComponents.FirstOrDefault(item => item.Key == componentKey);
        var componentName = string.IsNullOrWhiteSpace(component.Key) ? componentKey : component.Label;
        if (SelectedCell is not null && SelectedCell.Value.MealSlot == mealSlot && SelectedCell.Value.ComponentKey == componentKey)
        {
            return $"Choose {componentName.ToLowerInvariant()}";
        }

        return component.Optional ? $"{componentName} (optional)" : componentName;
    }

