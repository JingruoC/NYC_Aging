            return;
        }

        CurrentSchedule[target.Value.DayIndex][target.Value.MealSlot][target.Value.ComponentKey] = recipe;
        ReopenActiveWeekAfterChange();
        SelectedCell = null;
        LastPlacedRecipe = recipe;
        PlannerSidebarTab = PlannerInsightsTab;
        PlannerMessage = $"Added {recipe.RecipeName} to {DateForDayIndex(target.Value.DayIndex):ddd, MMM d} · {MealLabel(target.Value.MealSlot)} · {ComponentLabel(target.Value.ComponentKey)}.";
        await RefreshInsightsAsync();
    }

    private CellSelection? FindPlacementTarget(RecipeDto recipe)
    {
        if (SelectedCell is { } selected)
        {
            var selectedComponent = NormalizeComponentKey(selected.ComponentKey);
            if (VisibleDayIndices.Contains(selected.DayIndex)
                && recipe.IsSuitableForMealSlot(selected.MealSlot)
                && CanPlaceRecipeInComponent(recipe, selectedComponent)
                && GetCellRecipe(selected.DayIndex, selected.MealSlot, selectedComponent) is null)
            {
                return new CellSelection(selected.DayIndex, selected.MealSlot, selectedComponent);
            }
        }

        var mealSlots = new List<MealSlot>();
        if (SelectedCell is { } selectedCell)
        {
            mealSlots.Add(selectedCell.MealSlot);
        }
        else
        {
            mealSlots.Add(MealViewToSlot(SelectedMealView));
        }

        foreach (var mealSlot in VisibleMealViews.Select(MealViewToSlot))
        {
            if (!mealSlots.Contains(mealSlot))
            {
                mealSlots.Add(mealSlot);
            }
        }

        foreach (var mealSlot in mealSlots.Where(recipe.IsSuitableForMealSlot))
        {
            var dayIndices = VisibleDayIndices.ToList();
            if (SelectedCell is { } selectedForDay
                && selectedForDay.MealSlot == mealSlot
                && dayIndices.Remove(selectedForDay.DayIndex))
            {
                dayIndices.Insert(0, selectedForDay.DayIndex);
            }

            foreach (var dayIndex in dayIndices)
            {
                foreach (var componentKey in PreferredComponentsForRecipe(recipe).Select(NormalizeComponentKey))
                {
                    if (CurrentSchedule[dayIndex][mealSlot].ContainsKey(componentKey)
                        && GetCellRecipe(dayIndex, mealSlot, componentKey) is null)
                    {
                        return new CellSelection(dayIndex, mealSlot, componentKey);
                    }
                }
            }
        }

        return null;
    }

    private string AssignmentButtonLabel(RecipeDto recipe, bool shortLabel = false)
    {
        var target = FindPlacementTarget(recipe);
        if (target is null)
        {
            return "No open slot";
        }

        var usesSelectedCell = SelectedCell is { } selected
            && selected.DayIndex == target.Value.DayIndex
            && selected.MealSlot == target.Value.MealSlot
            && NormalizeComponentKey(selected.ComponentKey).Equals(target.Value.ComponentKey, StringComparison.OrdinalIgnoreCase);

        if (usesSelectedCell)
        {
            return shortLabel ? "Add" : "Add to selected slot";
        }

        return shortLabel ? "Add next" : "Add to next open slot";
    }

