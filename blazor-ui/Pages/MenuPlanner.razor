    private static IEnumerable<string> PreferredComponentsForRecipe(RecipeDto recipe)
    {
        var category = recipe.Category.ToLowerInvariant();
        return category switch
        {
            "entree" => ["entree", "alternate"],
            "fruit" => ["fruit", "juice-dessert", "alternate"],
            "vegetable" or "side" => ["vegetable", "appetizer", "alternate"],
            "grain" => ["grains", "alternate"],
            "milk" or "dairy" => ["dairy", "alternate"],
            "condiments" => ["condiments"],
            "juice-dessert" => ["juice-dessert", "alternate"],
            _ => ["entree", "vegetable", "fruit", "grains", "dairy", "alternate", "condiments", "juice-dessert"]
        };
    }

    private bool MatchesSelectedComponent(RecipeDto recipe)
    {
        return SelectedCell is null || CanPlaceRecipeInComponent(recipe, SelectedCell.Value.ComponentKey);
    }

    private static bool CanPlaceRecipeInComponent(RecipeDto recipe, string componentKey)
    {
        var normalizedComponent = NormalizeComponentKey(componentKey);
        return PreferredComponentsForRecipe(recipe).Contains(normalizedComponent, StringComparer.OrdinalIgnoreCase);
    }

    private static string ComponentLabel(string componentKey)
    {
        var normalizedComponent = NormalizeComponentKey(componentKey);
        return BaseMealComponents
            .Where(component => component.Key == normalizedComponent)
            .Select(component => component.Label)
            .FirstOrDefault() ?? componentKey;
    }

    private static int ComponentOrder(string componentKey)
    {
        var index = Array.FindIndex(BaseMealComponents, component => component.Key == NormalizeComponentKey(componentKey));
        return index < 0 ? 999 : index;
    }

    private static string NormalizeComponentKey(string componentKey) => componentKey.ToLowerInvariant() switch
    {
        "grain" => "grains",
        "grains" => "grains",
        "juice" => "juice-dessert",
        "dessert" => "juice-dessert",
        "juice-dessert" => "juice-dessert",
        "fruit / vegetables" => "vegetable",
        "fruit-vegetable" => "vegetable",
        "milk" => "dairy",
        "main" => "entree",
        "side" => "vegetable",
        _ => componentKey.ToLowerInvariant()
    };

    private static bool TryParsePlanCell(string value, out PlanCell planCell)
    {
        planCell = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var parts = value.Split('_', 2, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 2)
        {
            return false;
        }

        if (!Enum.TryParse<MealSlot>(parts[0], true, out var mealSlot))
        {
            return false;
        }

        planCell = new PlanCell(mealSlot, NormalizeComponentKey(parts[1]));
        return true;
    }

    private static PlanCell? ParseMenuSlot(string? mealSlot)
        => TryParsePlanCell(mealSlot ?? string.Empty, out var planCell) ? planCell : null;

    private RecipeDto? GetCellRecipe(int dayIndex, MealSlot mealSlot, string componentKey)
        => CurrentSchedule.TryGetValue(dayIndex, out var day)
            && day.TryGetValue(mealSlot, out var meal)
            && meal.TryGetValue(componentKey, out var recipe)
                ? recipe
                : null;

    private bool MatchesRecipeView(RecipeDto recipe)
    {
        return RecipeViewMode switch
        {
            "[All]" => true,
            "Public" => recipe.IsPublic,
            "Sponsor Private" => !recipe.IsPublic && recipe.ContributedBy?.Contains("Sponsor", StringComparison.OrdinalIgnoreCase) == true,
            "Caterer Private" => !recipe.IsPublic && recipe.ContributedBy?.Contains("Cater", StringComparison.OrdinalIgnoreCase) == true,
            _ => true
        };
    }

    private bool MatchesAllGalleryFilters(RecipeDto recipe)
    {
        if (SelectedGalleryFilters.Any() && !SelectedGalleryFilters.All(filter => MatchesLegacyRecipeFilter(recipe, filter.Group, filter.Value)))
        {
            return false;
        }

        return MatchesLegacyRecipeFilter(recipe, RecipeFilterGroup, RecipeFilterValue);
    }

    private bool MatchesLegacyRecipeFilter(RecipeDto recipe, string group, string value)
    {
        if (group.Equals("[Select]", StringComparison.OrdinalIgnoreCase) || value.Equals("[Select]", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var normalizedValue = LegacyReferenceData.NormalizeFilterValue(value);
        var haystack = LegacyReferenceData.NormalizeFilterValue(string.Join(" ", new[]
        {
            recipe.RecipeName,
            recipe.MealType,
            recipe.Category,
            string.Join(" ", recipe.Tags),
            string.Join(" ", recipe.NutrientClaims)
        }));

        if (LegacyFilterAliases.TryGetValue(normalizedValue, out var aliases))
        {
            return aliases.Any(alias => haystack.Contains(alias, StringComparison.OrdinalIgnoreCase));
        }

        return haystack.Contains(normalizedValue, StringComparison.OrdinalIgnoreCase);
    }

