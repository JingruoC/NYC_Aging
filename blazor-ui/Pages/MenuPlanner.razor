        ["juice or dessert"] = ["juice", "dessert", "fruit"],
        ["condiments"] = ["condiment", "dressing"],
        ["breakfast"] = ["breakfast"],
        ["non starchy vegetable"] = ["vegetable", "broccoli", "beans", "spinach", "cauliflower"],
        ["starchy vegetable"] = ["potato", "sweet potato", "corn"],
        ["plant based entree"] = ["vegetarian", "tofu", "lentil", "plant"],
        ["whole grains"] = ["whole grain", "grain", "rice", "barley", "wheat"],
        ["very low sodium"] = ["low sodium"],
        ["good source of calcium"] = ["calcium", "milk", "dairy"],
