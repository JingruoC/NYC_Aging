    private Dictionary<int, Dictionary<MealSlot, Dictionary<string, RecipeDto?>>> CloneSchedule(Dictionary<int, Dictionary<MealSlot, Dictionary<string, RecipeDto?>>> schedule) =>
        schedule.ToDictionary(
            day => day.Key,
            day => day.Value.ToDictionary(slot => slot.Key, slot => slot.Value.ToDictionary(component => component.Key, component => component.Value)));

    private async Task HandlePlannerKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Escape":
                SelectedCell = null;
                PlannerMessage = null;
                await InvokeAsync(StateHasChanged);
                break;
            case "Delete":
            case "Backspace":
                if (SelectedCell is not null)
                {
                    await RemoveRecipe(SelectedCell.Value.DayIndex, SelectedCell.Value.MealSlot, SelectedCell.Value.ComponentKey);
                }
                break;
            case "1":
            case "2":
            case "3":
            case "4":
            case "5":
            case "6":
                if (int.TryParse(args.Key, out var week) && week >= 1 && week <= 6)
                {
                    SetActiveWeek(week);
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragDropModule is not null)
        {
            try
            {
                await _dragDropModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Navigation can disconnect the circuit before the bridge is torn down.
            }
        }

        _dotNetRef?.Dispose();
    }

    private void ResizeSchedules(int daysPerWeek)
    {
        foreach (var week in SchedulesByWeek.Keys.ToList())
        {
            var existing = SchedulesByWeek[week];
            var resized = Enumerable.Range(0, daysPerWeek).ToDictionary(
                dayIndex => dayIndex,
                dayIndex => existing.TryGetValue(dayIndex, out var day) ? day : CreateEmptyDay());
            SchedulesByWeek[week] = resized;
        }

        SelectedCell = null;
        HoveredCell = null;
    }

    private Task SaveMenu() => SaveMenuAsync(exitAfterSave: false);

    private Task SaveAndExit() => SaveMenuAsync(exitAfterSave: true);

    private async Task SaveMenuAsync(bool exitAfterSave)
    {
        Saving = true;
        try
        {
            var items = BuildMenuItems(CurrentSchedule);
            var result = await Api.CreateMenuAsync(new MenuCreateRequest
            {
                Name = MenuName,
                ContractName = ContractName,
                ProgramType = ProgramType,
                MealType = PrimaryMealType,
                MenuCoverage = MenuCoverage,
                DietType = DietType,
                MenuFormat = MenuFormat,
                MenuDurationType = MenuDurationType,
                MealServedFormat = MealServedFormat,
                MenuTags = [.. SelectedMenuTags],
                Cycle = Cycle,
                CycleStartDate = CycleStartDate,
                CycleEndDate = CycleEndDate,
                Contracts = [.. SelectedContracts],
                CompletedWeeks = [.. CompletedWeeks],
                Status = MenuStatus,
                StatusDate = StatusDate,
                SubmittedToNycAgingOn = SubmittedToNycAgingOn,
                NutritionAdvisor = NutritionAdvisor,
                SubmittedTo = SubmittedTo,
                CreatedBy = CreatedBy,
                StartDate = StartDate,
                EndDate = EndDate,
                DaysPerWeek = DaysPerWeek,
                CycleWeek = ActiveWeek,
                Notes = "Created from the menu builder.",
                Items = items
            });

            Navigation.NavigateTo(exitAfterSave ? "/menus" : $"/menus/{result.Id}");
        }
        finally
        {
            Saving = false;
        }
    }

    private static List<MenuItemInput> BuildMenuItems(Dictionary<int, Dictionary<MealSlot, Dictionary<string, RecipeDto?>>> schedule)
    {
        var items = new List<MenuItemInput>();
        var position = 1;

        foreach (var dayIndex in schedule.Keys.OrderBy(key => key))
        {
            foreach (var mealSlot in MealSlots)
            {
                foreach (var component in BaseMealComponents)
                {
                    var recipe = schedule[dayIndex][mealSlot][component.Key];
                    if (recipe is null)
                    {
                        continue;
                    }

                    items.Add(new MenuItemInput
                    {
                        RecipeId = recipe.RecipeId,
                        Position = position++,
                        DayIndex = dayIndex,
                        MealSlot = $"{mealSlot.ToString().ToLowerInvariant()}_{component.Key}",
                        ComponentKey = component.Key,
                        IsAlternate = component.Key.Equals("alternate", StringComparison.OrdinalIgnoreCase),
                        SourceType = "manual"
                    });
                }
            }
        }

        return items;
    }

    private string GetServiceDaySummary()
    {
        var selectedDays = ServiceDaysEnabled
            .Select((enabled, index) => new { enabled, index })
            .Where(item => item.enabled)
            .Select(item => ServiceDayLabels[item.index])
            .ToList();

        return selectedDays.Count switch
        {
            0 => "No service days selected",
            7 => "7-day service",
            5 when selectedDays.SequenceEqual(["Mon", "Tue", "Wed", "Thu", "Fri"]) => "Mon-Fri service",
            _ => string.Join(", ", selectedDays)
        };
    }

