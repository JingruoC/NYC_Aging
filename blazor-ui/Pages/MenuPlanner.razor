    private void SetServiceDay(int index, bool enabled)
    {
        if (index < 0 || index >= ServiceDaysEnabled.Length)
        {
            return;
        }

        ServiceDaysEnabled[index] = enabled;
    }

    private void SetContract(string contract, bool selected)
    {
        if (selected && !SelectedContracts.Contains(contract))
        {
            SelectedContracts.Add(contract);
        }
        else if (!selected)
        {
            SelectedContracts.Remove(contract);
        }

        if (!SelectedContracts.Any())
        {
            SelectedContracts.Add(LegacyReferenceData.ContractNames[0]);
        }

        ContractName = string.Join(", ", SelectedContracts);
    }

    private void SetMenuTag(string tag, bool selected)
    {
        if (selected && !SelectedMenuTags.Contains(tag))
        {
            SelectedMenuTags.Add(tag);
        }
        else if (!selected)
        {
            SelectedMenuTags.Remove(tag);
        }
    }

    private async Task RunMenuCheck()
    {
        await RefreshInsightsAsync();
        PlannerMessage = Analysis is null
            ? "Add recipes before running How is my menu?"
            : $"How is my menu? {Analysis.OverallStatus}. Review nutrition and component guidance below.";
    }

    private void MarkActiveWeekComplete()
    {
        if (!CompletedWeeks.Contains(ActiveWeek))
        {
            CompletedWeeks.Add(ActiveWeek);
            CompletedWeeks.Sort();
        }

        MenuStatus = CompletedWeeks.Count >= 6 ? "Completed" : "Draft";
        PlannerMessage = $"Week {ActiveWeek} marked complete.";
    }

    private void MakeActiveWeekIncomplete()
    {
        CompletedWeeks.Remove(ActiveWeek);
        MenuStatus = "Incomplete";
        PlannerMessage = $"Week {ActiveWeek} marked incomplete.";
    }

    private string GetCalendarPlaceholder(MealSlot mealSlot, string componentKey)
    {
        var component = BaseMealComponents.FirstOrDefault(item => item.Key == componentKey);
        var componentName = string.IsNullOrWhiteSpace(component.Key) ? componentKey : component.Label;
        if (SelectedCell is not null && SelectedCell.Value.MealSlot == mealSlot && SelectedCell.Value.ComponentKey == componentKey)
        {
            return $"Choose {componentName.ToLowerInvariant()}";
        }

        return component.Optional ? $"{componentName} (optional)" : componentName;
    }

