@page "/menus/new"
@inject PythonApiClient Api
@inject NavigationManager Navigation
@inject MenuDraftService Drafts
@inject IJSRuntime Js
@inject AppModeService AppMode
@implements IAsyncDisposable

<div class="grid planner-root" style="gap: 18px" tabindex="0" @onkeydown="HandlePlannerKeyDown" @ref="_plannerRoot">
    <section class="section planner-command">
        <div class="planner-command-header">
            <div>
                <div class="eyebrow">Weekly planning</div>
                <h3 style="margin: 6px 0 0">Build weekly menu</h3>
            </div>
            <div class="hero-actions">
                <button type="button" class="secondary-button" @onclick="RunMenuCheck">Check nutrition</button>
                @if (CompletedWeeks.Contains(ActiveWeek))
                {
                    <button type="button" class="secondary-button" @onclick="MakeActiveWeekIncomplete">Reopen week</button>
                }
                else
                {
                    <button type="button"
                            class="button"
                            @onclick="MarkActiveWeekComplete"
                            disabled="@(!CanMarkActiveWeekComplete)"
                            title="@WeekCompletionHint">
                        Mark week complete
                    </button>
                }
                <button type="button" class="button" @onclick="SaveMenu" disabled="@Saving">@(Saving ? "Saving cycle..." : "Save cycle")</button>
                <button type="button" class="secondary-button" @onclick="ClearWeek">Clear week</button>
                <div class="clear-day-action" aria-label="Clear a service day">
                    <label class="clear-day-control">
                        <span>Day to clear</span>
                        <InputSelect class="input compact-input" aria-label="Day to clear" @bind-Value="ClearDayIndex" disabled="@(!VisibleDayIndices.Any())">
                            @foreach (var option in DaySwapOptions)
                            {
                                <option value="@option.Index">@option.Label</option>
                            }
                        </InputSelect>
                    </label>
                    <button type="button" class="secondary-button" @onclick="ClearSelectedDay" disabled="@(!VisibleDayIndices.Any())">Clear day</button>
                </div>
            </div>
        </div>

        <div class="planner-command-row">
            <label>
                <div class="small muted">Menu name</div>
                <InputText class="input compact-input" @bind-Value="MenuName" />
            </label>
            <label>
                <div class="small muted">Start date</div>
                <InputDate class="input compact-input" @bind-Value="StartDate" @bind-Value:after="OnStartDateChanged" />
            </label>
            <label>
                <div class="small muted">Menu coverage</div>
                <InputSelect class="input compact-input" @bind-Value="MenuCoverage" @bind-Value:after="OnMenuCoverageChanged">
                    @foreach (var option in MealCoverageOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </InputSelect>
            </label>
        </div>

        <div class="planner-cycle-row">
            <div class="planner-control-panel">
                <div class="small muted">Week in cycle</div>
                <div class="segmented-control cycle-tabs">
                    @for (var week = 1; week <= 6; week++)
                    {
                        var selectedWeek = week;
                        <button type="button" aria-label="View Week @selectedWeek" class="@(ActiveWeek == selectedWeek ? "active" : "")" @onclick="() => SetActiveWeek(selectedWeek)">Week @selectedWeek</button>
                    }
                </div>
            </div>
            <div class="planner-control-panel service-pattern-panel">
                <div class="small muted">Service pattern</div>
                <div class="segmented-control compact">
                    <button type="button" class="@(DaysPerWeek == 5 ? "active" : "")" @onclick="() => SetDaysPerWeek(5)">5-day</button>
                    <button type="button" class="@(DaysPerWeek == 7 ? "active" : "")" @onclick="() => SetDaysPerWeek(7)">7-day</button>
                </div>
            </div>
            <div class="planner-control-panel cycle-action-panel">
                <div class="small muted">Whole-week actions</div>
                <div class="cycle-action-row">
                    <InputSelect class="input compact-input" aria-label="Target cycle week" @bind-Value="CycleActionTargetWeek">
                        @for (var week = 1; week <= 6; week++)
                        {
                            if (week != ActiveWeek)
                            {
                                <option value="@week">Week @week</option>
                            }
                        }
                    </InputSelect>
                    <button type="button" class="secondary-button" @onclick="CopyActiveWeekToTarget">Copy Week @ActiveWeek</button>
                    <button type="button" class="secondary-button" @onclick="SwapActiveWeekWithTarget">Swap Week @ActiveWeek</button>
                </div>
            </div>
        </div>

        <details class="setup-details">
            <summary>More setup fields: contracts, cycle, status, service days, tags, and day swap</summary>
            <div class="setup-grid">
                <label>
                    <div class="small muted">Contract name</div>
                    @if (IsProvider)
                    {
                        <input class="input" value="@ContractName" disabled />
                    }
                    else
                    {
                        <InputSelect class="input" @bind-Value="ContractName">
                            @foreach (var option in ContractOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </InputSelect>
                    }
                </label>
                <label>
                    <div class="small muted">Program type</div>
                    <InputSelect class="input" @bind-Value="ProgramType">
                        @foreach (var option in ProgramTypeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Meal Type</div>
                    <InputSelect class="input" @bind-Value="PrimaryMealType">
                        @foreach (var option in MealTypeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Diet type</div>
                    <InputSelect class="input" @bind-Value="DietType">
                        @foreach (var option in DietTypeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Cycle</div>
                    <InputSelect class="input" @bind-Value="Cycle">
                        @foreach (var option in CycleOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Menu Duration/Type</div>
                    <InputSelect class="input" @bind-Value="MenuDurationType">
                        @foreach (var option in MenuDurationTypeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Meal Served Format</div>
                    <InputSelect class="input" @bind-Value="MealServedFormat">
                        @foreach (var option in MealServedFormatOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Status</div>
                    <InputSelect class="input" @bind-Value="MenuStatus">
                        @foreach (var option in MenuStatusOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Cycle start date</div>
                    <InputDate class="input" @bind-Value="CycleStartDate" />
                </label>
                <label>
                    <div class="small muted">Cycle end date</div>
                    <InputDate class="input" @bind-Value="CycleEndDate" />
                </label>
                <label>
                    <div class="small muted">Status date</div>
                    <InputDate class="input" @bind-Value="StatusDate" />
                </label>
                <label>
                    <div class="small muted">Submitted to NYC Aging</div>
                    <InputDate class="input" @bind-Value="SubmittedToNycAgingOn" />
                </label>
                <label>
                    <div class="small muted">Submitted to</div>
                    <InputText class="input" @bind-Value="SubmittedTo" />
                </label>
                <label>
                    <div class="small muted">Nutrition Advisor</div>
                    <InputSelect class="input" @bind-Value="NutritionAdvisor">
                        @foreach (var option in NutritionAdvisorOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <div class="small muted">Created by</div>
                    <InputText class="input" @bind-Value="CreatedBy" />
                </label>
            </div>

            <div class="setup-options">
                <div>
                    <div class="small muted">Select contract(s)</div>
                    @if (IsProvider)
                    {
                        <span class="status-badge brand">@AppMode.ProviderContract</span>
                    }
                    else
                    {
                        <div class="checkbox-row">
                            @foreach (var contract in ContractOptions)
                            {
                                var currentContract = contract;
                                <label class="checkbox-chip">
                                    <input type="checkbox" checked="@SelectedContracts.Contains(currentContract)" @onchange="eventArgs => SetContract(currentContract, eventArgs.Value is bool value && value)" />
                                    <span>@currentContract</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                <div>
                    <div class="small muted">Days of service</div>
                    <div class="checkbox-row">
                        @for (var index = 0; index < ServiceDayLabels.Length; index++)
                        {
                            var currentIndex = index;
                            <label class="checkbox-chip">
                                <input type="checkbox" checked="@ServiceDaysEnabled[currentIndex]" @onchange="eventArgs => SetServiceDay(currentIndex, eventArgs.Value is bool value && value)" />
                                <span>@ServiceDayLabels[currentIndex]</span>
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <div class="small muted">Swap days within Week @ActiveWeek</div>
                    <div class="swap-row">
                        <InputSelect class="input compact-input" aria-label="Swap from day" @bind-Value="SwapDayFrom">
                            @foreach (var option in DaySwapOptions)
                            {
                                <option value="@option.Index">@option.Label</option>
                            }
                        </InputSelect>
                        <InputSelect class="input compact-input" aria-label="Swap to day" @bind-Value="SwapDayTo">
                            @foreach (var option in DaySwapOptions)
                            {
                                <option value="@option.Index">@option.Label</option>
                            }
                        </InputSelect>
                        <button type="button" class="secondary-button" @onclick="SwapSelectedDays">Swap days</button>
                    </div>
                </div>
                <div>
                    <div class="small muted">Menu Tags</div>
                    <div class="checkbox-row">
                        @foreach (var tag in MenuTagOptions)
                        {
                            var currentTag = tag;
                            <label class="checkbox-chip">
                                <input type="checkbox" checked="@SelectedMenuTags.Contains(currentTag)" @onchange="eventArgs => SetMenuTag(currentTag, eventArgs.Value is bool value && value)" />
                                <span>@currentTag</span>
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <div class="small muted">Completed weeks</div>
                    <div class="tag-list">
                        @for (var week = 1; week <= 6; week++)
                        {
                            <span class="status-badge @(CompletedWeeks.Contains(week) ? "good" : "")">Week @week @(CompletedWeeks.Contains(week) ? "complete" : "open")</span>
                        }
                    </div>
                </div>
            </div>
        </details>

        <div class="planner-helper">
            <span class="muted small">@ActiveWeekStart.ToString("MMM d") to @EndDate.ToString("MMM d") · @GetServiceDaySummary() · Esc clears selection · Backspace removes · 1-6 switches weeks</span>
            @if (!string.IsNullOrWhiteSpace(PlannerMessage))
            {
                <span class="status-badge warn">@PlannerMessage</span>
            }
            else if (!CompletedWeeks.Contains(ActiveWeek) && !CanMarkActiveWeekComplete)
            {
                <span class="muted small">@WeekCompletionHint</span>
            }
        </div>
    </section>

    <div class="columns planner-layout @(DaysPerWeek == 7 ? "planner-layout-seven-day" : string.Empty)">
        <section class="section calendar-panel">
            <div class="section-header">
                <div>
                    <h3 style="margin-bottom: 6px">@MealLabel(SelectedMealView) planning board</h3>
                    <p class="muted" style="margin: 0">
                        Plan the selected meal across the week, then place recipes into the component rows.
                    </p>
                </div>
                <div class="hero-actions">
                    <span class="status-badge brand">Week @ActiveWeek</span>
                    <span class="status-badge brand">@DaysPerWeek-day cycle</span>
                </div>
            </div>
            <div class="planner-alerts">
                @if (Analysis is null)
                {
                    <div class="empty-state" style="margin-top: 0; padding: 12px 14px">Nutrition checks will appear after you place recipes.</div>
                }
                else
                {
                    @foreach (var warning in PlannerWarnings)
                    {
                        <span class="status-badge @(warning.Status == "pass" ? "good" : warning.Status == "warn" ? "warn" : "bad")">@warning.Label</span>
                    }
                }
            </div>

            <div class="meal-board-tabs">
                @foreach (var mealView in VisibleMealViews)
                {
                    <button type="button" class="meal-board-tab @(SelectedMealView == mealView ? "active" : "")" @onclick="() => SetSelectedMealView(mealView)">@MealLabel(mealView)</button>
                }
                <div class="meal-board-help muted small">Select a component cell, then add a recipe from the gallery.</div>
            </div>

            <div class="calendar-scroll">
                <div class="calendar-grid" style="grid-template-columns: 140px repeat(@VisibleDayCount, minmax(145px, 1fr))">
                    <div class="calendar-corner"></div>
                    @foreach (var dayIndex in VisibleDayIndices)
                    {
                        var date = DateForDayIndex(dayIndex);
                        <div class="calendar-day-header">
                            <div class="day-label">@date.ToString("ddd")</div>
                            <div class="date-label">@date.ToString("MMM d")</div>
                        </div>
                    }

                    @foreach (var component in MealComponentsFor(SelectedMealView))
                    {
                        var currentComponent = component;
                        <div class="meal-label @MealSlotClass(SelectedMealView)" title="@component.Description">
                            <div>
                                <div class="meal-label-title">@component.Label</div>
                                <div class="meal-label-subtitle">@component.HelpText</div>
                            </div>
                        </div>
                        @foreach (var dayIndex in VisibleDayIndices)
                        {
                            var currentDayIndex = dayIndex;
                            var selectedMealSlot = MealViewToSlot(SelectedMealView);
                            var assigned = GetCellRecipe(currentDayIndex, selectedMealSlot, currentComponent.Key);
                            var isActive = SelectedCell?.DayIndex == currentDayIndex && SelectedCell?.MealSlot == selectedMealSlot && SelectedCell?.ComponentKey == currentComponent.Key;
                            var dropKey = $"{SelectedMealView.ToString().ToLowerInvariant()}_{currentComponent.Key}";
                            <div class="calendar-cell @MealSlotClass(selectedMealSlot) @(isActive ? "active" : "") @(HoveredCell?.DayIndex == currentDayIndex && HoveredCell?.MealSlot == selectedMealSlot && HoveredCell?.ComponentKey == currentComponent.Key ? "drop-target" : "") @(assigned is not null ? "filled" : "")"
                                 role="button"
                                 tabindex="0"
                                 data-testid="@CellTestId(ActiveWeek, currentDayIndex, selectedMealSlot, currentComponent.Key)"
                                 @onclick="() => SelectCell(currentDayIndex, selectedMealSlot, currentComponent.Key)"
                                 data-dnd-select-cell="true"
                                 data-dnd-dropzone="true"
                                 data-day-index="@currentDayIndex"
                                 data-meal-slot="@dropKey"
                                 draggable="false"
                                 @ondragenter="() => SetHoverCell(currentDayIndex, selectedMealSlot, currentComponent.Key)"
                                 @ondragleave="() => ClearHoverCell()"
                                 @ondragover:preventDefault="true">
                                @if (assigned is null)
                                {
                                    <div class="calendar-placeholder">
                                        <span class="meal-badge @MealSlotClass(selectedMealSlot)">@component.ShortLabel</span>
                                        <span>@GetCalendarPlaceholder(selectedMealSlot, currentComponent.Key)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="scheduled-card"
                                         data-testid="@ScheduledCardTestId(ActiveWeek, currentDayIndex, selectedMealSlot, currentComponent.Key)"
                                         data-dnd-payload="@($"scheduled:{assigned.RecipeId}:{currentDayIndex}:{SelectedMealView.ToString().ToLowerInvariant()}:{currentComponent.Key}")"
                                         draggable="true">
                                        <span class="meal-badge @MealSlotClass(selectedMealSlot)">@component.ShortLabel</span>
                                        <strong>@assigned.RecipeName</strong>
                                        <div class="muted small">@assigned.Category · @assigned.MealType</div>
                                        <div class="scheduled-card-actions">
                                            <div class="drag-handle card-drag-handle" aria-hidden="true">↕ move</div>
                                            <button type="button" class="secondary-button tiny-button" @onclick:stopPropagation="true" @onclick="() => ShowRecipePreview(assigned)">View</button>
                                            @if (!currentComponent.Key.Equals("alternate", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button" class="secondary-button tiny-button" @onclick:stopPropagation="true" @onclick="() => MarkAsAlternate(currentDayIndex, selectedMealSlot, currentComponent.Key)">Alternate</button>
                                            }
                                            <button type="button" class="secondary-button tiny-button" @onclick:stopPropagation="true" @onclick="() => RemoveRecipe(currentDayIndex, selectedMealSlot, currentComponent.Key)">Remove</button>
                                        </div>
                                        <div class="copy-item-control" data-dnd-no-drag="true" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    class="copy-item-toggle"
                                                    data-testid="@CopyToggleTestId(currentDayIndex, selectedMealSlot, currentComponent.Key)"
                                                    aria-expanded="@(IsCopyItemOpen(currentDayIndex, selectedMealSlot, currentComponent.Key, assigned) ? "true" : "false")"
                                                    title="Copy this recipe to the same day, meal, and component in another cycle week"
                                                    @onclick="() => ToggleCopyItem(currentDayIndex, selectedMealSlot, currentComponent.Key, assigned)">
                                                Copy to week
                                            </button>
                                            @if (IsCopyItemOpen(currentDayIndex, selectedMealSlot, currentComponent.Key, assigned))
                                            {
                                                <div class="copy-item-week-list" aria-label="Choose a target cycle week">
                                                @for (var targetWeek = 1; targetWeek <= 6; targetWeek++)
                                                {
                                                    var copyWeek = targetWeek;
                                                    if (copyWeek != ActiveWeek)
                                                    {
                                                        <button type="button"
                                                                aria-label="Copy @assigned.RecipeName to Week @copyWeek"
                                                                data-testid="@CopyWeekTestId(currentDayIndex, selectedMealSlot, currentComponent.Key, copyWeek)"
                                                                class="secondary-button tiny-button"
                                                                @onclick="() => CopyScheduledItemToWeek(currentDayIndex, selectedMealSlot, currentComponent.Key, assigned, copyWeek)">
                                                            Week @copyWeek
                                                        </button>
                                                    }
                                                }
                                                </div>
                                            }
                                        </div>
                                        @if (LastCopyConfirmation is { } copyConfirmation
                                            && IsLastCopiedItem(currentDayIndex, selectedMealSlot, currentComponent.Key, assigned))
                                        {
                                            <div class="copy-item-confirmation" role="status">
                                                <span>Copied to Week @copyConfirmation.TargetWeek.</span>
                                                <button type="button" class="text-button" @onclick:stopPropagation="true" @onclick="() => SetActiveWeek(copyConfirmation.TargetWeek)">View week</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </section>

        <div class="grid planner-sidebar" style="gap: 18px">
            <section class="section planner-gallery-panel">
                <div class="section-header planner-gallery-header">
                    <div>
                        <h3 style="margin-bottom: 6px">Recipe gallery</h3>
                    </div>
                    <input class="input compact-input" @bind="SearchText" @bind:event="oninput" placeholder="Search recipes" />
                </div>
                <div class="planner-gallery-scroll" data-testid="recipe-gallery-scroll">
                    <div class="gallery-filter-grid">
                        <label>
                            <div class="small muted">Recipe View</div>
                            <InputSelect class="input compact-input" @bind-Value="RecipeViewMode">
                                @foreach (var option in RecipeViewOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            <div class="small muted">Filter By</div>
                            <InputSelect class="input compact-input" @bind-Value="RecipeFilterGroup" @bind-Value:after="OnRecipeFilterGroupChanged">
                                @foreach (var option in RecipeFilterGroupOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            <div class="small muted">Filter value</div>
                            <InputSelect class="input compact-input" @bind-Value="RecipeFilterValue">
                                @foreach (var option in RecipeFilterValueOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </label>
                        <button type="button" class="secondary-button gallery-add-filter" @onclick="AddGalleryFilter" disabled="@(!CanAddGalleryFilter)">Add filter</button>
                        <label class="checkbox-chip gallery-favorite-filter">
                            <input type="checkbox" @bind="FavoritesOnly" />
                            <span>My Favorites</span>
                        </label>
                    </div>
                    @if (SelectedGalleryFilters.Any())
                    {
                        <div class="selected-filter-row" aria-label="Selected recipe filters">
                            <span class="small muted">Matching all:</span>
                            @foreach (var filter in SelectedGalleryFilters)
                            {
                                var selectedFilter = filter;
                                <button type="button" class="filter-chip" title="Remove filter" @onclick="() => RemoveGalleryFilter(selectedFilter)">@filter.Group: @filter.Value <span aria-hidden="true">×</span></button>
                            }
                            <button type="button" class="text-button small" @onclick="ClearGalleryFilters">Clear filters</button>
                        </div>
                    }

                    <div class="section-inner">
                        <div class="section-header">
                            <h4>@GallerySectionTitle</h4>
                            <div class="hero-actions">
                                @if (!string.IsNullOrWhiteSpace(CurrentGalleryContext))
                                {
                                    <span class="status-badge brand">@CurrentGalleryContext</span>
                                }
                                <span class="status-badge brand">@GalleryRecipes.Count() recipes</span>
                            </div>
                        </div>
                        <div class="toggle-row">
                            <button type="button" class="@(RecipeGalleryMode == RecommendedGalleryMode ? "button" : "ghost-button")" @onclick:stopPropagation="true" @onclick="() => SetRecipeGalleryMode(RecommendedGalleryMode)">Recommended</button>
                            <button type="button" class="@(RecipeGalleryMode == BreakfastMeal ? "button" : "ghost-button")" @onclick:stopPropagation="true" @onclick="() => SetRecipeGalleryMode(BreakfastMeal)">Breakfast</button>
                            <button type="button" class="@(RecipeGalleryMode == LunchMeal ? "button" : "ghost-button")" @onclick:stopPropagation="true" @onclick="() => SetRecipeGalleryMode(LunchMeal)">Lunch</button>
                            <button type="button" class="@(RecipeGalleryMode == DinnerMeal ? "button" : "ghost-button")" @onclick:stopPropagation="true" @onclick="() => SetRecipeGalleryMode(DinnerMeal)">Dinner</button>
                            <button type="button" class="@(RecipeGalleryMode == AllGalleryMode ? "button" : "ghost-button")" @onclick:stopPropagation="true" @onclick="() => SetRecipeGalleryMode(AllGalleryMode)">All</button>
                        </div>
                        <div class="table-list planner-recipe-list compact-recipe-picker">
                            @foreach (var recipe in VisibleGalleryRecipes)
                            {
                                <div class="recipe-picker-row" role="button" tabindex="0" @onclick="() => ShowRecipePreview(recipe)" data-dnd-select-recipe="true" data-dnd-payload="@($"recipe:{recipe.RecipeId}")" data-testid="@($"gallery-recipe-{recipe.RecipeId}")" draggable="true">
                                    <div class="recipe-picker-main">
                                        <div class="table-title-row">
                                            <strong>@recipe.RecipeName</strong>
                                            @if (recipe.IsFavorite)
                                            {
                                                <span class="recipe-favorite-badge">Favorite</span>
                                            }
                                        </div>
                                        <div class="recipe-picker-meta">@recipe.MealType · @recipe.Category · @(recipe.ServingSize ?? "1 serving")</div>
                                        <div class="recipe-picker-tags">
                                            @foreach (var tag in GalleryTags(recipe))
                                            {
                                                <span class="tag-chip">@tag</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="recipe-picker-nutrition" aria-label="Recipe nutrition">
                                        <span><strong>@recipe.Calories</strong> kcal</span>
                                        <span><strong>@recipe.SodiumMg</strong> mg sodium</span>
                                        <span><strong>@recipe.ProteinG</strong> g protein</span>
                                        <span><strong>@recipe.FiberG</strong> g fiber</span>
                                    </div>
                                    <div class="recipe-picker-actions">
                                        <span class="drag-handle card-drag-handle" aria-hidden="true">Drag</span>
                                        <button type="button" class="secondary-button tiny-button" @onclick:stopPropagation="true" @onclick="() => ShowRecipePreview(recipe)">View</button>
                                        <button type="button" class="button tiny-button" data-testid="@($"gallery-add-{recipe.RecipeId}")" disabled="@(FindPlacementTarget(recipe) is null)" @onclick:stopPropagation="true" @onclick="() => AssignRecipe(recipe)">@AssignmentButtonLabel(recipe, shortLabel: true)</button>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (HasMoreGalleryRecipes)
                        {
                            <div class="hero-actions" style="justify-content: center">
                                <button type="button" class="ghost-button" @onclick="ShowMoreGalleryRecipes">Show more recipes</button>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="section planner-details-panel" data-testid="planner-details">
                <div class="planner-details-header">
                    <div>
                        <h3>Planner details</h3>
                        <div class="planner-target-line @(SelectedCell is null ? "muted" : "")" data-testid="selected-target">
                            @(SelectedCell is null ? "No slot selected. Suggestions will use the next compatible open slot." : $"Selected: {SelectedCellLabel}")
                        </div>
                    </div>
                    <div class="planner-details-tabs" role="tablist" aria-label="Planner details views">
                        <button type="button" role="tab" aria-selected="@(PlannerSidebarTab == PlannerInsightsTab)" class="@(PlannerSidebarTab == PlannerInsightsTab ? "active" : "")" @onclick="() => SetPlannerSidebarTab(PlannerInsightsTab)">Insights</button>
                        <button type="button" role="tab" aria-selected="@(PlannerSidebarTab == PlannerTrayTab)" class="@(PlannerSidebarTab == PlannerTrayTab ? "active" : "")" @onclick="() => SetPlannerSidebarTab(PlannerTrayTab)">Placed recipes</button>
                        <button type="button" role="tab" aria-selected="@(PlannerSidebarTab == PlannerSummaryTab)" class="@(PlannerSidebarTab == PlannerSummaryTab ? "active" : "")" @onclick="() => SetPlannerSidebarTab(PlannerSummaryTab)">Summary</button>
                    </div>
                </div>

                <div class="planner-detail-content">
                @if (PlannerSidebarTab == PlannerInsightsTab && Analysis is not null)
                {
                    <section class="planner-detail-section">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">Suggested next</h3>
                        <p class="muted" style="margin: 0">
                                @(LastPlacedRecipe is null
                                    ? "Assign a recipe to see targeted suggestions here."
                                    : $"Based on {LastPlacedRecipe.RecipeName}, these recipes are a good next step.")
                            </p>
                        </div>
                    </div>
                    <div class="status-stack">
                        @foreach (var item in RecommendedItems.Take(4))
                        {
                            <div class="status-row planner-suggestion-row">
                                <div>
                                    <strong>@item.Recipe.RecipeName</strong>
                                    <div class="muted small">@item.Recipe.MealType · @item.Recipe.Category</div>
                                    <div class="muted small">@string.Join(" · ", item.Reasons)</div>
                                </div>
                                <div class="planner-suggestion-actions">
                                    <span class="status-badge brand">Match @item.Score.ToString("0.0")</span>
                                    <button type="button" class="button small-button" data-testid="@($"suggested-add-{item.Recipe.RecipeId}")" disabled="@(FindPlacementTarget(item.Recipe) is null)" @onclick="() => SelectRecipeFromGallery(item.Recipe)">@AssignmentButtonLabel(item.Recipe)</button>
                                </div>
                            </div>
                        }
                    </div>
                    </section>

                <div class="section-header nutrition-compact-heading">
                    <strong>Nutrition analysis</strong>
                    <button type="button" class="secondary-button small-button" @onclick="OpenNutritionReview">Open full view</button>
                </div>
                <NutritionPanel Totals="@Analysis.Totals" Statuses="@Analysis.Statuses" MealRequirements="@Analysis.MealRequirements" OverallStatus="@Analysis.OverallStatus" OnRecipeSelected="SelectRecipeFromGallery" />
                    <section class="planner-detail-section">
                    <h3>Rule-based revisions</h3>
                    <div class="section-inner">
                        @foreach (var group in RevisionSuggestions)
                        {
                            <div>
                                <div class="status-badge brand" style="margin-bottom: 8px">@group.Key</div>
                                <div class="status-stack">
                                    @foreach (var item in group.Value)
                                    {
                                        <div class="status-row planner-suggestion-row">
                                            <div>
                                                <strong>@item.Recipe.RecipeName</strong>
                                                <div class="muted small">@string.Join(" · ", item.Reasons)</div>
                                            </div>
                                            <button type="button" class="secondary-button tiny-button" disabled="@(FindPlacementTarget(item.Recipe) is null)" @onclick="() => SelectRecipeFromGallery(item.Recipe)">@AssignmentButtonLabel(item.Recipe)</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    </section>

                    <section class="planner-detail-section">
                    <h3>Similar historical menus</h3>
                    <div class="status-stack">
                        @foreach (var menu in SimilarMenus)
                        {
                            <div class="status-row">
                                <div>
                                    <strong>@menu.Name</strong>
                                    <div class="muted small">@menu.ServiceDate.ToString("MMM d, yyyy")</div>
                                </div>
                                <StatusPill Status="@(menu.PassesNutrition ? "good" : "warn")" Label="@menu.Similarity.ToString("0.00")" />
                            </div>
                        }
                    </div>
                    </section>
                }
                else if (PlannerSidebarTab == PlannerInsightsTab)
                {
                    <div class="empty-state planner-empty-state">
                        Select a component cell, then add a recipe from the gallery. Nutrition checks, suggestions, and similar menus will appear here after the first recipe is placed.
                    </div>
                }

                @if (PlannerSidebarTab == PlannerTrayTab)
                {
                    <section class="planner-detail-section">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">Recipes placed in Week @ActiveWeek</h3>
                            <p class="muted" style="margin: 0">Select an item to return to its calendar cell, move it, or remove it.</p>
                        </div>
                        <StatusPill Status="brand" Label="@($"{CurrentWeekItems.Count()} placed")" />
                    </div>
                    <div class="recipe-grid" style="margin-top: 18px">
                        @foreach (var item in CurrentWeekItems)
                        {
                            <div class="recipe-card" role="button" tabindex="0" data-dnd-select-recipe="true" data-dnd-payload="@($"tray:{item.Recipe.RecipeId}:{item.DayIndex}:{item.MealSlot.ToString().ToLowerInvariant()}:{item.ComponentKey}")" draggable="true">
                                <div class="recipe-card-head">
                                    <div>
                                        <strong>@item.Recipe.RecipeName</strong>
                                        <div class="muted small">Day @(item.DayIndex + 1) · @MealLabel(item.MealSlot) · @item.ComponentKey</div>
                                    </div>
                                    <div class="hero-actions">
                                        <button type="button" class="ghost-button tiny-button" @onclick:stopPropagation="true" @onclick="() => SelectTrayItem(item)">Go</button>
                                        <button type="button" class="ghost-button tiny-button" @onclick:stopPropagation="true" @onclick="() => RemoveTrayItem(item)">Remove</button>
                                    </div>
                                </div>
                                <div class="drag-row">
                                    <div class="drag-handle card-drag-handle" aria-hidden="true">↕ move</div>
                                </div>
                                <div class="tag-list">
                                    @foreach (var tag in item.Recipe.Tags.Take(3))
                                    {
                                        <span class="tag-chip">@tag</span>
                                    }
                                </div>
                                <div class="nutrition-strip">
                                    <span>@item.Recipe.SodiumMg mg sodium</span>
                                    <span>@item.Recipe.ProteinG g protein</span>
                                </div>
                            </div>
                        }
                        @if (!CurrentWeekItems.Any())
                        {
                            <div class="empty-state">No recipes placed in this week yet.</div>
                        }
                    </div>
                    </section>
                }

                @if (PlannerSidebarTab == PlannerSummaryTab)
                {
                    <section class="planner-detail-section">
                    <div class="section-header">
                        <div>
                            <h3 style="margin-bottom: 6px">Week summary</h3>
                            <p class="muted" style="margin: 0">A quick glance at the current menu mix.</p>
                        </div>
                    </div>
                    <div class="summary-grid">
                        @foreach (var item in BuildWeeklySummary())
                        {
                            <div class="summary-card">
                                <div class="summary-value">@item.Value</div>
                                <div class="muted small">@item.Key</div>
                            </div>
                        }
                    </div>
                    </section>
                }
                </div>
            </section>
        </div>
    </div>

    @if (PreviewRecipe is not null)
    {
        <div class="app-modal-backdrop" role="presentation" @onclick="CloseRecipePreview">
            <section class="app-modal recipe-preview-modal" role="dialog" aria-modal="true" aria-labelledby="recipe-preview-title" @onclick:stopPropagation="true">
                <div class="section-header">
                    <div>
                        <div class="eyebrow">Approved recipe</div>
                        <h2 id="recipe-preview-title">@PreviewRecipe.RecipeName</h2>
                        <p class="muted">@PreviewRecipe.MealType · @PreviewRecipe.Category · @(PreviewRecipe.ServingSize ?? "1 serving")</p>
                    </div>
                    <button type="button" class="secondary-button" @onclick="CloseRecipePreview">Close</button>
                </div>
                <div class="recipe-preview-grid">
                    <div>
                        <h3>Ingredients</h3>
                        @if (PreviewRecipe.Ingredients.Any())
                        {
                            <ul class="compact-list">
                                @foreach (var ingredient in PreviewRecipe.Ingredients)
                                {
                                    <li>@ingredient</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="muted">No ingredient list is available.</p>
                        }
                    </div>
                    <div>
                        <h3>Directions</h3>
                        @if (PreviewRecipe.Instructions.Any())
                        {
                            <ol class="compact-list">
                                @foreach (var instruction in PreviewRecipe.Instructions)
                                {
                                    <li>@instruction</li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p class="muted">No directions are available.</p>
                        }
                    </div>
                </div>
                <div class="recipe-preview-footer">
                    <div class="recipe-picker-nutrition">
                        <span><strong>@PreviewRecipe.Calories</strong> kcal</span>
                        <span><strong>@PreviewRecipe.SodiumMg</strong> mg sodium</span>
                        <span><strong>@PreviewRecipe.ProteinG</strong> g protein</span>
                        <span><strong>@PreviewRecipe.FiberG</strong> g fiber</span>
                    </div>
                    <button type="button" class="button" @onclick="() => AddPreviewRecipe()">Add to selected or next open slot</button>
                </div>
            </section>
        </div>
    }

    @if (ShowNutritionReview && Analysis is not null)
    {
        <div class="app-modal-backdrop nutrition-modal-backdrop" role="presentation" @onclick="CloseNutritionReview">
            <section class="app-modal nutrition-full-modal" role="dialog" aria-modal="true" aria-label="Full nutrition analysis" @onclick:stopPropagation="true">
                <div class="section-header">
                    <div>
                        <div class="eyebrow">Week @ActiveWeek</div>
                        <h2>Nutrition analysis</h2>
                        <p class="muted">Values are average totals per planned meal across the selected service days.</p>
                    </div>
                    <button type="button" class="secondary-button" @onclick="CloseNutritionReview">Close</button>
                </div>
                <NutritionPanel Totals="@Analysis.Totals" Statuses="@Analysis.Statuses" MealRequirements="@Analysis.MealRequirements" OverallStatus="@Analysis.OverallStatus" OnRecipeSelected="SelectRecipeFromGallery" />
            </section>
        </div>
    }
</div>

@code {
    [CascadingParameter] public AppRole CurrentRole { get; set; }

    private static readonly MealSlot[] MealSlots = [MealSlot.Breakfast, MealSlot.Lunch, MealSlot.Dinner];
    private const string BreakfastMeal = "breakfast";
    private const string LunchMeal = "lunch";
    private const string DinnerMeal = "dinner";
    private const string RecommendedGalleryMode = "recommended";
    private const string AllGalleryMode = "all";
    private const string PlannerInsightsTab = "insights";
    private const string PlannerTrayTab = "tray";
    private const string PlannerSummaryTab = "summary";
    private const string FullCoverageMode = "Breakfast + Lunch + Dinner";
    private static readonly string[] MealCoverageOptions = LegacyReferenceData.MenuCoverageOptions;
    private static DateTime StartOfServiceWeek(DateTime date)
    {
        var daysSinceMonday = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return date.Date.AddDays(-daysSinceMonday);
    }

    private static readonly MealComponentDefinition[] BaseMealComponents =
    [
        new("appetizer", "Appetizer", "Optional", true),
        new("entree", "Entrée", "Required: 1 serving", false),
        new("grains", "Grains", "Required: 1 serving", false),
        new("vegetable", "Vegetable", "Required: 1 serving non-starchy", false),
        new("fruit", "Fruit", "Required: 1 serving", false),
        new("dairy", "Dairy or non-dairy equivalent", "Required: 1 serving", false),
        new("juice-dessert", "Juice or Dessert", "Optional", true),
        new("condiments", "Condiments", "Optional", true),
        new("alternate", "Alternate", "Optional", true)
    ];
    private readonly Dictionary<int, Dictionary<int, Dictionary<MealSlot, Dictionary<string, RecipeDto?>>>> SchedulesByWeek = new();

    private string MenuName { get; set; } = "Weekly Menu";
    private string ContractName { get; set; } = LegacyReferenceData.ContractNames[0];
    private string ProgramType { get; set; } = "Congregate";
    private string PrimaryMealType { get; set; } = "Lunch";
    private string MenuCoverage { get; set; } = FullCoverageMode;
    private string DietType { get; set; } = "Regular";
    private string MenuFormat { get; set; } = "Weekly";
    private string MenuDurationType { get; set; } = "Regular";
    private string MealServedFormat { get; set; } = "Hot";
    private List<string> SelectedMenuTags { get; set; } = [];
    private string Cycle { get; set; } = "Spring/Summer";
    private DateTime? CycleStartDate { get; set; } = StartOfServiceWeek(DateTime.Today);
    private DateTime? CycleEndDate { get; set; } = StartOfServiceWeek(DateTime.Today).AddMonths(6);
    private string MenuStatus { get; set; } = "Draft";
    private DateTime? StatusDate { get; set; } = DateTime.Today;
    private DateTime? SubmittedToNycAgingOn { get; set; }
    private string NutritionAdvisor { get; set; } = LegacyReferenceData.NutritionAdvisors[0];
    private string SubmittedTo { get; set; } = "NYC Aging";
    private string CreatedBy { get; set; } = "Menu staff";
    private DateTime StartDate { get; set; } = StartOfServiceWeek(DateTime.Today);
    private int DaysPerWeek { get; set; } = 5;
    private int ActiveWeek { get; set; } = 1;
    private List<string> SelectedContracts { get; set; } = [LegacyReferenceData.ContractNames[0]];
    private List<int> CompletedWeeks { get; set; } = [];
    private string SearchText { get; set; } = string.Empty;
    private bool Saving { get; set; }
    private string? PlannerMessage { get; set; }
    private ElementReference _plannerRoot;
    private IJSObjectReference? _dragDropModule;
    private DotNetObjectReference<MenuPlanner>? _dotNetRef;
    private CellSelection? SelectedCell { get; set; }
    private CellSelection? HoveredCell { get; set; }
    private List<RecipeDto> AllRecipes { get; set; } = new();
    private List<RecommendationItemDto> RecommendedItems { get; set; } = new();
    private List<int> PopularRecipeIds { get; set; } = new();
    private MenuAnalysisDto? Analysis { get; set; }
    private List<SimilarMenuDto> SimilarMenus { get; set; } = new();
    private Dictionary<string, List<RecommendationItemDto>> RevisionSuggestions { get; set; } = new();
    private RecipeDto? LastPlacedRecipe { get; set; }
    private string RecipeGalleryMode { get; set; } = RecommendedGalleryMode;
    private string RecipeViewMode { get; set; } = "[All]";
    private string RecipeFilterGroup { get; set; } = "[Select]";
    private string RecipeFilterValue { get; set; } = "[Select]";
    private List<GalleryFilter> SelectedGalleryFilters { get; set; } = [];
    private bool FavoritesOnly { get; set; }
    private int GalleryVisibleCount { get; set; } = 12;
    private string PlannerSidebarTab { get; set; } = PlannerInsightsTab;
    private bool IsProvider => CurrentRole == AppRole.Provider;
    private bool[] ServiceDaysEnabled { get; set; } = [true, true, true, true, true, false, false];
    private string SelectedMealView { get; set; } = BreakfastMeal;
    private int SwapDayFrom { get; set; }
    private int SwapDayTo { get; set; } = 1;
    private int CycleActionTargetWeek { get; set; } = 2;
    private int ClearDayIndex { get; set; }
    private CopyItemSelection? OpenCopyItem { get; set; }
    private CopyConfirmation? LastCopyConfirmation { get; set; }
    private RecipeDto? PreviewRecipe { get; set; }
    private bool ShowNutritionReview { get; set; }

    private static readonly string[] ServiceDayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private static readonly string[] ProgramTypeOptions = LegacyReferenceData.ProgramTypes;
    private static readonly string[] DietTypeOptions = LegacyReferenceData.DietTypes;
    private static readonly string[] MealTypeOptions = LegacyReferenceData.MealTypes;
    private static readonly string[] MenuFormatOptions = ["Weekly", "Cycle", "3-month cycle", "6-month cycle"];
    private static readonly string[] MenuDurationTypeOptions = LegacyReferenceData.MenuDurationTypes;
    private static readonly string[] MealServedFormatOptions = LegacyReferenceData.MealServedFormats;
    private static readonly string[] MenuStatusOptions = LegacyReferenceData.MenuStatuses;
    private static readonly string[] CycleOptions = LegacyReferenceData.Cycles;
    private static readonly string[] ContractOptions = LegacyReferenceData.ContractNames;
    private static readonly string[] MenuTagOptions = LegacyReferenceData.MenuTags;
    private static readonly string[] NutritionAdvisorOptions = LegacyReferenceData.NutritionAdvisors;
    private static readonly string[] RecipeViewOptions = LegacyReferenceData.RecipeViewOptions;
    private static readonly string[] RecipeFilterGroupOptions = ["[Select]", "Meal Components", "Critical Nutrients", "Cuisines", "Dietary Restrictions"];

    private Dictionary<int, Dictionary<MealSlot, Dictionary<string, RecipeDto?>>> CurrentSchedule => SchedulesByWeek[ActiveWeek];

    private DateTime ActiveWeekStart => StartDate.AddDays((ActiveWeek - 1) * 7);

    private DateTime EndDate => ActiveWeekStart.AddDays(DaysPerWeek - 1);

    private List<int> VisibleDayIndices => Enumerable.Range(0, DaysPerWeek).Where(index => ServiceDaysEnabled[index]).ToList();

    private int VisibleDayCount => Math.Max(VisibleDayIndices.Count, 1);

    private DateTime DateForDayIndex(int dayIndex) => ActiveWeekStart.AddDays(dayIndex);

    private bool CanMarkActiveWeekComplete =>
        FindFirstMissingRequiredSlot() is null
        && Analysis?.OverallStatus.Equals("pass", StringComparison.OrdinalIgnoreCase) == true;

    private string WeekCompletionHint => FindFirstMissingRequiredSlot() is null
        ? Analysis is null
            ? "Run the nutrition check before completing this week."
            : "Resolve the nutrition and meal checks before completing this week."
        : "Fill every required component for each service day before completing this week.";

    private IEnumerable<string> VisibleMealViews => CoverageMealViews(MenuCoverage);

    private static IEnumerable<MealComponentDefinition> MealComponentsFor(string mealView) => BaseMealComponents;

    private IEnumerable<RecipeDto> GalleryRecipes =>
        AllRecipes.Where(recipe => !IsProvider || recipe.IsPublic)
                  .Where(recipe => recipe.Matches(SearchText))
                  .Where(MatchesRecipeView)
                  .Where(MatchesAllGalleryFilters)
                  .Where(MatchesSelectedComponent)
                  .Where(recipe => !FavoritesOnly || recipe.IsFavorite)
                  .Where(recipe => RecipeGalleryMode == AllGalleryMode || RecipeGalleryMode == RecommendedGalleryMode || recipe.MealType.Equals(RecipeGalleryMode, StringComparison.OrdinalIgnoreCase))
                  .OrderBy(recipe => RecommendedItems.Any(item => item.Recipe.RecipeId == recipe.RecipeId) ? 0 : 1)
                  .ThenBy(recipe => SelectedCell is not null && CanPlaceRecipeInComponent(recipe, SelectedCell.Value.ComponentKey) ? 0 : 1)
                  .ThenBy(recipe => recipe.RecipeName);

    private IEnumerable<RecipeDto> VisibleGalleryRecipes => GalleryRecipes.Take(GalleryVisibleCount);

    private bool HasMoreGalleryRecipes => GalleryRecipes.Count() > GalleryVisibleCount;

    private string GallerySectionTitle => RecipeGalleryMode switch
    {
        BreakfastMeal => "Breakfast recipes",
        LunchMeal => "Lunch recipes",
        DinnerMeal => "Dinner recipes",
        AllGalleryMode => "All recipes",
        _ => "Recommended recipes"
    };

    private IEnumerable<(string Label, string Status)> PlannerWarnings =>
        Analysis?.Statuses
            .Where(status => !status.Status.Equals("pass", StringComparison.OrdinalIgnoreCase))
            .Select(status => (
                Label: $"{status.NutrientKey.Replace("_", " ")}: {status.Status}",
                Status: status.Status))
            .Take(3) ?? [];

    private string? CurrentGalleryContext => SelectedCell is null
        ? null
        : $"{MealLabel(SelectedCell.Value.MealSlot)} · {SelectedCell.Value.ComponentKey} focus";

    private string SelectedCellLabel => SelectedCell is not { } selected
        ? string.Empty
        : $"{DateForDayIndex(selected.DayIndex):ddd, MMM d} · {MealLabel(selected.MealSlot)} · {ComponentLabel(selected.ComponentKey)}";

    private static IEnumerable<string> GalleryTags(RecipeDto recipe) =>
        recipe.Tags
            .Concat(recipe.NutrientClaims)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(3);

    private IEnumerable<(int Index, string Label)> DaySwapOptions =>
        VisibleDayIndices.Select(index => (index, $"{DateForDayIndex(index):ddd} {DateForDayIndex(index):MMM d}"));

    private bool CanAddGalleryFilter =>
        !RecipeFilterGroup.Equals("[Select]", StringComparison.OrdinalIgnoreCase)
        && !RecipeFilterValue.Equals("[Select]", StringComparison.OrdinalIgnoreCase)
        && !SelectedGalleryFilters.Any(filter => filter.Group.Equals(RecipeFilterGroup, StringComparison.OrdinalIgnoreCase)
                                                && filter.Value.Equals(RecipeFilterValue, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> RecipeFilterValueOptions
    {
        get
        {
            if (RecipeFilterGroup.Equals("[Select]", StringComparison.OrdinalIgnoreCase))
            {
                return ["[Select]"];
            }

            var group = LegacyReferenceData.RecipeFilterGroups
                .FirstOrDefault(item => item.Label.Equals(RecipeFilterGroup, StringComparison.OrdinalIgnoreCase));
            return group is null ? ["[Select]"] : ["[Select]", .. group.Options];
        }
    }

    private int PlacedCount => CurrentWeekItems.Count();

    private IEnumerable<MenuPlacement> CurrentWeekItems =>
        CurrentSchedule
            .Where(pair => VisibleDayIndices.Contains(pair.Key))
            .OrderBy(pair => pair.Key)
            .SelectMany(pair => pair.Value.OrderBy(slot => Array.IndexOf(MealSlots, slot.Key))
                                            .SelectMany(slot => slot.Value.OrderBy(component => ComponentOrder(component.Key))
                                                                        .Where(component => component.Value is not null)
                                                                        .Select(component => new MenuPlacement(pair.Key, slot.Key, component.Key, component.Value!))));

    private Dictionary<string, int> BuildWeeklySummary()
    {
        var items = CurrentWeekItems.ToList();
        var recipes = items.Select(item => item.Recipe).ToList();
        return new Dictionary<string, int>
        {
            ["Breakfast items"] = items.Count(item => item.MealSlot == MealSlot.Breakfast),
            ["Lunch items"] = items.Count(item => item.MealSlot == MealSlot.Lunch),
            ["Dinner items"] = items.Count(item => item.MealSlot == MealSlot.Dinner),
            ["Unique recipes"] = recipes.Select(item => item.RecipeId).Distinct().Count(),
            ["Entrees"] = recipes.Count(recipe => recipe.Category.Equals("entree", StringComparison.OrdinalIgnoreCase)),
            ["Sides"] = recipes.Count(recipe => recipe.Category.Equals("side", StringComparison.OrdinalIgnoreCase)),
            ["Grains"] = recipes.Count(recipe => recipe.Category.Equals("grain", StringComparison.OrdinalIgnoreCase)),
            ["Fruit/veg"] = recipes.Count(recipe => recipe.Category.Equals("fruit", StringComparison.OrdinalIgnoreCase) || recipe.Category.Equals("vegetable", StringComparison.OrdinalIgnoreCase))
        };
    }

    protected override async Task OnInitializedAsync()
    {
        EnsureScheduleShape();
        AllRecipes = await Api.GetRecipesAsync(true);
        var analytics = await Api.GetAnalyticsAsync();
        PopularRecipeIds = analytics.TopRecipes.Select(item => item.RecipeId).ToList();
        ApplyRoleDefaults();
        ApplyDraft(Drafts.Consume());
        ApplyRoleDefaults();
        await RefreshInsightsAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyRoleDefaults();
    }

    private void ApplyRoleDefaults()
    {
        if (!IsProvider)
        {
            return;
        }

        ContractName = AppMode.ProviderContract;
        CreatedBy = AppMode.ProviderContract;
        SelectedContracts = [AppMode.ProviderContract];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _dragDropModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/dragDropBridge.js?v=20260818-2");
            await _dragDropModule.InvokeVoidAsync("attachDragPayloads", _plannerRoot, _dotNetRef);
        }
        catch
        {
            _dragDropModule = null;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }

    private void EnsureScheduleShape()
    {
        for (var week = 1; week <= 6; week++)
        {
            if (!SchedulesByWeek.ContainsKey(week))
            {
                SchedulesByWeek[week] = CreateBlankSchedule();
                continue;
            }

            foreach (var dayIndex in Enumerable.Range(0, DaysPerWeek))
            {
                if (!SchedulesByWeek[week].ContainsKey(dayIndex))
                {
                    SchedulesByWeek[week][dayIndex] = CreateEmptyDay();
                }
            }
        }
    }

