        LastCopyConfirmation = new CopyConfirmation(dayIndex, mealSlot, componentKey, recipe.RecipeId, targetWeek);
        OpenCopyItem = null;
        PlannerMessage = $"Copied {recipe.RecipeName} to Week {targetWeek}, {ServiceDayLabels[dayIndex]} {MealLabel(mealSlot).ToLowerInvariant()}.";
