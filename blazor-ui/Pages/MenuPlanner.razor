    private void ApplyDraft(MenuCreateRequest? draft)
    {
        if (draft is null)
        {
            return;
        }

        MenuName = draft.Name;
        ContractName = draft.ContractName ?? ContractName;
        ProgramType = draft.ProgramType ?? ProgramType;
        if (!string.IsNullOrWhiteSpace(draft.MealType) && MealTypeOptions.Contains(draft.MealType))
        {
            PrimaryMealType = draft.MealType;
        }

        if (!string.IsNullOrWhiteSpace(draft.MenuCoverage))
        {
            MenuCoverage = draft.MenuCoverage;
        }
        else if (!string.IsNullOrWhiteSpace(draft.MealType) && MealCoverageOptions.Contains(draft.MealType))
        {
            MenuCoverage = draft.MealType;
        }
        DietType = draft.DietType ?? DietType;
        MenuFormat = draft.MenuFormat ?? MenuFormat;
        MenuDurationType = draft.MenuDurationType ?? MenuDurationType;
        MealServedFormat = draft.MealServedFormat ?? MealServedFormat;
        SelectedMenuTags = draft.MenuTags.Count > 0 ? [.. draft.MenuTags] : SelectedMenuTags;
        Cycle = draft.Cycle ?? Cycle;
        CycleStartDate = draft.CycleStartDate ?? draft.StartDate;
        CycleEndDate = draft.CycleEndDate ?? draft.EndDate;
        SelectedContracts = draft.Contracts.Any() ? [.. draft.Contracts] : SelectedContracts;
        CompletedWeeks = draft.CompletedWeeks.Any() ? [.. draft.CompletedWeeks] : CompletedWeeks;
        MenuStatus = draft.Status;
        StatusDate = draft.StatusDate ?? draft.StartDate;
        SubmittedToNycAgingOn = draft.SubmittedToNycAgingOn ?? SubmittedToNycAgingOn;
        NutritionAdvisor = draft.NutritionAdvisor ?? NutritionAdvisor;
        SubmittedTo = draft.SubmittedTo ?? SubmittedTo;
        CreatedBy = draft.CreatedBy ?? CreatedBy;
        StartDate = StartOfServiceWeek(draft.StartDate);
        DaysPerWeek = draft.DaysPerWeek is 5 or 7 ? draft.DaysPerWeek : 5;
        ActiveWeek = Math.Clamp(draft.CycleWeek, 1, 6);
        ServiceDaysEnabled = DaysPerWeek == 7
            ? [true, true, true, true, true, true, true]
            : [true, true, true, true, true, false, false];

        SelectedMealView = VisibleMealViews.FirstOrDefault() ?? BreakfastMeal;
        RecipeGalleryMode = SelectedMealView;

        ResizeSchedules(DaysPerWeek);
        EnsureScheduleShape();

        foreach (var item in draft.Items)
        {
            var recipe = AllRecipes.FirstOrDefault(candidate => candidate.RecipeId == item.RecipeId);
            if (recipe is null || item.DayIndex < 0 || item.DayIndex >= DaysPerWeek)
            {
                continue;
            }

            var planCellValue = item.MealSlot.Contains('_', StringComparison.Ordinal)
                ? item.MealSlot
                : $"{item.MealSlot}_{NormalizeComponentKey(item.ComponentKey ?? recipe.Category ?? "entree")}";

            if (TryParsePlanCell(planCellValue, out var planCell) && recipe.IsSuitableForMealSlot(planCell.MealSlot))
            {
                var componentKey = NormalizeComponentKey(planCell.ComponentKey);
                if (CurrentSchedule[item.DayIndex][planCell.MealSlot].ContainsKey(componentKey))
                {
                    CurrentSchedule[item.DayIndex][planCell.MealSlot][componentKey] = recipe;
                }
            }
        }

        PlannerMessage = $"Loaded draft from {draft.Name}.";
    }

