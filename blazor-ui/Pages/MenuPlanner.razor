    [JSInvokable]
    public async Task HandleExternalDrop(string payload, int dayIndex, string mealSlot)
    {
        if (!TryParsePlanCell(mealSlot, out var targetCell))
        {
            return;
        }

        var parts = (payload ?? string.Empty).Split(':', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2)
        {
            return;
        }

        if (!int.TryParse(parts[1], out var recipeId))
        {
            return;
        }

        var recipe = AllRecipes.FirstOrDefault(candidate => candidate.RecipeId == recipeId);
        if (recipe is null)
        {
            return;
        }

        if (!recipe.IsSuitableForMealSlot(targetCell.MealSlot))
        {
            PlannerMessage = $"{recipe.RecipeName} cannot be placed in {MealLabel(targetCell.MealSlot).ToLowerInvariant()}.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!CanPlaceRecipeInComponent(recipe, targetCell.ComponentKey))
        {
            PlannerMessage = $"{recipe.RecipeName} does not match the selected {ComponentLabel(targetCell.ComponentKey).ToLowerInvariant()} component.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (GetCellRecipe(dayIndex, targetCell.MealSlot, targetCell.ComponentKey) is { } existing
            && (parts.Length < 5 || !IsSameCell(parts, dayIndex, targetCell)))
        {
            PlannerMessage = $"{ComponentLabel(targetCell.ComponentKey)} already contains {existing.RecipeName}. Move or remove that recipe before adding another.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (parts.Length >= 5 && int.TryParse(parts[2], out var sourceDayIndex) && TryParsePlanCell($"{parts[3]}_{parts[4]}", out var sourceCell))
        {
            CurrentSchedule[sourceDayIndex][sourceCell.MealSlot][sourceCell.ComponentKey] = null;
        }

        CurrentSchedule[dayIndex][targetCell.MealSlot][targetCell.ComponentKey] = recipe;
        ReopenActiveWeekAfterChange();
        SelectedCell = null;
        LastPlacedRecipe = recipe;
        PlannerSidebarTab = PlannerInsightsTab;
        PlannerMessage = null;
        await RefreshInsightsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsSameCell(string[] payloadParts, int targetDayIndex, PlanCell targetCell)
    {
        return payloadParts.Length >= 5
            && int.TryParse(payloadParts[2], out var sourceDayIndex)
            && sourceDayIndex == targetDayIndex
            && TryParsePlanCell($"{payloadParts[3]}_{payloadParts[4]}", out var sourceCell)
            && sourceCell == targetCell;
    }

