    private static string MealSlotClass(MealSlot mealSlot) => mealSlot switch
    {
        MealSlot.Breakfast => "meal-breakfast",
        MealSlot.Lunch => "meal-lunch",
        MealSlot.Dinner => "meal-dinner",
